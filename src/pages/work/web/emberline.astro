---
/* Emberline — a third concept landing page, built to show web work.

   Emberline is fictional: energy and emissions data for industrial sites,
   from the meter to the report. No client on this site sells into that
   market. The explorer runs on a fixed synthetic dataset and every figure is
   marked illustrative.

   The design follows the Griffin-inspired "Tally" system kept in
   design-notes/griffin-tally/: near-black canvas, warm off-white type, a
   serif display over an Arial body and Courier utilities, pill controls,
   and data as the only imagery. The system specifies system font stacks on
   purpose, so no font is loaded and none needs a licence.

   Standalone, like the other concepts. Content is server-rendered: the hero
   field, the explorer's default chart, table and SQL are all in the HTML,
   and the script re-renders them only when a control changes. Motion is the
   system's own short list — the hero line draws once, controls answer in
   160ms, the FAQ icon turns — and none of it runs under reduced motion. */
const title = 'Emberline — Every tonne, accounted for';
const description =
  'A concept landing page by Yann Hamonou for Emberline, a fictional energy and emissions data product for industrial sites.';

const months = ['Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep'];
const metrics = {
  electricity: {
    label: 'Electricity used',
    unit: 'MWh',
    values: [812, 798, 771, 744, 730, 702],
    min: 600,
    max: 900,
    column: 'SUM(kwh) / 1000 AS mwh',
    source: 'meters.half_hourly',
    title: 'Less power for the same output.',
  },
  gas: {
    label: 'Gas used',
    unit: 'MWh',
    values: [1240, 1195, 1130, 1080, 1010, 968],
    min: 800,
    max: 1400,
    column: 'SUM(gas_kwh) / 1000 AS mwh',
    source: 'meters.gas_daily',
    title: 'The boilers, retuned.',
  },
  emissions: {
    label: 'Emissions, Scope 1 and 2',
    unit: 'tCO2e',
    values: [412, 398, 377, 358, 341, 322],
    min: 250,
    max: 450,
    column: 'SUM(tco2e) AS tco2e',
    source: 'ledger.emissions_monthly',
    title: 'A lower line you can defend.',
  },
} as const;

/* The default view, computed here so the page reads without JavaScript. */
const d0 = metrics.electricity;
const fmt = (v: number, unit: string) => `${v.toLocaleString('en-GB')} ${unit}`;
const coords = d0.values.map((v, i) => [45 + (i * 650) / 5, 200 - ((v - d0.min) / (d0.max - d0.min)) * 180]);
const linePath = coords.map((p, i) => `${i ? 'L' : 'M'}${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' ');
const areaPath = `M45 200 ${coords.map((p) => `L${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' ')} L695 200 Z`;
const change0 = (((d0.values[5] / d0.values[0]) - 1) * 100).toFixed(1);
const sql0 = `SELECT month, ${d0.column}\nFROM ${d0.source}\nWHERE site = 'Plant 2'\n  AND month BETWEEN '2026-04' AND '2026-09'\nGROUP BY month ORDER BY month;`;

/* The hero's character field: readings scattered before they are a line.
   Deterministic, so it renders the same every build. */
const glyphs = ['+', '·', '0', '1'];
const field = Array.from({ length: 120 }, (_, i) => ({
  x: ((i * 173) % 1080) + 10,
  y: ((i * 61) % 205) + 28,
  g: glyphs[i % 4],
  o: (0.15 + (i % 4) * 0.09).toFixed(2),
}));

const workflows = [
  {
    who: 'For energy managers',
    body: 'See consumption by site, meter and shift. Tie it to production so a busy month and a wasteful month stop looking the same.',
    code: true,
  },
  { who: 'For finance', body: 'Reconcile metered use against every utility invoice, line by line, and find the bill that charged for energy nobody used.' },
  { who: 'For operations', body: 'Spot the compressor left running over the weekend, and the boiler that drifted out of tune, before the month-end number does.' },
  { who: 'For sustainability reporting', body: 'Scope 1 and 2 totals built from the meter up, with the emission factor, its year and its source recorded against every figure.' },
];

const faq = [
  { q: 'Is Emberline a real product?', a: 'No. It is a fictional energy and emissions product, made up for this page. The explorer uses a fixed synthetic dataset; nothing connects to a real meter or site.' },
  { q: 'Are the numbers real?', a: 'No. Consumption, emissions, prices and the site itself are illustrative. They are there so the product can explain itself, not to claim a result.' },
  { q: 'Why system fonts?', a: 'The design system this page follows specifies them, so the page loads nothing extra and needs no font licence. The serif and the monospace still do the work of separating the story from the data.' },
  { q: 'Who built it?', a: 'Yann Hamonou, in Astro, with hand-written CSS and one small script for the explorer, the menu and the plan previews. No page builder, no plugins.' },
  { q: 'Can you build a page like this for my product?', a: 'Yes. Book the free 30-minute review and bring the product. We start with what the page has to prove, and to whom.' },
];
---

<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0c0c0b" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='5' fill='%230c0c0b'/%3E%3Cpath d='M5 10L27 22M5 16h22' stroke='%23f9f5ef' stroke-width='2'/%3E%3Ccircle cx='21' cy='18.7' r='2.4' fill='%23c2d9bd'/%3E%3C/svg%3E" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <div class="concept-bar mono">
    <span>Concept site by Yann Hamonou. Emberline is a fictional product.</span>
    <a href="/work/web/">← Web work</a>
  </div>

  <header class="header wrap">
    <a class="wordmark" href="#main" aria-label="Emberline, back to top"><span class="mark" aria-hidden="true">∿</span> emberline</a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="navigation">Menu <span aria-hidden="true">+</span></button>
    <nav id="navigation" aria-label="Main navigation">
      <a href="#platform">Platform</a>
      <a href="#workflows">Teams</a>
      <a href="#connect">Sources</a>
      <a href="#pricing">Pricing</a>
      <a href="#questions">Questions</a>
    </nav>
    <a class="button small header-cta" href="#explore">Explore the demo <span aria-hidden="true">↗</span></a>
  </header>

  <main id="main">
    <section class="hero wrap">
      <div class="hero-top">
        <div>
          <p class="eyebrow"><span class="status"></span> Energy and emissions, measured at the meter</p>
          <h1>Every tonne,<br />accounted <em>for.</em></h1>
        </div>
        <div class="hero-copy">
          <p>Bring meters, fuel logs and invoices together.{' '}<br />See where the energy goes.{' '}<br />Report emissions you can defend.</p>
          <div class="actions">
            <a class="button" href="#explore">Explore the demo <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#platform">Meet Emberline <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </div>
      <div class="hero-chart">
        <div class="chart-top mono"><span>From scattered readings to one baseline</span><span>Synthetic dataset / 2026</span></div>
        <svg class="signal-chart" viewBox="0 0 1100 250" preserveAspectRatio="xMidYMid slice" role="img" aria-labelledby="signal-title">
          <title id="signal-title">Illustrative meter readings resolving into a falling consumption trend</title>
          <defs><pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r=".7" fill="#514e4b" /></pattern></defs>
          <rect width="1100" height="250" fill="url(#dots)" />
          <g class="data-points" fill="#959089" aria-hidden="true">
            {field.map((p) => <text x={p.x} y={p.y} font-size="8" font-family="monospace" opacity={p.o}>{p.g}</text>)}
          </g>
          <path class="trend secondary" d="M0 40L100 52 190 36 290 78 380 70 480 110 570 98 660 142 755 130 850 170 945 160 1090 196" />
          <path class="trend primary" d="M0 22L100 34 190 50 290 46 380 82 480 74 570 124 660 112 755 158 850 146 945 202 1090 220" />
          <circle cx="945" cy="202" r="4" fill="#c2d9bd" />
          <g class="chart-note"><rect x="752" y="214" width="170" height="30" rx="15" fill="#e6e1d9" /><text x="766" y="234" fill="#0c0c0b" font-size="11" font-family="monospace">THE BASELINE BENDS ↘</text></g>
        </svg>
        <div class="chart-bottom mono"><span>Meter · Reconcile · Report</span><a href="#explore">Follow the numbers ↓</a></div>
      </div>
    </section>

    <section class="sources wrap">
      <p class="mono">Your readings already exist.{' '}<br />Start there.</p>
      <div class="source-names" aria-label="Kinds of data source">
        <span>Half-hourly meters</span><span class="serif">SCADA exports</span><span class="mono">fuel_logs.csv</span><span class="serif">Utility invoices</span><span>Spreadsheets</span>
      </div>
    </section>

    <section class="intro wrap section" id="platform">
      <p class="section-label mono">One ledger for energy</p>
      <div>
        <h2>One place to see<br />where the energy <em>goes.</em></h2>
        <p class="lede">The meter says one thing, the invoice another, and the spreadsheet a third. Emberline puts the readings in one ledger, with one definition for every number, so the site, the finance team and the auditor are looking at the same thing.</p>
      </div>
    </section>

    <section class="explorer wrap" id="explore" data-explorer data-metrics={JSON.stringify(metrics)} data-months={JSON.stringify(months)}>
      <div class="explorer-top">
        <div><span class="mono muted">EMBERLINE / PLANT 2 / SAMPLE SITE</span><h3>Where the energy went</h3></div>
        <span class="demo-label mono"><span class="status"></span> Interactive demo</span>
      </div>
      <div class="explorer-controls">
        <div class="pills" role="group" aria-label="Choose metric">
          <button type="button" data-metric="electricity" aria-pressed="true">Electricity</button>
          <button type="button" data-metric="gas" aria-pressed="false">Gas</button>
          <button type="button" data-metric="emissions" aria-pressed="false">Emissions</button>
        </div>
        <label class="mono">Period
          <select data-period>
            <option value="6">Last 6 months</option>
            <option value="3">Last 3 months</option>
          </select>
        </label>
      </div>
      <div class="explorer-body">
        <div class="plot-panel">
          <div class="plot-heading">
            <div><span class="mono muted" data-label>{d0.label}</span><p class="metric-value" data-value>{fmt(d0.values[5], d0.unit)}</p></div>
            <span class="change mono" data-change>{change0}% since Apr</span>
          </div>
          <div data-view-panel="chart">
            <svg class="main-chart" viewBox="0 0 720 245" role="img" aria-labelledby="chart-title chart-desc">
              <title id="chart-title" data-chart-title>{d0.label}</title>
              <desc id="chart-desc" data-chart-desc>{months.map((m, i) => `${m}: ${fmt(d0.values[i], d0.unit)}`).join('; ')}. Synthetic sample data.</desc>
              <g class="grid-lines"><path d="M45 20H695M45 80H695M45 140H695M45 200H695" /></g>
              <g data-axis>{[0, 1, 2, 3].map((i) => <text x="0" y={24 + i * 60}>{Math.round(d0.max - (i * (d0.max - d0.min)) / 3)}</text>)}</g>
              <path class="area" data-area d={areaPath} />
              <path class="line" data-line d={linePath} />
              <g data-markers>{coords.map((p, i) => <circle cx={p[0].toFixed(1)} cy={p[1].toFixed(1)} r="4"><title>{`${months[i]}: ${fmt(d0.values[i], d0.unit)}`}</title></circle>)}</g>
              <g data-months>{coords.map((p, i) => <text x={p[0].toFixed(1)} y="232" text-anchor="middle">{months[i]}</text>)}</g>
            </svg>
          </div>
          <div data-view-panel="table" hidden>
            <table>
              <caption class="muted" data-caption>{d0.label} · synthetic data</caption>
              <thead><tr><th scope="col">Month</th><th scope="col" data-col>{d0.label}</th></tr></thead>
              <tbody data-rows>{d0.values.map((v, i) => <tr><th scope="row">{months[i]} 2026</th><td>{fmt(v, d0.unit)}</td></tr>)}</tbody>
            </table>
          </div>
          <pre data-view-panel="sql" hidden><code data-sql>{sql0}</code></pre>
          <div class="pills view-pills" role="group" aria-label="Display format">
            <button type="button" data-view="chart" aria-pressed="true">Chart</button>
            <button type="button" data-view="table" aria-pressed="false">Table</button>
            <button type="button" data-view="sql" aria-pressed="false">SQL</button>
          </div>
        </div>
        <aside class="insight">
          <span class="mono">↘ What changed?</span>
          <h4 data-insight-title>{d0.title}</h4>
          <p data-insight-copy>{d0.label} fell from {fmt(d0.values[0], d0.unit)} to {fmt(d0.values[5], d0.unit)} between April and September, while output held steady. Switch views to see the numbers behind the line.</p>
          <div class="insight-source"><span class="status"></span><span>Source: <span data-source>{d0.source}</span><br /><small>Synthetic data · Plant 2</small></span></div>
          <button type="button" class="text-link" data-reset>Reset exploration <span aria-hidden="true">↺</span></button>
        </aside>
      </div>
      <div class="explorer-footer mono"><span>One reading. One definition. Every report.</span><span>Sample data only · No connection required</span></div>
    </section>

    <section class="workflow wrap section" id="workflows">
      <div>
        <p class="section-label mono">Built for the next question</p>
        <h2>From “what did<br />we use?” to<br /><em>“what can we cut?”</em></h2>
        <p class="lede">A shared ledger for the people who read the meters and the people who have to sign the report.</p>
      </div>
      <div class="workflow-list">
        {workflows.map((w, i) => (
          <details open={i === 0}>
            <summary>{w.who} <span aria-hidden="true">↗</span></summary>
            <p>{w.body}</p>
            {w.code && <div class="mini-code mono"><span>intensity</span> = mwh / tonnes_produced<br /><small>Definition shared across 6 reports</small></div>}
          </details>
        ))}
      </div>
    </section>

    <section class="process section">
      <div class="wrap">
        <div class="section-head">
          <h2>Less reconciling.<br />More <em>reducing.</em></h2>
          <p class="lede">Keep the path from a raw reading<br />to a reported tonne short.</p>
        </div>
        <ol class="steps">
          <li>
            <span class="mono muted">01 / CONNECT</span>
            <div class="step-visual mono">meters <span>↘</span><br />invoices <span>→</span> <b>emberline</b><br />fuel logs <span>↗</span></div>
            <h3>Start with the readings you have.</h3>
            <p>Half-hourly meters, SCADA exports, delivery notes and the spreadsheet someone still keeps by hand.</p>
          </li>
          <li>
            <span class="mono muted">02 / RECONCILE</span>
            <div class="step-visual mono">meter &nbsp;&nbsp;<span>702 MWh</span><br />invoice <span>705 MWh</span><br />gap &nbsp;&nbsp;&nbsp;&nbsp;<span>0.4% ✓</span></div>
            <h3>Make the numbers agree.</h3>
            <p>Every invoice checked against what the meters recorded, with the gap shown rather than hidden.</p>
          </li>
          <li>
            <span class="mono muted">03 / REPORT</span>
            <div class="step-visual note-visual mono"><span>↘ Q3 emissions</span><br />Scope 1 · Scope 2 · Intensity<br /><small>Factors and sources attached.</small></div>
            <h3>Report what you can defend.</h3>
            <p>Totals that trace back to the meter, with the emission factor and its year on the record.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="connect wrap section" id="connect">
      <div>
        <p class="section-label mono">Fits the site you already run</p>
        <h2>Your meters.<br />One <em>ledger.</em></h2>
        <p class="lede">Keep the systems that run the plant. Bring their readings somewhere they can be compared, reconciled and reported.</p>
        <a class="text-link" href="#questions">How sources would connect <span aria-hidden="true">↗</span></a>
      </div>
      <div class="connection-list">
        <div><span>Metering</span><p>Half-hourly electricity · Gas · Water</p><span aria-hidden="true">↗</span></div>
        <div><span>Site systems</span><p>SCADA exports · Building management · Historians</p><span aria-hidden="true">↗</span></div>
        <div><span>Paperwork</span><p>Utility invoices · Fuel delivery notes</p><span aria-hidden="true">↗</span></div>
        <div><span>Everyday files</span><p>CSV · Excel · Shared drives</p><span aria-hidden="true">↗</span></div>
        <small>Illustrative source types for a fictional product. No integrations or partnerships are implied.</small>
      </div>
    </section>

    <section class="trust wrap">
      <div class="trust-title">
        <span class="mono">A report needs a foundation.</span>
        <h2>Know what’s behind<br />every <em>tonne.</em></h2>
      </div>
      <div class="trust-features">
        <div><h3>Traceable to the meter</h3><p>Every total opens onto the readings that made it, and when each one arrived.</p></div>
        <div><h3>Factors on the record</h3><p>Emission factors are versioned with the year they apply to, so last year’s report still adds up next year.</p></div>
        <div><h3>Ready for the auditor</h3><p>Sources, assumptions and adjustments travel with the figure instead of living in someone’s inbox.</p></div>
      </div>
    </section>

    <section class="pricing wrap section" id="pricing">
      <div class="section-head">
        <h2>Room to grow.<br />Sites to <em>add.</em></h2>
        <p class="lede">Illustrative plans for a<br />fictional product.</p>
      </div>
      <div class="plans">
        <article>
          <span class="mono">EXPLORE</span>
          <h3>See the sample site.</h3>
          <p class="price">£0 <small>/ month</small></p>
          <p>For a first look at a single ledger for energy.</p>
          <ul><li>Sample site and dataset</li><li>Chart, table and SQL views</li><li>No account needed for this demo</li></ul>
          <a class="button outline" href="#explore">Explore sample data <span aria-hidden="true">↗</span></a>
        </article>
        <article>
          <span class="mono">SITE</span>
          <h3>One plant, fully metered.</h3>
          <p class="price">£249 <small>/ month</small></p>
          <p>A concept plan for a single operating site.</p>
          <ul><li>Unlimited meters and sources</li><li>Invoice reconciliation</li><li>Scope 1 and 2 reporting</li></ul>
          <button type="button" class="button" data-plan="Site">Preview Site plan <span aria-hidden="true">↗</span></button>
        </article>
        <article>
          <span class="mono">PORTFOLIO</span>
          <h3>Every site, one ledger.</h3>
          <p class="price">Let’s talk.</p>
          <p>A concept plan for operators with several sites.</p>
          <ul><li>Cross-site comparison</li><li>Group reporting and ownership</li><li>Guided onboarding</li></ul>
          <button type="button" class="button outline" data-plan="Portfolio">Preview Portfolio <span aria-hidden="true">↗</span></button>
        </article>
      </div>
    </section>

    <section class="faq wrap section" id="questions">
      <h2>A few fair<br /><em>questions.</em></h2>
      <div>
        {faq.map((f) => (
          <details>
            <summary>{f.q} <span aria-hidden="true">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="closing wrap">
      <p class="mono">A concept by Yann Hamonou.</p>
      <h2>Want a page<br />like <em>this one?</em></h2>
      <a class="button" href="/contact">Talk to Yann <span aria-hidden="true">↗</span></a>
    </section>
  </main>

  <footer class="wrap">
    <a class="wordmark" href="#main"><span class="mark" aria-hidden="true">∿</span> emberline</a>
    <p>Fictional product. Real design work.</p>
    <div class="mono"><a href="#platform">Platform</a><a href="#pricing">Pricing</a><a href="/work/web/">Web work</a></div>
    <small>Emberline is a fictional product and brand. Concept, design and build by Yann Hamonou, 2026. Design system after Griffin, adapted.</small>
  </footer>

  <dialog class="plan-dialog" aria-labelledby="dialog-title">
    <button type="button" class="close" aria-label="Close plan preview">×</button>
    <p class="mono">A PRODUCT CONCEPT</p>
    <h2 id="dialog-title">Site plan</h2>
    <p data-dialog-copy></p>
    <p>Emberline is fictional. There is no checkout or signup, and nothing is collected.</p>
    <a class="button" href="/contact">Want a page like this? Talk to Yann <span aria-hidden="true">↗</span></a>
  </dialog>

  <script>
    type Metric = { label: string; unit: string; values: number[]; min: number; max: number; column: string; source: string; title: string };

    /* Explorer: scoped to its root, re-renders only when a control changes. */
    document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
      const metrics = JSON.parse(root.dataset.metrics!) as Record<string, Metric>;
      const months = JSON.parse(root.dataset.months!) as string[];
      const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
      const NS = 'http://www.w3.org/2000/svg';
      const el = (name: string, attrs: Record<string, string | number>, text?: string) => {
        const n = document.createElementNS(NS, name);
        Object.entries(attrs).forEach(([k, v]) => n.setAttribute(k, String(v)));
        if (text !== undefined) n.textContent = text;
        return n;
      };
      let metric = 'electricity';
      let period = 6;
      let view = 'chart';
      const fmt = (v: number, u: string) => `${v.toLocaleString('en-GB')} ${u}`;

      const render = () => {
        const d = metrics[metric];
        const values = d.values.slice(-period);
        const labels = months.slice(-period);
        const coords = values.map((v, i) => [45 + (i * 650) / (values.length - 1), 200 - ((v - d.min) / (d.max - d.min)) * 180]);
        q('[data-label]').textContent = d.label;
        q('[data-value]').textContent = fmt(values.at(-1)!, d.unit);
        q('[data-change]').textContent = `${((values.at(-1)! / values[0] - 1) * 100).toFixed(1)}% since ${labels[0]}`;
        q('[data-chart-title]').textContent = d.label;
        q('[data-chart-desc]').textContent = labels.map((m, i) => `${m}: ${fmt(values[i], d.unit)}`).join('; ') + '. Synthetic sample data.';
        q('[data-line]').setAttribute('d', coords.map((p, i) => `${i ? 'L' : 'M'}${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' '));
        q('[data-area]').setAttribute('d', `M45 200 ${coords.map((p) => `L${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' ')} L695 200 Z`);
        q('[data-markers]').replaceChildren(...coords.map((p, i) => {
          const c = el('circle', { cx: p[0].toFixed(1), cy: p[1].toFixed(1), r: 4 });
          c.append(el('title', {}, `${labels[i]}: ${fmt(values[i], d.unit)}`));
          return c;
        }));
        q('[data-months]').replaceChildren(...coords.map((p, i) => el('text', { x: p[0].toFixed(1), y: 232, 'text-anchor': 'middle' }, labels[i])));
        q('[data-axis]').replaceChildren(...[0, 1, 2, 3].map((i) => el('text', { x: 0, y: 24 + i * 60 }, String(Math.round(d.max - (i * (d.max - d.min)) / 3)))));
        q('[data-insight-title]').textContent = d.title;
        q('[data-insight-copy]').textContent = `${d.label} fell from ${fmt(values[0], d.unit)} to ${fmt(values.at(-1)!, d.unit)} between ${labels[0]} and September, while output held steady. Switch views to see the numbers behind the line.`;
        q('[data-source]').textContent = d.source;
        q('[data-caption]').textContent = `${d.label} · synthetic data`;
        q('[data-col]').textContent = d.label;
        q('[data-rows]').replaceChildren(...values.map((v, i) => {
          const tr = document.createElement('tr');
          const th = document.createElement('th');
          th.scope = 'row';
          th.textContent = `${labels[i]} 2026`;
          const td = document.createElement('td');
          td.textContent = fmt(v, d.unit);
          tr.append(th, td);
          return tr;
        }));
        q('[data-sql]').textContent = `SELECT month, ${d.column}\nFROM ${d.source}\nWHERE site = 'Plant 2'\n  AND month BETWEEN '2026-0${10 - period}' AND '2026-09'\nGROUP BY month ORDER BY month;`;
        root.querySelectorAll<HTMLElement>('[data-view-panel]').forEach((p) => { p.hidden = p.dataset.viewPanel !== view; });
        root.querySelectorAll<HTMLButtonElement>('[data-metric]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.metric === metric)));
        root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
      };

      root.querySelectorAll<HTMLButtonElement>('[data-metric]').forEach((b) => b.addEventListener('click', () => { metric = b.dataset.metric!; render(); }));
      root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => { view = b.dataset.view!; render(); }));
      const sel = q<HTMLSelectElement>('[data-period]');
      sel.addEventListener('change', () => { period = Number(sel.value); render(); });
      q('[data-reset]').addEventListener('click', () => { metric = 'electricity'; period = 6; view = 'chart'; sel.value = '6'; render(); });
    });

    /* Mobile menu */
    const menu = document.querySelector<HTMLButtonElement>('.menu');
    const nav = document.getElementById('navigation');
    if (menu && nav) {
      const close = () => { nav.classList.remove('open'); menu.setAttribute('aria-expanded', 'false'); };
      menu.addEventListener('click', () => { const open = nav.classList.toggle('open'); menu.setAttribute('aria-expanded', String(open)); });
      nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('open')) { close(); menu.focus(); } });
    }

    /* Plan previews: native dialog, honest about what it is. */
    const dialog = document.querySelector<HTMLDialogElement>('.plan-dialog');
    if (dialog) {
      const copy: Record<string, string> = {
        Site: 'The Site concept covers one operating plant: unlimited meters and sources, invoice reconciliation and Scope 1 and 2 reporting, for £249 a month.',
        Portfolio: 'The Portfolio concept adds cross-site comparison, group reporting and guided onboarding, priced to the number of sites.',
      };
      document.querySelectorAll<HTMLButtonElement>('[data-plan]').forEach((b) => b.addEventListener('click', () => {
        const plan = b.dataset.plan!;
        dialog.querySelector('#dialog-title')!.textContent = `${plan} plan`;
        dialog.querySelector('[data-dialog-copy]')!.textContent = copy[plan];
        dialog.showModal();
      }));
      dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
    }
  </script>

  <style is:global>
    :root {
