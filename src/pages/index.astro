---
import Layout from '../layouts/Layout.astro';
import { reader } from '../lib/keystatic';
import { services, cases, clients, numbers, testimonials, faq } from '../data/index';
import ClientLogo from '../components/ClientLogo.astro';

const allPosts = await reader.collections.posts.all();
const recentPosts = allPosts
  .sort((a, b) => {
    const da = a.entry.publishedDate ?? '';
    const db = b.entry.publishedDate ?? '';
    return db > da ? 1 : -1;
  })
  .slice(0, 3);
---

<Layout
  title="Marketing Consultant Aberdeen — Yann Hamonou"
  description="B2B marketing consultant and digital marketing specialist based in Aberdeen, Scotland. Strategy, SEO, paid media, and websites that generate qualified leads for Scottish SMEs. Free 30-min review."
  field
>
  <!-- ═══ HERO — one line, and as little else as the page can bear ═══ -->
  <section class="edge-hero">
    <div class="edge-wrap">
      <p class="edge-kicker">Yann Hamonou — B2B Marketing</p>

      <h1 class="edge-h1">
        Marketing from<br />the edge.
        <span class="edge-h1__sub">Marketing Consultant · Aberdeen &amp; Aberdeenshire</span>
      </h1>

      <div class="edge-hero__foot">
        <a href="/contact" class="edge-btn">Book a free 30-min review</a>
        <p class="edge-hero__where">Stonehaven · Aberdeenshire · Scotland</p>
      </div>
    </div>
  </section>

  <!-- The sheet: rises over the sticky hero and takes the page to white -->
  <div class="edge-sheet">
  <!-- ═══ PROPOSITION ═══ -->
  <section class="edge-block">
    <div class="edge-wrap edge-lede">
      <p class="edge-label">01 — The proposition</p>
      <p class="edge-lede__text">
        Strategy, SEO, and paid media for B2B businesses across Aberdeen,
        Aberdeenshire, and Scotland. Twenty years of it. Pointed at qualified
        leads, not vanity metrics.
      </p>
      <div class="edge-figures">
        {numbers.map(n => (
          <div class="edge-figure">
            <span class="edge-figure__num">{n.num}</span>
            <span class="edge-figure__label">{n.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CLIENTS ═══ -->
  <section class="edge-block edge-block--paper">
    <div class="edge-wrap">
      <p class="edge-label">Current projects</p>
      <ul class="edge-clients" role="list">
        {clients.map(c => (
          <li>
            <ClientLogo logo={c} name={c.name} class="edge-client-logo" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ WORK ═══ -->
  <section class="edge-block edge-block--dark edge-block--ink" id="work">
    <div class="edge-wrap">
      <div class="edge-head">
        <p class="edge-label">02 — Selected work</p>
        <h2 class="edge-h2">Results</h2>
      </div>
      <ul class="edge-rows" role="list">
        {cases.map(c => (
          <li>
            <a href={`/work/${c.slug}`} class="edge-row">
              {c.logo
                ? (
                  <img
                    src={c.logo.src}
                    alt={c.client}
                    width={c.logo.w}
                    height={c.logo.h}
                    class={`edge-row__logo${c.logo.darkInvert ? ' logo-dark-invert' : ''}`}
                    loading="lazy"
                  />
                )
                : <span class="edge-row__client edge-row__client--fallback">{c.client}</span>
              }
              <span class="edge-row__desc">{c.descriptor}</span>
              <span class="edge-row__stat">{c.stat}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/work" class="edge-more">All work →</a>
    </div>
  </section>

  <!-- ═══ SERVICES ═══ -->
  <section class="edge-block edge-block--mist" id="services">
    <div class="edge-wrap">
      <div class="edge-head">
        <p class="edge-label">03 — What I do</p>
        <h2 class="edge-h2">Services</h2>
      </div>
      <ul class="edge-rows" role="list">
        {services.map(s => (
          <li>
            <a href={`/services/${s.slug}`} class="edge-row edge-row--service">
              <span class="edge-row__num">{s.num}</span>
              <span class="edge-row__client">{s.title}</span>
              <span class="edge-row__desc">{s.desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ PROOF ═══ -->
  <section class="edge-block edge-block--dark edge-block--slate" id="proof">
    <div class="edge-wrap">
      <div class="edge-head">
        <p class="edge-label">04 — What clients say</p>
        <h2 class="edge-h2">Proof</h2>
      </div>
      <div class="edge-quotes">
        {testimonials.map(t => (
          <figure class="edge-quote">
            {t.logo && (
              <ClientLogo logo={t.logo} name={t.company} class="edge-quote__logo" decorative />
            )}
            <blockquote>{t.quote}</blockquote>
            <figcaption>
              {t.name} — {t.role}, {t.company}{t.location ? ` · ${t.location}` : ''}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ — kept in full: this is the FAQ-schema and AI-answer surface ═══ -->
  <section class="edge-block edge-block--sand" id="faq">
    <div class="edge-wrap edge-wrap--narrow">
      <div class="edge-head">
        <p class="edge-label">05 — Common questions</p>
        <h2 class="edge-h2">FAQ</h2>
      </div>
      <div class="edge-faq">
        {faq.map(item => (
          <details class="edge-faq__item">
            <summary>
              {item.q}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ JOURNAL ═══ -->
  {recentPosts.length > 0 && (
    <section class="edge-block edge-block--bone" id="journal">
      <div class="edge-wrap">
        <div class="edge-head">
          <p class="edge-label">06 — From the journal</p>
          <h2 class="edge-h2">Insights</h2>
        </div>
        <ul class="edge-rows" role="list">
          {recentPosts.map(p => (
            <li>
              <a href={`/journal/${p.slug}`} class="edge-row edge-row--post">
                <span class="edge-row__client">{p.entry.title}</span>
                <span class="edge-row__desc">{p.entry.description}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/journal" class="edge-more">All writing →</a>
      </div>
    </section>
  )}

  <!-- ═══ CTA ═══ -->
  <section class="edge-block edge-block--dark edge-block--pitch edge-cta">
    <div class="edge-wrap edge-wrap--narrow">
      <h2 class="edge-h2 edge-cta__h">Let's make your<br />marketing work.</h2>
      <p class="edge-cta__p">
        A free 30-minute review. No pitch — an honest look at where your
        biggest marketing opportunity is.
      </p>
      <a href="/contact" class="edge-btn">Book the free review →</a>
    </div>
  </section>
  </div>
</Layout>

<style>
  /* ─────────────────────────────────────────────────────────────
     THE EDGE — a near-black ground, one enormous light line, and
     mono micro-labels as the only second voice. The restraint is
     the design; the field behind it is ambience, not the subject.
  ───────────────────────────────────────────────────────────── */

  .edge-wrap {
    width: min(100% - clamp(24px, 6vw, 96px), 1440px);
    margin-inline: auto;
  }
  .edge-wrap--narrow { max-width: 780px; }

  /* Every block owns a screen. min-height, not height: a phone, a short
     laptop or a long FAQ grows past it rather than clipping, which is the
     honest limit of this idea on small viewports. svh, so mobile browser
     chrome cannot push the last line under the fold. */
  .edge-block {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    align-content: center;
    padding-block: clamp(72px, 12vh, 160px);
  }

  /* ── Micro-labels: the Space Mono voice ── */
  .edge-label,
  .edge-kicker {
    font-family: var(--v4-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--v4-ink-dim);
  }

  /* ── Hero ── */
  .edge-hero {
    /* Sticky, not fixed: it holds while .edge-sheet scrolls up over it, then
       releases with the document. z-index 0 keeps it under the sheet. */
    position: sticky;
    top: 0;
    z-index: 0;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(120px, 18vh, 200px) clamp(60px, 10vh, 100px);
  }
  .edge-kicker { margin-bottom: clamp(32px, 6vh, 64px); }

  .edge-h1 {
    font-family: var(--v4-display);
    /* Light weight at enormous size is the whole trick — at 600 this reads as
       a poster, at 300 it reads as air. */
    font-weight: 300;
    font-size: clamp(52px, 11.5vw, 220px);
    line-height: 0.88;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--v4-ink);
    margin: 0;
  }
  .edge-h1__sub {
    display: block;
    font-family: var(--v4-mono);
    font-size: clamp(11px, 1.1vw, 13px);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--v4-ink-dim);
    line-height: 1.5;
    margin-top: clamp(28px, 4vh, 48px);
  }

  .edge-hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(48px, 8vh, 88px);
  }
  .edge-hero__where {
    font-family: var(--v4-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--v4-ink-dim);
  }

  .edge-btn {
    display: inline-flex;
    align-items: center;
    height: 46px;
    padding-inline: 26px;
    border: 1px solid var(--v4-line);
    border-radius: 999px;
    font-family: var(--v4-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--v4-ink);
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  .edge-btn:hover {
    background: var(--v4-ink);
    border-color: var(--v4-ink);
    color: #151515;
  }

  /* ── The sheet ──
     Carries the light token set; the background belongs to each block so
     sections can differ. The sheet itself is transparent, which is what lets
     an --clear block show the field through. Every direct child must therefore
     declare a ground, or the hero shows through it. */
  .edge-sheet {
    position: relative;
    z-index: 1;
    background: transparent;
    --v4-ink: #151515;
    /* Both carry 11-12px text — section labels, row descriptors, captions —
       so both need 4.5:1 against the palest and the deepest light ground.
       Measured on sand (#e8e4dc), the worst case: mute 7.27, dim 4.70. The
       old pair read 5.65 and 2.78, so every label on the page failed AA. */
    --v4-ink-mute: #45484a;
    --v4-ink-dim: #616467;
    --v4-line: rgba(0, 0, 0, 0.14);
    --v4-line-soft: rgba(0, 0, 0, 0.08);
    color: var(--v4-ink);
  }

  /* ── Per-section grounds ──
     One ladder, no hues: warm off-whites, cool off-whites, and three depths of
     near-black. A monochrome page can give every section its own ground and
     still read as one material — colour would not. Swap the modifier on any
     section; --clear lets the hero field show through instead. */
  .edge-sheet > .edge-block { background: var(--edge-white); }        /* 01 proposition */
  .edge-sheet > .edge-block--paper { background: var(--edge-paper); } /* current projects */
  .edge-sheet > .edge-block--ink   { background: var(--edge-ink); }   /* 02 work */
  .edge-sheet > .edge-block--mist  { background: var(--edge-mist); }  /* 03 services */
  .edge-sheet > .edge-block--slate { background: var(--edge-slate); } /* 04 proof */
  .edge-sheet > .edge-block--sand  { background: var(--edge-sand); }  /* 05 faq */
  .edge-sheet > .edge-block--bone  { background: var(--edge-bone); }  /* 06 journal */
  .edge-sheet > .edge-block--pitch { background: var(--edge-pitch); } /* the close */
  .edge-sheet > .edge-block--clear { background: transparent; }

  /* Any dark ground rebinds the ink tokens, so every rule written for the
     light sheet works on it unchanged — no duplicate styles per section. */
  .edge-sheet > .edge-block--dark {
    --v4-ink: #f2f1ec;
    /* Slate is the palest of the three dark grounds and so the hard case:
       mute 6.13, dim 4.91. Dim was 3.76 there. */
    --v4-ink-mute: #a2a5a3;
    --v4-ink-dim: #909391;
    --v4-line: rgba(255, 255, 255, 0.16);
    --v4-line-soft: rgba(255, 255, 255, 0.09);
    color: var(--v4-ink);
  }

  .edge-sheet .edge-btn:hover {
    background: #151515;
    border-color: #151515;
    color: #fff;
  }
  /* Ink on ink is invisible: on a dark ground the fill inverts. */
  .edge-block--dark .edge-btn:hover {
    background: #f2f1ec;
    border-color: #f2f1ec;
    color: #151515;
  }

  /* ── Section heads ── */
  .edge-head { margin-bottom: clamp(40px, 6vh, 72px); }
  .edge-h2 {
    font-family: var(--v4-display);
    font-weight: 300;
    font-size: clamp(38px, 6vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin-top: 14px;
  }

  /* ── Lede ── */
  .edge-lede__text {
    font-family: var(--v4-display);
    font-weight: 300;
    font-size: clamp(22px, 3.2vw, 46px);
    line-height: 1.25;
    letter-spacing: -0.015em;
    max-width: 20ch;
    margin-top: 20px;
  }
  .edge-figures {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 80px);
    margin-top: clamp(48px, 8vh, 88px);
    padding-top: 32px;
    border-top: 1px solid var(--v4-line-soft);
  }
  .edge-figure { display: flex; flex-direction: column; gap: 6px; }
  .edge-figure__num {
    font-family: var(--v4-display);
    font-weight: 300;
    font-size: clamp(30px, 4vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .edge-figure__label {
    font-family: var(--v4-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--v4-ink-dim);
    max-width: 15ch;
  }

  /* ── Clients ── */
  /* Auto-fit rather than flex-wrap: at full height the four marks should sit
     on one even row and break to a tidy grid, not trail a widow. */
  .edge-clients {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    align-items: center;
    justify-items: center;
    gap: clamp(48px, 7vw, 96px);
    margin-top: clamp(48px, 8vh, 96px);
    list-style: none;
  }
  /* ── Rows: work, services, journal all share one rhythm ── */
  .edge-rows { list-style: none; border-top: 1px solid var(--v4-line-soft); }
  .edge-rows li { border-bottom: 1px solid var(--v4-line-soft); }

  /* Work rows: mark, descriptor, number. The client name is gone — the logo
     says it, and printing both made the row say everything twice. That puts
     the alt text to work: it is the only place the name is now written. */
  .edge-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 4vw, 60px);
    padding-block: clamp(28px, 4.5vh, 56px);
    transition: opacity 0.25s ease;
  }
  .edge-row--service { grid-template-columns: 60px minmax(0, 1fr) minmax(0, 1.4fr); }
  .edge-row--post { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); }

  /* A case with no logo on file still needs a name. */
  .edge-row__client--fallback { align-self: center; }
  .edge-rows li:hover .edge-row { opacity: 0.62; }

  .edge-row__num,
  .edge-row__desc {
    font-family: var(--v4-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--v4-ink-dim);
    text-transform: uppercase;
  }
  /* Overrides the label treatment above: the descriptor is prose, and it is the
     middle column of the work row, so it reads from the left edge of its own
     track rather than floating in the middle of the row. */
  .edge-row__desc {
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 12px;
    line-height: 1.6;
    text-align: left;
    justify-self: start;
  }
  .edge-row__client {
    font-family: var(--v4-display);
    font-weight: 300;
    font-size: clamp(20px, 2.4vw, 34px);
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .edge-row__stat {
    font-family: var(--v4-display);
    font-weight: 300;
    font-size: clamp(24px, 3vw, 46px);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* Insights: the description sits alongside a much larger title, so the two
     are aligned on their first baseline rather than centred against each
     other. Below 860px the row is a single column and there is nothing to
     align to. */
  @media (min-width: 861px) {
    .edge-row--post { align-items: baseline; }
  }

  .edge-more {
    display: inline-block;
    margin-top: 32px;
    font-family: var(--v4-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--v4-ink-dim);
    transition: color 0.2s ease;
  }
  .edge-more:hover { color: var(--v4-ink); }

  /* ── Quotes ── */
  .edge-quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(32px, 5vw, 72px);
  }
  .edge-quote { display: flex; flex-direction: column; }
  .edge-quote blockquote {
    font-family: var(--v4-display);
    font-weight: 300;
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--v4-ink);
  }
  .edge-quote figcaption {
    font-family: var(--v4-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--v4-ink-dim);
    margin-top: 20px;
  }

  /* ── FAQ ── */
  .edge-faq { border-top: 1px solid var(--v4-line-soft); }
  .edge-faq__item { border-bottom: 1px solid var(--v4-line-soft); }
  .edge-faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 24px;
    cursor: pointer;
    list-style: none;
    font-family: var(--v4-display);
    font-weight: 300;
    font-size: clamp(16px, 1.7vw, 22px);
    letter-spacing: -0.01em;
  }
  .edge-faq__item summary::-webkit-details-marker { display: none; }
  .edge-faq__item summary span { color: var(--v4-ink-dim); flex-shrink: 0; }
  .edge-faq__item[open] summary span { transform: rotate(45deg); }
  .edge-faq__item p {
    padding-bottom: 26px;
    max-width: 62ch;
    color: var(--v4-ink-mute);
    font-size: 14px;
    line-height: 1.7;
  }

  /* ── CTA ── */
  .edge-cta { text-align: center; }
  .edge-cta__h { margin-top: 0; }
  .edge-cta__p {
    color: var(--v4-ink-mute);
    font-size: 15px;
    line-height: 1.7;
    max-width: 42ch;
    margin: 24px auto 40px;
  }

  /* ── Narrow ── */
  @media (max-width: 860px) {
    .edge-row,
    .edge-row--service,
    .edge-row--post {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .edge-row__stat { margin-top: 4px; }
    .edge-hero__foot { flex-direction: column; align-items: flex-start; }
  }
</style>
