---
import Layout from '../../layouts/Layout.astro';
import { services, logos } from '../../data/index';

const service = services.find(s => s.slug === 'seo-aberdeen')!;
const otherServices = services.filter(s => s.slug !== 'seo-aberdeen');

const faq = [
  {
    q: 'How long does SEO take to show results in Aberdeen?',
    a: 'For most Aberdeen SMEs, you can expect meaningful movement in local rankings within 6–12 weeks of fixing technical issues and building on-page signals. Competitive commercial terms typically take 3–6 months to hold. The Arnlea engagement reached top-3 rankings within 4 weeks for primary terms — unusually fast, driven by fixing a technically broken site that already had domain authority.',
  },
  {
    q: 'What is different about SEO for Aberdeen businesses?',
    a: 'Aberdeen has a distinct search landscape shaped by the energy sector, professional services, and a tight geographic market. Competitors are often national firms with larger budgets, so local authority signals — Google Business Profile, Aberdeen-specific content, local backlinks from trade bodies and business groups — carry more weight here than in a generic national campaign.',
  },
  {
    q: 'Do you cover GEO — AI-powered search visibility?',
    a: 'Yes. GEO (Generative Engine Optimisation) is built into every engagement. As Google AI Overviews, Bing Copilot, and ChatGPT increasingly answer queries before a click, the businesses being cited are those with structured, authoritative, local content. The technical foundations of good SEO and GEO overlap significantly — strong SEO is the floor; chunk-level content quality is what gets you cited.',
  },
  {
    q: 'Can you help with Google Business Profile for Aberdeen?',
    a: 'Absolutely. GBP optimisation is a core part of any Aberdeen SEO engagement. That means completing every field, selecting the right categories, adding products and services, publishing regular posts, and building a review acquisition strategy — all of which affect prominence in the Aberdeen Maps pack.',
  },
  {
    q: 'What does an SEO engagement with you cost?',
    a: 'Engagements are scoped to your situation — there is no off-the-shelf package. A standalone SEO audit starts from £750. Monthly retainers covering ongoing technical SEO, content, and local signals typically run £900–£2,000/month depending on scope and reporting. The free 30-minute review is the right starting point: I will tell you where the biggest opportunity is before you commit to anything.',
  },
  {
    q: 'What is GEO and why does it matter for Aberdeen businesses?',
    a: 'Generative Engine Optimisation (GEO) is the practice of structuring your content so that AI-powered search tools — ChatGPT, Perplexity, Google AI Overviews, Bing Copilot — cite your business in their generated answers. As more B2B buyers use these tools to research suppliers, businesses that are not optimised for AI search will lose visibility to competitors who are. This is particularly relevant in Aberdeen\'s professional services and energy sectors, where buyers increasingly ask AI tools for recommendations before contacting providers.',
  },
];
---

<Layout
  title="SEO Aberdeen — Search & AI Visibility for Scottish Businesses · Yann Hamonou"
  description="SEO consultant based in Aberdeen and Stonehaven. Technical SEO, local SEO, content strategy, and GEO for Aberdeen and Scottish B2B businesses. Free 30-min review."
  breadcrumbs={[
    { name: 'Home', item: `${Astro.site}` },
    { name: 'Services', item: `${Astro.site}services` },
    { name: 'SEO Aberdeen', item: `${Astro.site}services/seo-aberdeen` },
  ]}
>
  <!-- WebPage schema -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${Astro.site}services/seo-aberdeen#webpage`,
    "url": `${Astro.site}services/seo-aberdeen`,
    "name": "SEO Aberdeen — Search & AI Visibility for Scottish Businesses",
    "isPartOf": { "@id": `${Astro.site}#website` },
    "about": { "@id": `${Astro.site}#business` },
    "description": "SEO consultant based in Aberdeen and Stonehaven. Technical SEO, local SEO, content strategy, and GEO for Aberdeen and Scottish B2B businesses.",
    "inLanguage": "en-GB",
  })} />

  <!-- FAQPage schema (mirrors the on-page FAQ below) -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a },
    })),
  })} />

  <!-- Service schema -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "SEO Aberdeen — Search & AI Visibility",
    "description": "Technical SEO, local SEO, content strategy, and Generative Engine Optimisation (GEO) for Aberdeen and Scottish B2B businesses.",
    "provider": {
      "@type": ["ProfessionalService", "LocalBusiness"],
      "@id": "https://yannhamonou.pages.dev/#business",
      "name": "Yann Hamonou — B2B Marketing Consultant Aberdeen"
    },
    "areaServed": [
      { "@type": "City", "name": "Aberdeen" },
      { "@type": "AdministrativeArea", "name": "Aberdeenshire" },
      { "@type": "AdministrativeArea", "name": "Scotland" }
    ],
    "serviceType": "SEO Consultancy",
    "offers": {
      "@type": "Offer",
      "priceSpecification": [
        {
          "@type": "PriceSpecification",
          "name": "SEO & GEO Audit",
          "price": "750",
          "priceCurrency": "GBP",
          "description": "One-off assessment covering technical SEO, content gaps, schema improvements, and GEO readiness scoring"
        },
        {
          "@type": "PriceSpecification",
          "name": "Ongoing SEO & GEO Retainer",
          "minPrice": "900",
          "maxPrice": "2000",
          "priceCurrency": "GBP",
          "unitText": "MONTH"
        }
      ]
    }
  })} />

  <!-- Hero -->
  <section class="v4-block tight" style="border-bottom:1px solid var(--v4-line-soft)">
    <div class="v4-wrap">
      <a href="/services" class="v4-eyebrow" style="margin-bottom:20px;display:inline-flex;align-items:center;gap:6px;color:var(--v4-ink-dim);transition:color 0.15s ease">
        ← All services
      </a>
      <div class="v4-eyebrow" style="margin-top:24px;margin-bottom:20px">03 · Service</div>
      <h1
        style="font-family:var(--v4-display);font-weight:800;font-stretch:75%;font-size:clamp(48px,8vw,120px);line-height:0.9;letter-spacing:-0.025em;text-transform:uppercase;color:var(--v4-accent-warm);margin-bottom:24px"
      >
        SEO Aberdeen
      </h1>
      <p style="font-size:clamp(17px,2vw,22px);color:var(--v4-ink-mute);max-width:680px;line-height:1.6;font-weight:300">
        Search engine optimisation and AI visibility for Aberdeen and Scottish B2B businesses. Get found by buyers who are already looking for what you sell.
      </p>
    </div>
  </section>

  <!-- What SEO in Aberdeen actually requires -->
  <section class="v4-block tight">
    <div class="v4-wrap">
      <div style="display:grid;grid-template-columns:2fr 1fr;gap:clamp(32px,5vw,80px);align-items:start">
        <div>
          <div class="v4-eyebrow" style="margin-bottom:20px">The Aberdeen context</div>
          <div style="display:flex;flex-direction:column;gap:20px;color:var(--v4-ink-mute);font-size:16px;line-height:1.7">
            <p>
              Aberdeen search results are competitive in a specific way. National firms with large domain authority dominate generic terms. Local businesses win by being clearly the most relevant, most trusted, most geographically specific result for Aberdeen and Aberdeenshire buyers.
            </p>
            <p>
              That means Aberdeen SEO is not the same as generic SEO. It requires a precise combination: technical foundations that Googlebot can actually crawl, local authority signals that the Maps algorithm weights heavily, content built around how Aberdeen buyers actually search, and increasingly, structured data that feeds the AI summaries taking over the top of the page.
            </p>
            <p>
              I have delivered this specifically for Aberdeen and Scottish B2B companies — from industrial equipment suppliers serving the North Sea to professional services firms in the city centre. The work is practical, not theoretical.
            </p>
          </div>
          <a href="/contact" class="v4-btn v4-btn--primary" style="margin-top:32px;display:inline-flex">
            Discuss your SEO situation →
          </a>
        </div>

        <div style="background:var(--v4-panel);border-radius:16px;padding:32px;border:1px solid var(--v4-line-soft)">
          <div class="v4-eyebrow" style="margin-bottom:16px">What's included</div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:12px">
            {[
              'Technical SEO audit & fixes',
              'Keyword & intent mapping',
              'Local SEO & GBP optimisation',
              'Content strategy & planning',
              'On-page optimisation',
              'GEO / AI visibility setup',
              'Monthly reporting & recommendations',
            ].map(item => (
              <li style="font-size:14px;color:var(--v4-ink-mute);padding-left:16px;position:relative">
                <span style="position:absolute;left:0;color:var(--v4-ink-dim)">→</span>{item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Aberdeen industries -->
  <section class="v4-block tight" style="background:var(--v4-bg-2)">
    <div class="v4-wrap">
      <div class="v4-eyebrow" style="margin-bottom:20px">Who I work with in Aberdeen</div>
      <h2 class="v4-section-h" style="margin-bottom:16px;max-width:680px">Aberdeen's Economy Has<br/>Specific Search Behaviour</h2>
      <p style="font-size:17px;color:var(--v4-ink-mute);max-width:680px;line-height:1.6;margin-bottom:40px">
        Generic SEO strategies built for retail or national brands rarely work here. Aberdeen's B2B buyers search differently — longer queries, industry-specific terminology, and a strong preference for local providers with demonstrable sector experience.
      </p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px">
        {[
          {
            sector: 'Energy & Oil and Gas',
            body: 'Supply chain suppliers, decommissioning services, and energy transition companies serving operators and Tier 1 contractors. Buyers search by accreditation, certification, and specific service category — generic terms rarely convert.',
          },
          {
            sector: 'Engineering & Industrial',
            body: 'North Sea equipment suppliers, inspection services, and industrial contractors. Long buying cycles with multiple stakeholders. Content that answers technical questions and demonstrates sector credibility drives the leads that convert.',
          },
          {
            sector: 'Professional Services',
            body: 'Aberdeen law firms, accountancies, financial advisers, and management consultancies. Local trust signals — reviews, GBP prominence, named Aberdeen landing pages — are the primary differentiator against national firms.',
          },
          {
            sector: 'Technology & SaaS',
            body: 'Aberdeen\'s growing technology cluster includes software companies, digital agencies, and SaaS businesses targeting national and global markets. SEO and GEO give them visibility beyond word-of-mouth in a tight local network.',
          },
        ].map(item => (
          <div style="padding:28px;background:var(--v4-panel);border-radius:12px;border:1px solid var(--v4-line-soft)">
            <h3 style="font-family:var(--v4-display);font-weight:700;font-stretch:75%;font-size:clamp(16px,1.8vw,20px);text-transform:uppercase;letter-spacing:-0.01em;color:var(--v4-accent-warm);margin-bottom:12px">
              {item.sector}
            </h3>
            <p style="font-size:14px;color:var(--v4-ink-mute);line-height:1.6">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Three pillars of Aberdeen SEO -->
  <section class="v4-block tight">
    <div class="v4-wrap">
      <div class="v4-eyebrow" style="margin-bottom:20px">How it works</div>
      <h2 class="v4-section-h" style="margin-bottom:48px">The Three Pillars</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px">
        {[
          {
            num: '01',
            title: 'Technical foundation',
            body: 'A site Googlebot cannot crawl cannot rank. I start with a full technical audit: Core Web Vitals, crawl errors, redirect chains, duplicate content, mobile rendering, and site architecture. Most Aberdeen SME sites have 4–8 fixable technical issues holding back their rankings.',
          },
          {
            num: '02',
            title: 'Local authority',
            body: 'Google Business Profile, Bing Places, NAP consistency across citations, Aberdeen-specific landing pages, and a review acquisition strategy. These are the signals that determine whether you appear in the Aberdeen Maps pack — the most valuable real estate for local service businesses.',
          },
          {
            num: '03',
            title: 'Content & AI visibility',
            body: 'Content built around how Aberdeen buyers actually search — not generic keyword lists. Structured so that both Googlebot and AI systems (Google AI Overviews, Bing Copilot, ChatGPT) can extract, attribute, and cite your answers. GEO is not a separate discipline; it is built into every content decision.',
          },
        ].map(step => (
          <div style="border-top:2px solid var(--v4-line);padding-top:24px">
            <div class="v4-eyebrow" style="margin-bottom:16px">{step.num}</div>
            <h3 style="font-family:var(--v4-display);font-weight:700;font-stretch:75%;font-size:clamp(20px,2vw,26px);text-transform:uppercase;letter-spacing:-0.01em;color:var(--v4-accent-warm);margin-bottom:12px">
              {step.title}
            </h3>
            <p style="font-size:15px;color:var(--v4-ink-mute);line-height:1.6">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Aberdeen SEO results (case study) -->
  <section class="v4-block tight" style="background:var(--v4-bg-2)">
    <div class="v4-wrap">
      <div class="v4-eyebrow" style="margin-bottom:20px">Aberdeen SEO results</div>
      <h2 class="v4-section-h" style="margin-bottom:40px">What This Looks Like<br/>In Practice</h2>
      <div style="background:var(--v4-panel);border-radius:16px;padding:clamp(28px,4vw,56px);border:1px solid var(--v4-line-soft)">
        <div style="display:grid;grid-template-columns:1fr auto;gap:32px;align-items:start">
          <div>
            <img
              src={logos.arnlea.src}
              alt=""
              width={logos.arnlea.w}
              height={logos.arnlea.h}
              class="v4-client-logo logo-dark-invert"
              style="margin-bottom:18px"
              loading="lazy"
            />
            <div class="v4-eyebrow" style="margin-bottom:16px">Arnlea Systems — Aberdeen · Industrial Equipment</div>
            <h3 style="font-family:var(--v4-display);font-weight:800;font-stretch:75%;font-size:clamp(28px,4vw,52px);text-transform:uppercase;letter-spacing:-0.02em;color:var(--v4-accent-warm);margin-bottom:20px">
              #3 Rank in 4 Weeks
            </h3>
            <p style="font-size:16px;color:var(--v4-ink-mute);line-height:1.7;max-width:560px">
              Arnlea Systems is a specialist supplier of safety-critical industrial equipment based in Aberdeen, serving the North Sea energy sector. They had almost no organic search presence despite 30+ years of trading. A focused technical SEO programme — fixing crawl errors, building local authority, and mapping content to buyer intent — took them from invisible to top-3 rankings within 4 weeks, with 500% organic traffic growth over 6 months.
            </p>
            <a href="/work/arnlea" class="v4-btn v4-btn--outline" style="margin-top:24px;display:inline-flex;height:36px;font-size:13px">
              Read the full case study →
            </a>
          </div>
          <div style="display:flex;flex-direction:column;gap:24px;text-align:right">
            <div>
              <div style="font-family:var(--v4-display);font-weight:800;font-stretch:75%;font-size:clamp(40px,6vw,80px);line-height:1;letter-spacing:-0.02em;color:var(--v4-accent-warm)">#3</div>
              <div style="font-family:var(--v4-mono);font-size:11px;color:var(--v4-ink-dim);letter-spacing:0.06em;text-transform:uppercase;margin-top:4px">Google rank</div>
            </div>
            <div>
              <div style="font-family:var(--v4-display);font-weight:800;font-stretch:75%;font-size:clamp(40px,6vw,80px);line-height:1;letter-spacing:-0.02em;color:var(--v4-accent-warm)">500%</div>
              <div style="font-family:var(--v4-mono);font-size:11px;color:var(--v4-ink-dim);letter-spacing:0.06em;text-transform:uppercase;margin-top:4px">Organic traffic growth</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="v4-block tight">
    <div class="v4-wrap" style="max-width:800px">
      <div class="v4-eyebrow" style="margin-bottom:20px">Common questions</div>
      <h2 class="v4-section-h" style="margin-bottom:40px">SEO Aberdeen — FAQ</h2>
      <div style="display:flex;flex-direction:column;gap:1px;border:1px solid var(--v4-line-soft);border-radius:16px;overflow:hidden">
        {faq.map(item => (
          <details class="v4-faq-item" style="background:var(--v4-panel)">
            <summary style="padding:24px 28px;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;font-weight:500;color:var(--v4-ink)">
              {item.q}
              <span aria-hidden="true" style="flex-shrink:0;color:var(--v4-ink-dim)">+</span>
            </summary>
            <p style="padding:0 28px 24px;color:var(--v4-ink-mute);font-size:15px;line-height:1.6">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related reading -->
  <section class="v4-block tight" style="background:var(--v4-bg-2)">
    <div class="v4-wrap">
      <div class="v4-eyebrow" style="margin-bottom:16px">From the journal</div>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a href="/journal/seo-aberdeen-the-basics-that-still-win-in-2025" class="v4-btn v4-btn--outline" style="height:36px;font-size:13px">
          SEO Aberdeen: The Basics That Still Win in 2025 →
        </a>
        <a href="/journal/seo-in-2025-what-works-whats-hype-what-fails" class="v4-btn v4-btn--outline" style="height:36px;font-size:13px">
          SEO in 2025: What Works, What's Hype, What Fails →
        </a>
        <a href="/journal/is-your-content-ready-for-the-ai-search-revolution" class="v4-btn v4-btn--outline" style="height:36px;font-size:13px">
          Is Your Content Ready for AI Search? →
        </a>
      </div>
    </div>
  </section>

  <!-- Other services -->
  <section class="v4-block tight">
    <div class="v4-wrap">
      <div class="v4-eyebrow" style="margin-bottom:16px">Also available</div>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        {otherServices.map(s => (
          <a href={`/services/${s.slug}`} class="v4-btn v4-btn--outline" style="height:36px;font-size:13px">
            {s.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="v4-block tight" style="background:var(--v4-bg-2)">
    <div class="v4-wrap" style="max-width:640px;text-align:center">
      <h2 class="v4-section-h" style="margin-bottom:16px">Ready to Rank<br/>in Aberdeen?</h2>
      <p style="color:var(--v4-ink-mute);font-size:17px;line-height:1.6;margin-bottom:32px">
        Book the free 30-minute review. I'll look at your current search presence, identify the biggest gaps, and tell you exactly what I'd prioritise.
      </p>
      <a href="/contact" class="v4-btn v4-btn--primary" style="height:48px;font-size:15px;padding:0 32px">
        Book the free review →
      </a>
    </div>
  </section>
</Layout>

<style>
  details.v4-faq-item summary::-webkit-details-marker { display: none; }
  details.v4-faq-item[open] summary span { transform: rotate(45deg); }
  details.v4-faq-item summary span { display: inline-block; transition: transform 0.2s ease; }
  @media (max-width: 760px) {
    div[style*="grid-template-columns:2fr 1fr"],
    div[style*="grid-template-columns:1fr auto"],
    div[style*="grid-template-columns:repeat(3"] {
      grid-template-columns: 1fr !important;
    }
    div[style*="text-align:right"] {
      text-align: left !important;
      flex-direction: row !important;
      gap: 32px !important;
    }
  }
</style>
