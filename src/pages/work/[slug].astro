---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import Heading from '../../components/ui/Heading.astro';
import Text from '../../components/ui/Text.astro';
import Button from '../../components/ui/Button.astro';
import PageHero from '../../components/PageHero.astro';
import ClientLogo from '../../components/ClientLogo.astro';
import { getCases } from '../../lib/keystatic';

/* Fetched inside getStaticPaths — Astro calls it before the module's
   top-level await settles. */
export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map(c => ({
    params: { slug: c.slug },
    props: { case: c },
  }));
}

const { case: c } = Astro.props;

/* The long-form body now travels with the case study itself rather than
   being looked up in a parallel record keyed by slug. */
const detail = c.challenge ? c : null;

/* PageHero sets its title with set:html, so escape the client name. */
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const num = (n: number) => String(n + 1).padStart(2, '0');
---

<Layout
  title={`${c.client} — ${c.descriptor} · Yann Hamonou`}
  description={c.summary}
>
  <PageHero
    label={`${c.year} · ${c.descriptor}`}
    title={esc(c.client)}
    lede={c.summary}
    size={c.client.length > 12 ? 'lg' : 'xl'}
  >
    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      {/* The mark keeps its link to the client's own site; the h1 above
          carries the name for screen readers and search. */}
      {c.logo && (
        <ClientLogo
          logo={c.logo}
          name={c.client}
          decorative
          class="h-9 w-auto max-w-[14rem] grayscale"
          loading="eager"
        />
      )}
      <a href="/work" class="text-link text-sm">← All work</a>
    </div>
  </PageHero>

  <!-- Headline figure, with the case image where there is one -->
  <section class="bg-stone py-20 md:py-28">
    <Container data-group class="grid gap-12 lg:grid-cols-12 lg:items-end lg:gap-6">
      <div class:list={[c.image && c.imageAlt ? 'lg:col-span-5' : 'lg:col-span-12']}>
        <p class="font-heading text-7xl font-black leading-[0.85] tracking-[-0.05em] text-signal [font-stretch:115%]" data-m="fade">{c.stat}</p>
        <Heading as="h2" size="sm" class="mt-6 max-w-[26ch]" data-m="fade">{c.statSub}</Heading>
      </div>
      {c.image && c.imageAlt && (
        <figure class="lg:col-span-6 lg:col-start-7" data-m="frame">
          <div class="relative aspect-[3/2] overflow-hidden bg-paper">
            <img
              src={c.image}
              alt={c.imageAlt}
              style={`object-position: ${c.imageFocus};`}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover grayscale"
            />
          </div>
          <figcaption class="mt-3"><Text size="sm" tone="secondary">{c.client} — {c.descriptor}</Text></figcaption>
        </figure>
      )}
    </Container>
  </section>

  <!-- Challenge + Approach + Results -->
  {detail && (
    <section class="border-t border-ink bg-paper py-20 md:py-28">
      <Container data-group>
        <div class="grid gap-6 border-t border-ink py-10 md:grid-cols-12 md:gap-6 md:py-12" data-m="rise">
          <Heading as="h2" size="md" class="md:col-span-4">The challenge</Heading>
          <Text size="lg" class="max-w-xl md:col-span-7 md:col-start-6">{detail.challenge}</Text>
        </div>

        <div class="grid gap-6 border-t border-ink py-10 md:grid-cols-12 md:gap-6 md:py-12" data-m="rise">
          <Heading as="h2" size="md" class="md:col-span-4">The approach</Heading>
          <ol class="divide-y divide-ink md:col-span-7 md:col-start-6" role="list">
            {detail.approach.map((item, i) => (
              <li class="grid grid-cols-[3rem_1fr] gap-2 py-4 first:pt-0 last:pb-0">
                <Text size="sm" tone="secondary" class="pt-1">{num(i)}</Text>
                <Text>{item}</Text>
              </li>
            ))}
          </ol>
        </div>

        <div class="grid gap-6 border-y border-ink py-10 md:grid-cols-12 md:gap-6 md:py-12" data-m="rise">
          <Heading as="h2" size="md" class="md:col-span-4">The results</Heading>
          <ul class="divide-y divide-ink md:col-span-7 md:col-start-6" role="list">
            {detail.results.map((item) => (
              <li class="flex gap-4 py-4 first:pt-0 last:pb-0">
                <span aria-hidden="true" class="mt-2 size-2 shrink-0 rounded-full bg-signal"></span>
                <Text class="font-medium">{item}</Text>
              </li>
            ))}
          </ul>
        </div>
      </Container>
    </section>
  )}

  <!-- CTA -->
  <section class="border-t border-ink bg-signal py-20 text-ink md:py-28">
    <Container data-group class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-6">
      <div class="lg:col-span-7">
        <Heading size="xl" tone="onAccent" data-m="split" class="max-w-[11ch]">Want results like these?</Heading>
      </div>
      <div class="lg:col-span-5">
        <Text size="lg" tone="onAccent" class="max-w-md" data-m="fade">
          Book a free 30-minute review. I'll tell you where the biggest opportunity is for your business.
        </Text>
        <div class="mt-8" data-m="fade">
          <Button href="/contact" variant="dark" size="lg" arrow>Book the free review</Button>
        </div>
      </div>
    </Container>
  </section>
</Layout>
