---
import Layout from '../../layouts/Layout.astro';
import EdgeField from '../../components/EdgeField.astro';
import { cases } from '../../data/index';
import ClientLogo from '../../components/ClientLogo.astro';

export function getStaticPaths() {
  return cases.map(c => ({
    params: { slug: c.slug },
    props: { case: c },
  }));
}

const { case: c } = Astro.props;

const details: Record<string, { challenge: string; approach: string[]; results: string[] }> = {
  arnlea: {
    challenge: 'Arnlea Systems, a specialist supplier of safety-critical industrial equipment, had almost no organic search presence despite 30+ years of trading. They were losing leads to newer competitors who had invested in digital and needed to establish authority in a competitive technical niche.',
    approach: [
      'Technical SEO audit — fixed crawl errors, consolidated duplicate pages, improved site speed to pass Core Web Vitals',
      'Keyword and intent mapping — identified 40+ target terms across product categories and buyer intent stages',
      'Content strategy — created authoritative product pages, technical guides, and local landing pages for Aberdeen and North Sea market',
      'Local SEO — fully optimised Google Business Profile, Bing Places, and built consistent NAP citations',
      'GEO setup — structured data and FAQ schema to capture AI-powered search visibility',
    ],
    results: [
      '#3 Google ranking for primary commercial terms within 4 weeks of launch',
      '500% increase in organic traffic within 6 months',
      '100+ qualified organic visits per month, up from near-zero',
      'First-page visibility for 25+ target keywords',
    ],
  },
  viewport3: {
    challenge: 'Viewport3 does subsea photogrammetry: ROV and diver-mounted cameras producing sub-millimetric 3D scans of underwater assets. Buyers were comparing them against generic 3D scanning vendors on price, because the category they were being shopped in did not describe what they actually deliver. The sales cycle ran long while prospects worked out the difference for themselves.',
    approach: [
      'Positioning sprint — customer interviews first, to find what their best clients actually valued and the words they used for it',
      'Category design — reframed from "photogrammetry vendor" to "dimensional assurance partner", with seven provable differentiators behind it',
      'Messaging framework — claims, proof points and objection handling, drawn from how those customers described the service',
      'Website messaging refresh — rewrote key landing pages to lead with the repositioned narrative',
      'Demand generation strategy — defined the content and outreach channels most likely to reach their ideal buyer profile',
    ],
    results: [
      '+38% increase in qualified demo requests within 90 days',
      'Shortened average sales cycle from discovery to proposal stage',
      'Consistent positioning language adopted across sales, marketing, and leadership',
      'Clear differentiation from generic competitors in prospect conversations',
    ],
  },
};

const detail = details[c.slug];
---

<Layout
  title={`${c.client} — ${c.descriptor} · Yann Hamonou`}
  description={c.summary}
>
  <!-- Hero -->
  <section class="edge-block edge-block--dark edge-block--ink edge-page-hero">
    <EdgeField contained />
    <div class="edge-wrap">
      <a href="/work" class="edge-label" style="margin-bottom:20px;display:inline-flex;align-items:center;gap:6px;color:var(--v4-ink-dim);transition:color 0.15s ease">
        ← All work
      </a>
      {c.logo ? (
        <>
          {/* The mark is the title. It keeps its link to the client's own site,
              so it cannot also be the h1 — nesting it there would make the
              heading announce "visit website, opens in a new tab". The h1
              carries the name for screen readers and search instead. */}
          <div class="edge-case-hero__mark">
            <ClientLogo
              logo={c.logo}
              name={c.client}
              class="v4-client-logo v4-client-logo--hero"
              loading="eager"
            />
          </div>
          <h1 class="u-visually-hidden">{c.client}</h1>
        </>
      ) : (
        <h1
          style="font-family:var(--v4-display);font-weight:300;font-size:clamp(56px,10vw,140px);line-height:1.02;letter-spacing:-0.025em;color:var(--v4-ink);margin-top:32px;margin-bottom:32px"
        >
          {c.client}
        </h1>
      )}
      <div class="edge-label" style="margin-bottom:16px">{c.year} · {c.descriptor}</div>
      <p style="font-size:clamp(17px,2vw,22px);color:var(--v4-ink-mute);max-width:640px;line-height:1.6;font-weight:300">
        {c.summary}
      </p>

      <div style="display:flex;gap:40px;margin-top:40px;padding-top:32px;border-top:1px solid var(--v4-line-soft);flex-wrap:wrap">
        <div class="v4-stat" style="border-top:none;padding-top:0">
          <div class="v4-stat__num">{c.stat}</div>
          <div class="v4-stat__label">{c.statSub}</div>
        </div>
      </div>
    </div>
  </section>

  <div class="edge-sheet">

  <!-- Challenge + Approach + Results -->
  {detail && (
  <section class="edge-block edge-block--white">
    <div class="edge-wrap">
      <div style="display:flex;flex-direction:column;gap:64px">
        <!-- Challenge -->
        <div style="display:grid;grid-template-columns:200px 1fr;gap:48px;align-items:start">
          <div class="edge-label" style="padding-top:4px">The challenge</div>
          <p style="font-size:17px;color:var(--v4-ink-mute);line-height:1.7">{detail.challenge}</p>
        </div>

        <!-- Approach -->
        <div style="display:grid;grid-template-columns:200px 1fr;gap:48px;align-items:start">
          <div class="edge-label" style="padding-top:4px">The approach</div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:16px">
            {detail.approach.map(item => (
              <li style="display:flex;gap:16px;align-items:start">
                <span style="color:var(--v4-ink-dim);font-family:var(--v4-mono);font-size:11px;flex-shrink:0;padding-top:2px">→</span>
                <span style="font-size:16px;color:var(--v4-ink-mute);line-height:1.6">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Results -->
        <div style="display:grid;grid-template-columns:200px 1fr;gap:48px;align-items:start">
          <div class="edge-label" style="padding-top:4px">The results</div>
          <ul style="list-style:none;display:flex;flex-direction:column;gap:16px">
            {detail.results.map(item => (
              <li style="display:flex;gap:16px;align-items:start">
                <span style="color:var(--v4-accent-warm);font-family:var(--v4-mono);font-size:11px;flex-shrink:0;padding-top:2px">✓</span>
                <span style="font-size:16px;color:var(--v4-ink);line-height:1.6;font-weight:500">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- CTA -->
  <section class="edge-block edge-block--dark edge-block--pitch">
    <div class="edge-wrap" style="max-width:640px;text-align:center">
      <h2 class="edge-h2" style="margin-bottom:16px">Want Results<br/>Like These?</h2>
      <p style="color:var(--v4-ink-mute);font-size:17px;line-height:1.6;margin-bottom:32px">
        Book a free 30-minute review. I'll tell you where the biggest opportunity is for your business.
      </p>
      <a href="/contact" class="edge-btn" style="height:48px;font-size:15px;padding:0 32px">
        Book the free review →
      </a>
    </div>
  </section>
</div>
</Layout>

<style>
  @media (max-width: 760px) {
    div[style*="grid-template-columns:200px"] {
      grid-template-columns: 1fr !important;
      gap: 16px !important;
    }
  }
</style>
