---
import Layout from '../../layouts/Layout.astro';
import { cases } from '../../data/index';
---

<Layout
  title="Work & Case Studies — Yann Hamonou"
  description="B2B marketing case studies: real results from Aberdeen and Scottish SMEs. SEO growth, positioning, and lead generation."
>
  <section class="edge-block edge-block--dark edge-block--ink edge-page-hero">
    <div class="edge-wrap">
      <div class="edge-label" style="margin-bottom:20px">Portfolio</div>
      <h1 class="edge-h2" style="margin-bottom:24px">Selected Work</h1>
      <p style="font-size:clamp(17px,2vw,22px);color:var(--v4-ink-mute);max-width:600px;line-height:1.6;font-weight:300">
        A handful of the projects that best represent the work. Numbers are real; context is everything.
      </p>
    </div>
  </section>

  <div class="edge-sheet">

  <section class="edge-block edge-block--white">
    <div class="edge-wrap">
      <div style="display:flex;flex-direction:column;gap:2px;border-radius:0;overflow:hidden;border:1px solid var(--v4-line-soft)">
        {cases.map(c => (
          <a
            href={`/work/${c.slug}`}
            style="display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;background:var(--v4-panel);padding:clamp(24px,3vw,40px);transition:background 0.2s ease;cursor:pointer"
            onmouseover="this.style.background='var(--v4-panel-3)'"
            onmouseout="this.style.background='var(--v4-panel)'"
          >
            <div>
              {c.logo && (
                <img
                  src={c.logo.src}
                  alt=""
                  width={c.logo.w}
                  height={c.logo.h}
                  class={`v4-client-logo v4-case-row__logo${c.logo.darkInvert ? ' logo-dark-invert' : ''}`}
                  loading="lazy"
                />
              )}
              <div class="edge-label" style="margin-bottom:10px">{c.year} · {c.descriptor}</div>
              <h2 style="font-family:var(--v4-display);font-weight:400;font-size:clamp(24px,3vw,40px);letter-spacing:-0.015em;color:var(--v4-ink);margin-bottom:8px">
                {c.client}
              </h2>
              <p style="font-size:15px;color:var(--v4-ink-mute)">{c.summary}</p>
            </div>
            <div style="text-align:right;flex-shrink:0">
              <div style="font-family:var(--v4-display);font-weight:300;font-size:clamp(36px,5vw,64px);line-height:1;letter-spacing:-0.02em;color:var(--v4-ink)">
                {c.stat}
              </div>
              <div style="font-family:var(--v4-mono);font-size:11px;color:var(--v4-ink-dim);letter-spacing:0.06em;text-transform:uppercase;margin-top:4px">
                {c.statSub}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="edge-block edge-block--dark edge-block--pitch">
    <div class="edge-wrap" style="max-width:640px;text-align:center">
      <h2 class="edge-h2" style="margin-bottom:16px">Your Results<br/>Could Be Here</h2>
      <p style="color:var(--v4-ink-mute);font-size:17px;line-height:1.6;margin-bottom:32px">
        Book the free 30-minute review. No commitment — just an honest look at where your biggest marketing opportunity is.
      </p>
      <a href="/contact" class="edge-btn" style="height:48px;font-size:15px;padding:0 32px">
        Book the free review →
      </a>
    </div>
  </section>
</div>
</Layout>
