---
import EdgeField from '../components/EdgeField.astro';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  breadcrumbs?: { name: string; item: string }[];
  /** Ambient background field. On only where the page is sparse enough to
      carry it — the inner pages are still the v4 layout and go murky under it. */
  field?: boolean;
}

const {
  title: rawTitle,
  description = 'B2B marketing consultant based in Stonehaven, Scotland. Strategy, SEO, paid media, positioning, and web for Scottish SMEs.',
  ogType = 'website',
  ogImage,
  canonical: canonicalOverride,
  noindex = false,
  publishedTime,
  modifiedTime,
  author = 'Yann Hamonou',
  field = false,
  tags = [],
  breadcrumbs,
} = Astro.props;

const brand = 'Yann Hamonou';
const title = rawTitle
  ? rawTitle.includes(brand) ? rawTitle : `${rawTitle} — ${brand}`
  : `${brand} — B2B Marketing Consultant, Aberdeen`;

const canonical = canonicalOverride ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).href
  : new URL('/og-default.png', Astro.site).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151515" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={brand} />
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author && ogType === 'article' && <meta property="article:author" content={author} />}
    {tags.map(t => <meta property="article:tag" content={t} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@200;300;400;500&family=Space+Mono:wght@400;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@200;300;400;500&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- No season/theme script on this concept: the Edge language has a single
         ground (#151515). Leaving the old localStorage reader in would flash
         parchment before paint for anyone who last chose a light season. -->

    <!-- ── GA4 ──
         Same measurement ID the Webflow site uses, so the migration reads as
         one continuous property rather than a new site starting from zero.

         Production only: `astro dev` and `astro preview` would otherwise post
         every local page view into the same property you are trying to compare
         before and after cutover.

         Consent is NOT handled here. The tag sets cookies and there is no
         banner on this build, which is fine while nothing is deployed and is
         not fine on the day it is. Either add a consent tool before cutover or
         move to something cookieless. -->
    {import.meta.env.PROD && (
      <Fragment>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NEGE3F0RZC"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', 'G-NEGE3F0RZC');
        </script>
      </Fragment>
    )}

    <!-- JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://yannhamonou.pages.dev/#website",
          "url": "https://yannhamonou.pages.dev",
          "name": brand,
        },
        {
          "@type": "Person",
          "@id": "https://yannhamonou.pages.dev/#person",
          "name": brand,
          "jobTitle": "B2B Marketing Consultant",
          "url": "https://yannhamonou.pages.dev",
          "sameAs": [
            "https://www.linkedin.com/in/yannhamonou",
            "https://yannhamonou.com",
          ],
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "34 Bernham Avenue",
            "addressLocality": "Stonehaven",
            "addressRegion": "Aberdeenshire",
            "postalCode": "AB39 2WD",
            "addressCountry": "GB",
          },
        },
        {
          "@type": ["ProfessionalService", "LocalBusiness"],
          "@id": "https://yannhamonou.pages.dev/#business",
          "name": "Yann Hamonou — B2B Marketing Consultant Aberdeen",
          "description": "B2B marketing consultant serving Aberdeen, Aberdeenshire, and Scotland. Specialist in SEO, digital marketing strategy, paid media, and conversion-focused websites for SMEs.",
          "url": "https://yannhamonou.pages.dev",
          "telephone": "+447853455816",
          "email": "yanndaman@googlemail.com",
          "founder": { "@id": "https://yannhamonou.pages.dev/#person" },
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "34 Bernham Avenue",
            "addressLocality": "Stonehaven",
            "addressRegion": "Aberdeenshire",
            "postalCode": "AB39 2WD",
            "addressCountry": "GB",
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 56.9643,
            "longitude": -2.2122,
          },
          "areaServed": [
            { "@type": "City", "name": "Aberdeen" },
            { "@type": "AdministrativeArea", "name": "Aberdeenshire" },
            { "@type": "AdministrativeArea", "name": "Scotland" },
          ],
          "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
            "opens": "09:00",
            "closes": "18:00",
          },
          "sameAs": ["https://www.linkedin.com/in/yannhamonou"],
          "priceRange": "££",
        },
        ...(ogType === 'article' ? [{
          "@type": "Article",
          "headline": title,
          "description": description,
          "url": canonical,
          "author": { "@id": "https://yannhamonou.pages.dev/#person" },
          ...(publishedTime ? { "datePublished": publishedTime } : {}),
          ...((modifiedTime ?? publishedTime) ? { "dateModified": modifiedTime ?? publishedTime } : {}),
        }] : []),
        ...(breadcrumbs && breadcrumbs.length > 0 ? [{
          "@type": "BreadcrumbList",
          "itemListElement": breadcrumbs.map((crumb, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "name": crumb.name,
            "item": crumb.item,
          })),
        }] : []),
      ],
    })} />
  </head>

  <body class="v4 edge">
    {field && <EdgeField />}
    <a class="v4-skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- GSAP motion (hero entrance, scroll reveals, stat count-ups) -->
    <script>
      import '../scripts/motion.js';
      /* The Edge homepage speaks a different markup vocabulary; this pass is a
         no-op on the v4 inner pages, and motion.js is a no-op on the Edge. */
      import '../scripts/edge-motion.js';
      import '../scripts/smooth-anchors.js';
      import { initEdgeHandover } from '../scripts/edge-handover.js';
      initEdgeHandover();
    </script>

    <!-- Single ground: tag the body for the stylesheet, no theme branch. -->
    <script is:inline>
      (function () { document.body.classList.add('v4', 'edge'); })();
    </script>

    <!-- Responsive tables: wrap for desktop overflow + stamp data-label for mobile column collapse -->
    <script is:inline>
      (function () {
        document.querySelectorAll('.v4-prose table').forEach(function (table) {
          var wrap = document.createElement('div');
          wrap.className = 'v4-table-wrap';
          table.parentNode.insertBefore(wrap, table);
          wrap.appendChild(table);

          var headers = Array.from(table.querySelectorAll('thead th')).map(function (th) {
            return th.textContent ? th.textContent.trim() : '';
          });
          table.querySelectorAll('tbody tr').forEach(function (row) {
            Array.from(row.querySelectorAll('td')).forEach(function (td, i) {
              if (headers[i]) td.setAttribute('data-label', headers[i]);
            });
          });
        });
      })();
    </script>
  </body>
</html>
