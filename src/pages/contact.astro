---
import Layout from '../layouts/Layout.astro';
import { logos } from '../data/index';
import ClientLogo from '../components/ClientLogo.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="Free 30-Minute Marketing Strategy Review — Aberdeen"
  description="Book a free 30-minute marketing strategy review with Yann Hamonou, B2B marketing consultant in Aberdeen. You'll leave with a clear priority list — no pitch, no agenda."
>
  <PageHero
    label="Get in touch"
    title="Free 30-min<br />strategy review"
    lede="Tell me where you are and what's not working. I'll review your situation and share exactly what I'd prioritise. No pitch, no agenda — just a useful conversation."
  />

  <div class="edge-sheet">
  <section class="edge-block edge-block--white">
    <div class="edge-wrap">
      <div class="v4-contact-layout">

        <!-- LEFT: form -->
        <div class="v4-contact-form-col">
          <form
            action="https://formspree.io/f/xkoabzbd"
            method="POST"
            class="v4-contact-form"
          >
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
              <div class="v4-field">
                <label for="name">Name</label>
                <input type="text" id="name" name="name" required placeholder="Your name" autocomplete="name" />
              </div>
              <div class="v4-field">
                <label for="company">Company</label>
                <input type="text" id="company" name="company" placeholder="Your company" autocomplete="organization" />
              </div>
            </div>

            <div class="v4-field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required placeholder="you@company.com" autocomplete="email" />
            </div>

            <div class="v4-field">
              <label for="challenge">Biggest marketing challenge</label>
              <textarea id="challenge" name="challenge" placeholder="What's not working? Where are you losing leads? What have you already tried?" rows="5"></textarea>
            </div>

            <div style="margin-top:8px">
              <button type="submit" class="edge-btn" style="width:100%;justify-content:center;height:48px">
                Send →
              </button>
            </div>
          </form>

          <div style="margin-top:40px;padding-top:32px;border-top:1px solid var(--v4-line-soft)">
            <div class="edge-label" style="margin-bottom:12px">Prefer to call?</div>
            <a href="tel:+447853455816" style="font-size:22px;font-weight:600;color:var(--v4-ink)">+44 7853 455 816</a>
            <p style="font-size:13px;color:var(--v4-ink-dim);margin-top:4px">Mon–Fri, 9am–6pm GMT</p>
          </div>
        </div>

        <!-- RIGHT: trust panel -->
        <div class="v4-contact-trust">

          <div class="v4-contact-trust__block">
            <div class="edge-label" style="margin-bottom:16px">What to expect</div>
            <ul style="list-style:none;display:flex;flex-direction:column;gap:14px">
              {[
                { n: '01', t: 'You send the form', b: 'Takes 2 minutes. Tell me what you\'re working on and where it\'s breaking down.' },
                { n: '02', t: 'I review your situation', b: 'I\'ll look at your site, your positioning, and your marketing before we speak.' },
                { n: '03', t: '30-min call, clear priorities', b: 'You leave with a specific list of what I\'d fix first — not a generic report.' },
              ].map(step => (
                <li style="display:flex;gap:14px;align-items:flex-start">
                  <span style="font-family:var(--v4-mono);font-size:10px;color:var(--v4-ink-dim);letter-spacing:0.08em;padding-top:3px;flex-shrink:0">{step.n}</span>
                  <div>
                    <div style="font-weight:500;font-size:14px;color:var(--v4-ink);margin-bottom:2px">{step.t}</div>
                    <div style="font-size:13px;color:var(--v4-ink-mute);line-height:1.5">{step.b}</div>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="v4-contact-trust__block" style="border-top:1px solid var(--v4-line-soft);padding-top:28px">
            <div class="edge-label" style="margin-bottom:16px">Typical response time</div>
            <div style="font-family:var(--v4-display);font-weight:300;font-size:48px;line-height:1;letter-spacing:-0.02em;color:var(--v4-ink)">
              &lt;4h
            </div>
            <p style="font-size:13px;color:var(--v4-ink-mute);margin-top:8px;line-height:1.5">
              During business hours. I read every enquiry personally and respond with something useful — not a templated reply.
            </p>
          </div>

          <div class="v4-contact-trust__block" style="border-top:1px solid var(--v4-line-soft);padding-top:28px">
            <div class="edge-label" style="margin-bottom:16px">What clients say</div>
            <ClientLogo
              logo={logos.viewport3}
              name="Viewport3"
              class="v4-client-logo"
              style="margin-bottom:14px"
              decorative
            />
            <blockquote style="margin:0">
              <p style="font-size:14px;color:var(--v4-ink-mute);line-height:1.65;font-style:italic;margin-bottom:12px">
                "Within three months we saw measurable results in both organic traffic and lead quality."
              </p>
              <footer style="font-size:12px;color:var(--v4-ink-dim)">
                Chris Harvey, CEO · Viewport3, Aberdeen
              </footer>
            </blockquote>
          </div>

        </div>
      </div>
    </div>
  </section>
  </div>
</Layout>

<style>
  .v4-contact-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: clamp(40px, 6vw, 100px);
    align-items: start;
  }
  .v4-contact-trust {
    display: flex;
    flex-direction: column;
    gap: 28px;
    position: sticky;
    top: 100px;
  }
  .v4-contact-trust__block {
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 860px) {
    .v4-contact-layout {
      grid-template-columns: 1fr;
    }
    .v4-contact-trust {
      position: static;
      border-top: 1px solid var(--v4-line-soft);
      padding-top: 40px;
    }
  }
  @media (max-width: 560px) {
    div[style*="grid-template-columns:1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
