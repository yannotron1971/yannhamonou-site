---
import Layout from '../layouts/Layout.astro';
import ProblemMark from '../components/ProblemMark.astro';
import RevealBand from '../components/RevealBand.astro';
import { reader, getSettings, getHomepage, getServices, getCases, lines } from '../lib/keystatic';
import { clients } from '../data/index';
import ClientLogo from '../components/ClientLogo.astro';

const { testimonials, faq, figures } = await getSettings();
const home = await getHomepage();
const services = await getServices();
const cases = await getCases();
const { proposition, problems, results, servicesIntro, proof, faqIntro, journal, cta } = home;
const allPosts = await reader.collections.posts.all();
const recentPosts = allPosts
  .sort((a, b) => {
    const da = a.entry.publishedDate ?? '';
    const db = b.entry.publishedDate ?? '';
    return db > da ? 1 : -1;
  })
  .slice(0, 3);
---

<Layout title={home.metaTitle} description={home.metaDescription} field>
  <!-- ═══ HERO — one line, and as little else as the page can bear ═══ -->
  <section class="edge-hero">
    <div class="edge-wrap">
      <p class="edge-kicker">{home.hero.kicker}</p>

      <h1 class="edge-h1">
        {lines(home.hero.headline).map((line, i) => (
          <>{i > 0 && <br />}{line}</>
        ))}
        <span class="edge-h1__sub">{home.hero.sub}</span>
      </h1>

      <div class="edge-hero__foot">
        <a href="/contact" class="edge-btn">{home.hero.ctaLabel}</a>
        <p class="edge-hero__where">{home.hero.where}</p>
      </div>
    </div>
  </section>

  <!-- The sheet: rises over the sticky hero and takes the page to white -->
  <div class="edge-sheet">
  <!-- ═══ PROPOSITION ═══ -->
  <section class="edge-block edge-block--full edge-block--white">
    <div class="edge-wrap edge-lede">
      <p class="edge-label">{proposition.label}</p>
      <p class="edge-lede__text">{proposition.text}</p>
      <div class="edge-figures">
        {figures.map(n => (
          <div class="edge-figure">
            <span class="edge-figure__num">{n.num}</span>
            <span class="edge-figure__label">{n.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ REVEAL ═══ -->
  <RevealBand
    src="/reveal/dunnottar-1600.avif"
    srcWide="/reveal/dunnottar-2400.avif"
    alt="Dunnottar Castle on its headland above a heavy North Sea, near Stonehaven."
    caption="Dunnottar · Stonehaven"
  />

  <!-- ═══ THE PROBLEM ═══ -->
  <section class="edge-block edge-block--full edge-block--dark edge-block--slate" id="problem">
    <div class="edge-wrap">
      <div class="edge-head">
        <p class="edge-label">{problems.label}</p>
        <h2 class="edge-h2">{problems.heading}</h2>
      </div>
      <ul class="edge-problems" role="list">
        {problems.items.map(p => (
          <li>
            <ProblemMark name={p.mark} />
            <p class="edge-problem__symptom">{p.symptom}</p>
            <p class="edge-problem__cost">{p.cost}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ CLIENTS ═══ -->
  <section class="edge-block edge-block--full edge-block--paper">
    <div class="edge-wrap">
      <p class="edge-label">{home.clientsLabel}</p>
      <ul class="edge-clients" role="list">
        {clients.map(c => (
          <li>
            <ClientLogo logo={c} name={c.name} class="edge-client-logo" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ WORK ═══ -->
  <section class="edge-block edge-block--full edge-block--dark edge-block--ink" id="work">
    <div class="edge-wrap">
      <div class="edge-head">
        <p class="edge-label">{results.label}</p>
        <h2 class="edge-h2">{results.heading}</h2>
      </div>
      <ul class="edge-rows" role="list">
        {cases.map(c => (
          <li>
            <a href={`/work/${c.slug}`} class="edge-row">
              {c.logo
                ? (
                  <img
                    src={c.logo.src}
                    alt={c.client}
                    width={c.logo.w}
                    height={c.logo.h}
                    class={[
                      'edge-row__logo',
                      c.logo.darkInvert && 'logo-dark-invert',
                      c.logo.colourOnDark && 'logo-colour-on-dark',
                    ].filter(Boolean).join(' ')}
                    style={c.logo.scale ? `--logo-scale:${c.logo.scale}` : undefined}
                    loading="lazy"
                  />
                )
                : <span class="edge-row__client edge-row__client--fallback">{c.client}</span>
              }
              <span class="edge-row__desc">{c.descriptor}</span>
              <span class="edge-row__stat">{c.stat}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/work" class="edge-more">{results.moreLabel}</a>
    </div>
  </section>

  <!-- ═══ SERVICES ═══ -->
  <section class="edge-block edge-block--full edge-block--mist" id="services">
    <div class="edge-wrap">
      <div class="edge-head">
        <p class="edge-label">{servicesIntro.label}</p>
        <h2 class="edge-h2">{servicesIntro.heading}</h2>
      </div>
      <ul class="edge-rows" role="list">
        {services.map(s => (
          <li>
            <a href={`/services/${s.slug}`} class="edge-row edge-row--service">
              <span class="edge-row__num">{s.num}</span>
              <span class="edge-row__client">{s.title}</span>
              <span class="edge-row__desc">{s.desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ PROOF ═══ -->
  <section class="edge-block edge-block--full edge-block--dark edge-block--slate" id="proof">
    <div class="edge-wrap">
      <div class="edge-head">
        <p class="edge-label">{proof.label}</p>
        <h2 class="edge-h2">{proof.heading}</h2>
      </div>
      <div class="edge-quotes">
        {testimonials.map(t => (
          <figure class="edge-quote">
            {t.logo && (
              <ClientLogo logo={t.logo} name={t.company} class="edge-quote__logo" decorative />
            )}
            <blockquote>{t.quote}</blockquote>
            <figcaption>
              {t.name} — {t.role}, {t.company}{t.location ? ` · ${t.location}` : ''}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ — kept in full: this is the FAQ-schema and AI-answer surface ═══ -->
  <section class="edge-block edge-block--full edge-block--sand" id="faq">
    <div class="edge-wrap edge-wrap--narrow">
      <div class="edge-head">
        <p class="edge-label">{faqIntro.label}</p>
        <h2 class="edge-h2">{faqIntro.heading}</h2>
      </div>
      <div class="edge-faq">
        {faq.map(item => (
          <details class="edge-faq__item">
            <summary>
              {item.q}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ JOURNAL ═══ -->
  {recentPosts.length > 0 && (
    <section class="edge-block edge-block--full edge-block--bone" id="journal">
      <div class="edge-wrap">
        <div class="edge-head">
          <p class="edge-label">{journal.label}</p>
          <h2 class="edge-h2">{journal.heading}</h2>
        </div>
        <ul class="edge-rows" role="list">
          {recentPosts.map(p => (
            <li>
              <a href={`/journal/${p.slug}`} class="edge-row edge-row--post">
                <span class="edge-row__client">{p.entry.title}</span>
                <span class="edge-row__desc">{p.entry.description}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/journal" class="edge-more">{journal.moreLabel}</a>
      </div>
    </section>
  )}

  <!-- ═══ CTA ═══ -->
  <section class="edge-block edge-block--full edge-block--dark edge-block--pitch edge-cta">
    <div class="edge-wrap edge-wrap--narrow">
      <h2 class="edge-h2 edge-cta__h">
        {lines(cta.heading).map((line, i) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </h2>
      <p class="edge-cta__p">{cta.body}</p>
      <a href="/contact" class="edge-btn">{cta.buttonLabel}</a>
    </div>
  </section>
  </div>
</Layout>


