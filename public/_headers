# Cloudflare Pages response headers.
#
# Link headers point AI agents at the machine-readable files before they
# parse any HTML: llms.txt (the site summary, also linked as
# rel="alternate" in the page head) and the sitemap index. Cloudflare's
# Agent Readiness scan checks for them ("Guide AI bots to site data").
#
# Setting Link here stops Pages generating its own Early Hints header
# from the page's preconnect/preload tags, so the Google Fonts hints it
# used to send are repeated here. Keep them in step with Layout.astro.
/downloads/*
  X-Robots-Tag: noindex

/*
  Link: </llms.txt>; rel="describedby"; type="text/markdown", </llms-full.txt>; rel="describedby"; type="text/markdown", </sitemap-index.xml>; rel="sitemap"; type="application/xml"
  Link: <https://fonts.googleapis.com>; rel="preconnect", <https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500;600&display=swap>; rel="preload"; as=style
