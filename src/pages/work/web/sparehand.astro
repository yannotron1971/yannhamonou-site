      .track { grid-template-columns: 1fr 1fr; }
      .step:nth-child(3)::before { display: none; }
      .calculator, .faq { grid-template-columns: 1fr; }
      .footer-top { grid-template-columns: 1fr 1fr; }
      .footer-top > div:first-child { grid-column: 1 / -1; }
    }
    @media (max-width: 600px) {
      .wrap { width: calc(100% - 32px); }
      nav { padding-inline: 16px; }
      .brand { font-size: 23px; }
      .hero { padding: 48px 0 64px; }
      .hero h1 { font-size: 40px; }
      .hero-art { height: auto; display: flex; flex-direction: column; gap: 12px; }
      .app, .float-dark, .float-lime, .art-caption { position: static; }
      .float-lime { width: auto; }
      .app-grid { grid-template-columns: 1fr; }
      .app-side { display: none; }
      .intro { padding: 64px 0 40px; }
      .tablist button { font-size: 13px; padding: 14px 10px; }
      .panel { padding: 24px 18px; }
      .queue-row { grid-template-columns: 1fr 72px auto; padding-inline: 12px; font-size: 12px; }
      .feature { padding: 48px 0; }
      .visual { padding: 20px; min-height: 0; }
      .track { grid-template-columns: 1fr; }
      .step::before { display: none; }
      .numbers { grid-template-columns: 1fr 1fr; }
      .numbers > div:last-child { grid-column: 1 / -1; }
      .calculator { padding: 64px 0; }
      .calc-result { padding: 28px; }
      .calc-result output { font-size: 72px; }
      .final-cta { padding: 56px 0; }
      .cta-mark { font-size: 360px; top: 60px; right: -60px; opacity: .5; }
      .footer-bottom { flex-direction: column; gap: 8px; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation: none !important; transition: none !important; }
    }
  </style>
