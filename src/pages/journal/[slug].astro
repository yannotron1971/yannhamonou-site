---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import Heading from '../../components/ui/Heading.astro';
import Text from '../../components/ui/Text.astro';
import Button from '../../components/ui/Button.astro';
import { reader } from '../../lib/keystatic';
import Markdoc from '@markdoc/markdoc';

export async function getStaticPaths() {
  const posts = await reader.collections.posts.all();
  return posts.map(post => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;

/* The template post swaps the newsletter box for a template request.
   Requests arrive in Formspree with their own subject and Yann replies
   with the template by hand. */
const isTemplate = slug === 'free-b2b-marketing-plan-template-for-smes';
const post = await reader.collections.posts.read(slug!);

if (!post) return Astro.redirect('/journal');

const categoryLabels: Record<string, string> = {
  strategy: 'Strategy', seo: 'SEO & GEO', paid: 'Paid media', content: 'Content', industry: 'Industry',
};

function fmtDate(d: string | null) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

const { node: markdocNode } = await post.body();
const transformed = Markdoc.transform(markdocNode);
const renderedContent = Markdoc.renderers.html(transformed);
---

<Layout
  title={post.title}
  description={post.description ?? undefined}
  ogType="article"
  schemaImage={post.coverImage ?? undefined}
  publishedTime={post.publishedDate ?? undefined}
  modifiedTime={post.modifiedDate ?? post.publishedDate ?? undefined}
  tags={[post.category]}
  breadcrumbs={[
    { name: 'Home', item: `${Astro.site}` },
    { name: 'Journal', item: `${Astro.site}journal` },
    { name: post.title, item: `${Astro.site}journal/${slug}` },
  ]}
>
  <!-- Post header -->
  <header class="border-b border-ink bg-paper">
    <Container class="py-14 md:py-20 lg:py-24">
      <div class="max-w-3xl">
        <a href="/journal" class="text-link hero-in text-sm">← All posts</a>
        <Text size="sm" tone="secondary" class="hero-in mt-10 [--hero-at:0.1s]">
          {categoryLabels[post.category] ?? post.category}{post.publishedDate ? ` · ${fmtDate(post.publishedDate)}` : ''}
        </Text>
        <Heading as="h1" size="lg" class="hero-in mt-5 [--hero-at:0.15s]">{post.title}</Heading>
        {post.description && (
          <Text size="lg" class="hero-in mt-8 max-w-xl [--hero-at:0.3s]">{post.description}</Text>
        )}
        <Text size="sm" tone="secondary" class="hero-in mt-8 [--hero-at:0.4s]">By Yann Hamonou</Text>
      </div>
      {post.coverImage && (
        <div class="hero-in mt-12 aspect-[3/2] max-w-4xl overflow-hidden bg-stone [--hero-at:0.5s] md:aspect-[16/9]">
          <img
            src={post.coverImage}
            alt={post.coverAlt ?? ''}
            loading="eager"
            class="h-full w-full object-cover grayscale"
          />
        </div>
      )}
    </Container>
  </header>

  <!-- Body -->
  <section class="bg-paper py-16 md:py-24">
    <Container>
      <div class="prose-signal" set:html={renderedContent} />
    </Container>
  </section>

  <!-- Email capture -->
  <section class="border-t border-ink bg-stone py-20 md:py-28">
    <Container data-group class="grid gap-10 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-6">
        <Text size="sm" tone="secondary" data-m="fade">{isTemplate ? 'Free template' : 'Free B2B marketing insights'}</Text>
        <Heading size="lg" data-m="split" class="mt-4 max-w-[12ch]">{isTemplate ? 'Get the template' : 'Get the playbook'}</Heading>
        <Text tone="secondary" class="mt-6 max-w-md" data-m="fade">
          {isTemplate
            ? 'The one-page B2B marketing plan template from this guide. Enter your email and I will send it to you within one working day.'
            : 'Practical B2B marketing strategy — SEO, positioning, and lead gen — sent direct to your inbox. No fluff, no pitch. Unsubscribe any time.'}
        </Text>
      </div>
      <form
        action="https://formspree.io/f/xdoqkgpr"
        method="POST"
        class="lg:col-span-5 lg:col-start-8 lg:self-end"
        data-m="rise"
      >
        <input type="hidden" name="_subject" value={isTemplate ? 'Template request: B2B marketing plan' : 'Newsletter signup'} />
        <label for="newsletter-email" class="field-label">Email address</label>
        <div class="flex flex-col gap-3 sm:flex-row">
          <input
            id="newsletter-email"
            type="email"
            name="email"
            required
            placeholder="your@company.com"
            autocomplete="email"
            class="field min-w-0 flex-1"
          />
          <Button type="submit" variant="dark" class="shrink-0">{isTemplate ? 'Get my template' : 'Subscribe'}</Button>
        </div>
      </form>
    </Container>
  </section>

  <!-- CTA -->
  <section class="border-t border-ink bg-signal py-20 text-ink md:py-28">
    <Container data-group class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-6">
      <div class="lg:col-span-7">
        <Heading size="xl" tone="onAccent" data-m="split" class="max-w-[12ch]">Want this applied to your business?</Heading>
      </div>
      <div class="lg:col-span-5">
        <Text size="lg" tone="onAccent" class="max-w-md" data-m="fade">
          Book a free 30-minute strategy review. We'll look at how these ideas apply specifically to your situation.
        </Text>
        <div class="mt-8" data-m="fade">
          <Button href="/contact" variant="dark" size="lg" arrow>Book the free review</Button>
        </div>
      </div>
    </Container>
  </section>
</Layout>
