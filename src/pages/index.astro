---
import Layout from '../layouts/Layout.astro';
import { cases, numbers, testimonials } from '../data/index';

const seasons = [
  {
    idx: '01',
    season: 'Spring',
    name: 'Planting',
    line: 'Set the roots.',
    desc: 'Every enduring brand starts below ground. Strategy and positioning give every pound you spend a direction — before a single ad runs.',
    services: [
      { label: 'Marketing Strategy', href: '/services/strategy' },
      { label: 'Positioning', href: '/services/positioning' },
    ],
    accent: '#4a6b4c',
    tint: 'rgba(74, 107, 76, 0.09)',
    glyph: 'sprout',
  },
  {
    idx: '02',
    season: 'Summer',
    name: 'Cultivating',
    line: 'Grow what compounds.',
    desc: 'Organic visibility and a site that converts — the patient work that compounds season after season, in search and in AI answers.',
    services: [
      { label: 'SEO & GEO', href: '/services/seo-aberdeen' },
      { label: 'Web & CRO', href: '/services/web' },
    ],
    accent: '#2e4a36',
    tint: 'rgba(46, 74, 54, 0.09)',
    glyph: 'leaf',
  },
  {
    idx: '03',
    season: 'Autumn',
    name: 'Harvesting',
    line: 'Take the yield.',
    desc: 'When the field is ready, paid media brings the harvest in: qualified leads from Google, LinkedIn, and Meta — tracked to revenue, not clicks.',
    services: [
      { label: 'Paid Media', href: '/services/paid' },
    ],
    accent: '#b85c2e',
    tint: 'rgba(184, 92, 46, 0.09)',
    glyph: 'acorn',
  },
  {
    idx: '04',
    season: 'Winter',
    name: 'Weathering',
    line: 'Endure the storms.',
    desc: 'Automation keeps the pipeline warm through the quiet months — nurture sequences and lead scoring so no enquiry falls through the cracks.',
    services: [
      { label: 'Marketing Automation', href: '/services/automation' },
    ],
    accent: '#7d6584',
    tint: 'rgba(125, 101, 132, 0.10)',
    glyph: 'wind',
  },
];

const numerals = ['I', 'II', 'III', 'IV'];
const etchQuote = testimonials[0];
---

<Layout
  title="Marketing Consultant Aberdeen — Yann Hamonou"
  description="B2B marketing consultant and digital marketing specialist based in Stonehaven, Scotland. Strategy, SEO, paid media, and automation that generate qualified leads for Scottish SMEs. Free 30-min review."
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&display=swap"
  />

  <div class="oak">
    <!-- ═══ HERO — THE SPARK ═══ -->
    <section class="oak-hero">
      <div class="oak-wrap oak-hero__grid">
        <div class="oak-hero__copy">
          <p class="oak-hero__eyebrow">Yann Hamonou · B2B Marketing · Stonehaven, Scotland</p>
          <h1 class="oak-hero__title">
            <span class="oak-line">Deep Roots.</span>
            <span class="oak-line oak-line--accent">Bold Growth.</span>
          </h1>
          <p class="oak-hero__sub">
            Marketing from the edge of the North Sea. Strategy, SEO, and paid media
            that turn Scottish B2B businesses into enduring brands — not vanity metrics.
          </p>
          <div class="oak-hero__ctas">
            <a href="/contact" class="oak-btn oak-btn--primary">Start the Season →</a>
            <a href="#ledger" class="oak-btn oak-btn--ghost">Read the Ledger</a>
          </div>
          <p class="oak-hero__foot">20+ years B2B · #1 Google rank in 4 weeks · 500% organic growth</p>
        </div>

        <!-- The Bough — a great oak branch reaching in from the right edge,
             blooming across the hero on scroll -->
        <div class="oak-hero__art" aria-hidden="true">
          <svg viewBox="0 0 1400 800" fill="none" xmlns="http://www.w3.org/2000/svg" class="oak-sapling" preserveAspectRatio="xMaxYMid slice">
            <defs>
              <filter id="oak-rough" x="-5%" y="-5%" width="110%" height="110%">
                <feTurbulence type="fractalNoise" baseFrequency="0.022 0.045" numOctaves="2" seed="7" result="n" />
                <feDisplacementMap in="SourceGraphic" in2="n" scale="4" />
              </filter>
              <filter id="oak-wash-f" x="-20%" y="-20%" width="140%" height="140%">
                <feTurbulence type="fractalNoise" baseFrequency="0.008" numOctaves="3" seed="5" result="wn" />
                <feDisplacementMap in="SourceGraphic" in2="wn" scale="60" />
              </filter>
              <!-- Pedunculate oak leaf: obovate outline, four rounded lobes a
                   side with deep sinuses, midrib, pinnate veins, short stalk -->
              <g id="oak-leaf-shape">
                <path
                  d="M0 -6 Q -8 -6 -7.5 -10 Q -7 -13 -3.5 -13.5 Q -11 -13.5 -10.5 -17 Q -10 -20.5 -4.5 -20.5 Q -12.5 -20.5 -12 -24 Q -11.5 -27.5 -5 -27.5 Q -11 -27.5 -10 -31 Q -9 -34 -4 -34 Q -8.5 -34.5 -6.5 -38 Q -4.5 -42 0 -44 Q 4.5 -42 6.5 -38 Q 8.5 -34.5 4 -34 Q 9 -34 10 -31 Q 11 -27.5 5 -27.5 Q 11.5 -27.5 12 -24 Q 12.5 -20.5 4.5 -20.5 Q 10 -20.5 10.5 -17 Q 11 -13.5 3.5 -13.5 Q 7 -13 7.5 -10 Q 8 -6 0 -6 Z"
                  stroke="#26302c"
                  stroke-opacity="0.4"
                  stroke-width="1"
                />
                <path
                  d="M0 0 L0 -42 M0 -10.5 L-5.5 -9 M0 -10.5 L5.5 -9 M0 -17.5 L-7.5 -15.5 M0 -17.5 L7.5 -15.5 M0 -24.5 L-8.5 -22.5 M0 -24.5 L8.5 -22.5 M0 -31.5 L-7 -29.5 M0 -31.5 L7 -29.5 M0 -37.5 L-4.5 -36 M0 -37.5 L4.5 -36"
                  stroke="#26302c"
                  stroke-opacity="0.3"
                  stroke-width="0.9"
                  fill="none"
                  stroke-linecap="round"
                />
              </g>
              <g id="oak-acorn-shape">
                <line x1="0" y1="0" x2="0" y2="5" stroke="#54401f" stroke-width="1.6" />
                <ellipse cx="0" cy="13" rx="5.2" ry="8" fill="#9a6b30" />
                <path d="M-6.5 8.5 Q0 3.5 6.5 8.5 L6 11.5 Q0 8.5 -6 11.5 Z" fill="#5d431f" />
              </g>
            </defs>

            <g filter="url(#oak-rough)">
              <!-- Canopy washes — invisible until the bloom paints them in (JS-gated
                   decoration; no-JS and reduced-motion visitors keep ink on parchment) -->
              <g class="oak-washes" filter="url(#oak-wash-f)">
                <ellipse class="oak-wash" cx="1150" cy="300" rx="400" ry="260" fill="#2e4a36" opacity="0" />
                <ellipse class="oak-wash" cx="1000" cy="480" rx="420" ry="210" fill="#3d5c42" opacity="0" />
                <ellipse class="oak-wash" cx="820" cy="250" rx="380" ry="230" fill="#35513b" opacity="0" />
                <ellipse class="oak-wash" cx="700" cy="620" rx="520" ry="170" fill="#2e4a36" opacity="0" />
                <ellipse class="oak-wash" cx="520" cy="270" rx="340" ry="220" fill="#2e4a36" opacity="0" />
                <ellipse class="oak-wash" cx="380" cy="480" rx="340" ry="200" fill="#35513b" opacity="0" />
                <ellipse class="oak-wash" cx="180" cy="300" rx="280" ry="200" fill="#3d5c42" opacity="0" />
              </g>

              <!-- The great bough — inks in from the right edge on load -->
              <g class="oak-branch" stroke="#2b2f2a" stroke-linecap="round" fill="none">
                <path stroke-width="16" d="M1405 445 C1300 430 1215 408 1115 375 C1010 340 905 322 800 312 C710 300 625 275 560 245" />
                <path stroke-width="10" d="M800 312 C740 272 688 252 628 242 C580 234 545 228 510 214" />
                <path stroke-width="9" d="M1115 375 C1058 322 998 282 928 252 C868 227 818 212 758 207" />
                <path stroke-width="9" d="M1250 410 C1228 344 1202 300 1160 252 C1130 216 1118 184 1092 152" />
                <path stroke-width="8" d="M905 322 C845 362 782 384 700 398" />
                <path stroke-width="6" d="M758 207 C712 200 672 188 640 172" />
                <path stroke-width="6" d="M928 252 C898 216 878 196 850 182" />
                <path stroke-width="5" d="M1160 252 C1132 240 1106 238 1076 244" />
                <path stroke-width="5" d="M628 242 C600 226 574 214 544 210" />
                <path stroke-width="5" d="M700 398 C650 412 610 424 566 428" />
                <path stroke-width="5" d="M1115 375 C1092 396 1064 410 1030 416" />
                <path stroke-width="4" d="M560 245 C520 236 486 226 458 212" />
              </g>

              <!-- Leaves — bloom right-to-left on scroll -->
              <g class="oak-leaves">
                <g class="oak-leaf" transform="translate(1240 380) rotate(-20) scale(1.6)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(1180 330) rotate(15) scale(1.4)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(1120 300) rotate(-40) scale(1.5)"><use href="#oak-leaf-shape" fill="#3a5c40" /></g>
                <g class="oak-leaf" transform="translate(1090 160) rotate(-15) scale(1.7)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(1105 175) rotate(30) scale(1.3)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(1150 250) rotate(-60) scale(1.3)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
                <g class="oak-leaf" transform="translate(1076 248) rotate(20) scale(1.2)"><use href="#oak-leaf-shape" fill="#3a5c40" /></g>
                <g class="oak-leaf" transform="translate(1210 420) rotate(45) scale(1.2)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
                <g class="oak-leaf" transform="translate(1000 340) rotate(-25) scale(1.5)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(950 255) rotate(10) scale(1.6)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(928 258) rotate(-45) scale(1.2)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
                <g class="oak-leaf" transform="translate(860 185) rotate(-10) scale(1.7)"><use href="#oak-leaf-shape" fill="#3a5c40" /></g>
                <g class="oak-leaf" transform="translate(845 190) rotate(35) scale(1.3)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(905 205) rotate(-30) scale(1.2)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(1030 420) rotate(25) scale(1.4)"><use href="#oak-leaf-shape" fill="#3a5c40" /></g>
                <g class="oak-leaf" transform="translate(1005 428) rotate(-15) scale(1.2)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
                <g class="oak-leaf" transform="translate(800 315) rotate(-20) scale(1.5)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(760 210) rotate(-5) scale(1.8)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(740 215) rotate(-40) scale(1.3)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
                <g class="oak-leaf" transform="translate(775 225) rotate(28) scale(1.4)"><use href="#oak-leaf-shape" fill="#3a5c40" /></g>
                <g class="oak-leaf" transform="translate(700 400) rotate(15) scale(1.5)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(665 408) rotate(-25) scale(1.2)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(820 235) rotate(60) scale(1.2)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
                <g class="oak-leaf" transform="translate(870 300) rotate(5) scale(1.2)"><use href="#oak-leaf-shape" fill="#3a5c40" /></g>
                <g class="oak-leaf" transform="translate(640 175) rotate(-20) scale(1.7)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(615 185) rotate(20) scale(1.3)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(628 245) rotate(-50) scale(1.4)"><use href="#oak-leaf-shape" fill="#3a5c40" /></g>
                <g class="oak-leaf" transform="translate(560 428) rotate(10) scale(1.4)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
                <g class="oak-leaf" transform="translate(600 240) rotate(40) scale(1.2)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(585 300) rotate(-10) scale(1.3)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(660 300) rotate(25) scale(1.2)"><use href="#oak-leaf-shape" fill="#3a5c40" /></g>
                <g class="oak-leaf" transform="translate(540 212) rotate(-25) scale(1.5)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(510 218) rotate(15) scale(1.2)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
                <g class="oak-leaf" transform="translate(444 262) rotate(-35) scale(1.3)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(475 255) rotate(30) scale(1.1)"><use href="#oak-leaf-shape" fill="#3a5c40" /></g>
                <g class="oak-leaf" transform="translate(540 295) rotate(-8) scale(1.2)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
              </g>

              <!-- Acorns -->
              <g class="oak-acorns">
                <use href="#oak-acorn-shape" class="oak-acorn-i" transform="translate(1135 270) rotate(10) scale(1.4)" />
                <use href="#oak-acorn-shape" class="oak-acorn-i" transform="translate(985 440) rotate(8) scale(1.3)" />
                <use href="#oak-acorn-shape" class="oak-acorn-i" transform="translate(890 215) rotate(-6) scale(1.4)" />
                <use href="#oak-acorn-shape" class="oak-acorn-i" transform="translate(700 225) rotate(8) scale(1.3)" />
                <use href="#oak-acorn-shape" class="oak-acorn-i" transform="translate(610 315) rotate(-5) scale(1.2)" />
              </g>
            </g>
          </svg>
        </div>
      </div>
      <p class="oak-hero__hint" aria-hidden="true">Scroll — watch it grow ↓</p>
    </section>

    <!-- ═══ THE BEDROCK — PHILOSOPHY ═══ -->
    <section class="oak-bedrock">
      <!-- Parallax Dunnottar scene: sea + headland (far), sea stacks + mist (mid), castle rock (near) -->
      <div class="oak-bedrock__cliffs" aria-hidden="true">
        <svg class="oak-cliff" data-speed="-6" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
          <!-- North Sea -->
          <rect x="0" y="400" width="1440" height="200" fill="#6f8189" opacity="0.28" />
          <line x1="0" y1="400" x2="1440" y2="400" stroke="#5c6d75" stroke-width="1.5" opacity="0.4" />
          <!-- far headland -->
          <path d="M0 400 L0 356 L130 344 L270 368 L380 400 Z" fill="#8b979c" opacity="0.4" />
          <!-- wave strokes -->
          <g stroke="#5c6d75" stroke-width="1.5" fill="none" opacity="0.3" stroke-linecap="round">
            <path d="M120 468 q 24 -7 48 0" />
            <path d="M300 510 q 20 -6 40 0" />
            <path d="M520 460 q 24 -7 48 0" />
            <path d="M240 445 q 16 -5 32 0" />
          </g>
          <!-- birds -->
          <path d="M430 250 q 7 -7 14 0 q 7 -7 14 0" stroke="#3a444b" stroke-width="1.6" fill="none" opacity="0.4" />
          <path d="M505 288 q 5 -5 10 0 q 5 -5 10 0" stroke="#3a444b" stroke-width="1.4" fill="none" opacity="0.3" />
        </svg>
        <svg class="oak-cliff" data-speed="-12" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
          <!-- sea stacks off the point -->
          <path d="M560 600 L572 468 L594 452 L612 480 L620 600 Z" fill="#667380" opacity="0.5" />
          <path d="M652 600 L660 512 L676 500 L688 524 L692 600 Z" fill="#667380" opacity="0.42" />
          <!-- rolling mist over the water -->
          <ellipse cx="380" cy="430" rx="320" ry="46" fill="#f2eee4" opacity="0.4" />
          <ellipse cx="900" cy="470" rx="380" ry="54" fill="#f2eee4" opacity="0.32" />
        </svg>
        <svg class="oak-cliff" data-speed="-20" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
          <!-- Dunnottar rock: sheer-sided promontory joined to the mainland by a low saddle -->
          <path d="M760 600 L768 430 L782 300 L790 252 L1118 250 L1132 322 L1152 372 L1182 384 L1236 372 L1310 334 L1380 314 L1440 306 L1440 600 Z" fill="#3a444b" opacity="0.92" />
          <!-- rock strata -->
          <g stroke="#26302c" stroke-width="2" fill="none" opacity="0.22">
            <path d="M790 340 C860 332 940 336 1010 330" />
            <path d="M780 430 C870 418 980 424 1090 414" />
            <path d="M775 520 C880 506 1000 512 1115 500" />
          </g>
          <!-- the castle ruins on the plateau -->
          <g fill="#2c353c">
            <!-- ruined gable -->
            <path d="M812 252 L812 216 L826 200 L832 252 Z" />
            <!-- low curtain wall -->
            <path d="M842 252 L842 228 L930 220 L930 252 Z" />
            <!-- broken wall blocks -->
            <path d="M940 252 L940 210 L962 202 L982 212 L982 252 Z" />
            <path d="M992 252 L992 192 L1022 184 L1032 196 L1032 252 Z" />
            <!-- the keep, gabled -->
            <path d="M1042 252 L1042 172 L1049 164 L1049 150 L1065 136 L1081 150 L1081 164 L1088 172 L1088 252 Z" />
          </g>
          <!-- window slits on the keep -->
          <g stroke="#8b979c" stroke-width="2" opacity="0.5" stroke-linecap="round">
            <path d="M1058 190 V202" />
            <path d="M1072 190 V202" />
            <path d="M1065 218 V232" />
            <path d="M1006 210 V224" />
          </g>
          <!-- grass lip on the plateau edge -->
          <path d="M786 254 C880 246 1010 246 1122 252" stroke="#47714b" stroke-width="4" fill="none" opacity="0.55" stroke-linecap="round" />
        </svg>
      </div>

      <div class="oak-wrap oak-bedrock__inner">
        <div class="oak-panel" data-mist>
          <p class="oak-eyebrow">The Bedrock</p>
          <h2 class="oak-h2" data-etch>Built on stone,<br />not sand.</h2>
          <p class="oak-lead">
            Stonehaven has weathered every storm the North Sea could send for a
            thousand years. That's how I build marketing: <strong>strategy first,
            then execution</strong> — positioning, SEO, paid media, and automation,
            all bearing on the same foundation. Most marketing problems aren't
            channel problems; they're strategy problems. Fix the upstream problem
            and everything downstream stands firm.
          </p>
          <div class="oak-stats">
            {numbers.map((n) => (
              <div class="oak-stat">
                <span class="oak-stat__num">{n.num}</span>
                <span class="oak-stat__label">{n.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ THE FOUR SEASONS — SERVICES ═══ -->
    <section class="oak-seasons">
      <div class="oak-wrap">
        <div data-mist>
          <p class="oak-eyebrow">The Four Seasons</p>
          <h2 class="oak-h2" data-etch>A season for every<br />stage of growth.</h2>
        </div>
        <div class="oak-seasons__grid">
          {seasons.map((s) => (
            <article class="oak-season" style={`--season-accent:${s.accent};--season-tint:${s.tint}`} data-mist>
              <div class="oak-season__top">
                <span class="oak-season__idx">{s.idx} · {s.season}</span>
                <span class="oak-season__glyph" aria-hidden="true">
                  {s.glyph === 'sprout' && (
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M14 25 V14" /><path d="M14 14 C14 8 8 5.5 4.5 7.5 C5.5 12 10 14 14 14 Z" /><path d="M14 14 C14 9 19.5 5.5 23.5 7.5 C22.5 12 18 14 14 14 Z" /></svg>
                  )}
                  {s.glyph === 'leaf' && (
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M14 25 C13 18 13 12 14 4" /><path d="M14 4 C9 6 6 9 6.5 14 C7 18.5 10 21.5 14 22 C18 21.5 21 18.5 21.5 14 C22 9 19 6 14 4 Z" /></svg>
                  )}
                  {s.glyph === 'acorn' && (
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M14 3 V6" /><path d="M7 11 Q14 5.5 21 11 L20.5 13.5 Q14 10.5 7.5 13.5 Z" /><path d="M9 13 C9 19 11 23 14 25 C17 23 19 19 19 13" /></svg>
                  )}
                  {s.glyph === 'wind' && (
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 23 C10 19 15 19 24 12" /><path d="M13 17.5 C14 14 17 12.5 21 12.5" /><path d="M4 8 H13" /><path d="M6 12 H11" /></svg>
                  )}
                </span>
              </div>
              <h3 class="oak-season__name">{s.name}</h3>
              <p class="oak-season__line">{s.line}</p>
              <p class="oak-season__desc">{s.desc}</p>
              <ul class="oak-season__services" role="list">
                {s.services.map((sv) => (
                  <li><a href={sv.href}>{sv.label} <span aria-hidden="true">→</span></a></li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ THE HIGHLAND LEDGER — CASE STUDIES ═══ -->
    <section class="oak-ledger" id="ledger">
      <div class="oak-ledger__head oak-wrap" data-mist>
        <p class="oak-eyebrow">The Highland Ledger</p>
        <h2 class="oak-h2" data-etch>Local successes,<br />carved in results.</h2>
      </div>
      <div class="oak-ledger__track">
        {cases.map((c, i) => (
          <a href={`/work/${c.slug}`} class="oak-entry">
            <span class="oak-entry__numeral" aria-hidden="true">{numerals[i]}</span>
            {c.image && <img src={c.image} alt="" class="oak-entry__img" loading="lazy" />}
            <div class="oak-entry__body">
              <p class="oak-entry__meta">{c.year} · {c.descriptor}</p>
              <h3 class="oak-entry__client">{c.client}</h3>
              <p class="oak-entry__stat">{c.stat}</p>
              <p class="oak-entry__sub">{c.statSub}</p>
              <p class="oak-entry__summary">{c.summary}</p>
              <span class="oak-entry__link">Read the entry →</span>
            </div>
          </a>
        ))}
        <div class="oak-entry oak-entry--cta">
          <div class="oak-entry__body">
