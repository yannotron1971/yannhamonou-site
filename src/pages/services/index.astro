---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/index';
import PageHero from '../../components/PageHero.astro';
---

<Layout
  title="Marketing Services — Yann Hamonou"
  description="B2B marketing services: strategy, positioning, SEO & GEO, paid media, and web & CRO. Based in Aberdeen, serving Scotland and the UK."
>
  <PageHero
    label="What I do"
    title="Services"
    lede="Integrated B2B marketing — from strategy to execution. Every service is built around a single outcome: qualified leads and sustainable growth."
  />

  <div class="edge-sheet">
  <!-- The services themselves, as rows rather than a card grid: same rhythm as
       the homepage, and the descriptions read better on one line each. -->
  <section class="edge-block edge-block--white">
    <div class="edge-wrap">
      <ul class="edge-rows" role="list">
        {services.map(s => (
          <li>
            <a href={`/services/${s.slug}`} class="edge-row edge-row--service">
              <span class="edge-row__num">{s.num}</span>
              <span class="edge-row__client">{s.title}</span>
              <span class="edge-row__desc">{s.desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="edge-block edge-block--dark edge-block--pitch edge-cta">
    <div class="edge-wrap edge-wrap--narrow">
      <h2 class="edge-h2 edge-cta__h">Not sure where<br/>to start?</h2>
      <p class="edge-cta__p">
        Book the free 30-minute review. I'll listen, diagnose, and tell you where the highest-leverage opportunity is for your business.
      </p>
      <a href="/contact" class="edge-btn">Book the free review →</a>
    </div>
  </section>
  </div>
</Layout>
