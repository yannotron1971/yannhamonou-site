---
/* SEO Aberdeen: the site's main SEO landing page, Signal Poster layout.
   Copy, headings, FAQ, internal links and schema are unchanged from the
   Edge v4 version; only markup and classes moved to the new system. */
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import Heading from '../../components/ui/Heading.astro';
import Text from '../../components/ui/Text.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { logos, serviceImages } from '../../data/index';
import { getServices } from '../../lib/keystatic';

const services = await getServices();
const otherServices = services.filter(s => s.slug !== 'seo-aberdeen');

const faq = [
  {
    q: 'How long does SEO take to show results in Aberdeen?',
    a: 'For most Aberdeen SMEs, you can expect meaningful movement in local rankings within 6–12 weeks of fixing technical issues and building on-page signals. Competitive commercial terms typically take 3–6 months to hold. Incident Insight went from page two to the top two in the UK for its category term in about three months.',
  },
  {
    q: 'What is different about SEO for Aberdeen businesses?',
    a: 'Aberdeen has a distinct search landscape shaped by the energy sector, professional services, and a tight geographic market. Competitors are often national firms with larger budgets, so local authority signals — Google Business Profile, Aberdeen-specific content, local backlinks from trade bodies and business groups — carry more weight here than in a generic national campaign.',
  },
  {
    q: 'Do you cover GEO — AI-powered search visibility?',
    a: 'Yes. GEO (Generative Engine Optimisation) is built into every engagement. As Google AI Overviews, Bing Copilot, and ChatGPT increasingly answer queries before a click, the businesses being cited are those with structured, authoritative, local content. The technical foundations of good SEO and GEO overlap significantly — strong SEO is the floor; chunk-level content quality is what gets you cited.',
  },
  {
    q: 'Can you help with Google Business Profile for Aberdeen?',
    a: 'Absolutely. GBP optimisation is a core part of any Aberdeen SEO engagement. That means completing every field, selecting the right categories, adding products and services, publishing regular posts, and building a review acquisition strategy — all of which affect prominence in the Aberdeen Maps pack.',
  },
  {
    q: 'What does an SEO engagement with you cost?',
    a: 'Engagements are scoped to your situation — there is no off-the-shelf package, and what a site needs after an audit varies more than any price list would suggest. The free 30-minute review is the right starting point: I will tell you where the biggest opportunity is, and what it would take, before you commit to anything.',
  },
  {
    q: 'What is GEO and why does it matter for Aberdeen businesses?',
    a: 'Generative Engine Optimisation (GEO) is the practice of structuring your content so that AI-powered search tools — ChatGPT, Perplexity, Google AI Overviews, Bing Copilot — cite your business in their generated answers. As more B2B buyers use these tools to research suppliers, businesses that are not optimised for AI search will lose visibility to competitors who are. This is particularly relevant in Aberdeen\'s professional services and energy sectors, where buyers increasingly ask AI tools for recommendations before contacting providers.',
  },
];
---

<Layout
  title="SEO Aberdeen — Search & AI Visibility for Scottish Businesses · Yann Hamonou"
  description="SEO consultant based in Aberdeen and Stonehaven. Technical SEO, local SEO, content strategy, and GEO for Aberdeen and Scottish B2B businesses. Free 30-min review."
  breadcrumbs={[
    { name: 'Home', item: `${Astro.site}` },
    { name: 'Services', item: `${Astro.site}services` },
    { name: 'SEO Aberdeen', item: `${Astro.site}services/seo-aberdeen` },
  ]}
>
  <!-- Service schema -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "SEO Aberdeen — Search & AI Visibility",
    "description": "Technical SEO, local SEO, content strategy, and Generative Engine Optimisation (GEO) for Aberdeen and Scottish B2B businesses.",
    "provider": {
      "@type": "Person",
      "@id": "https://yannhamonou-site.pages.dev/#person",
      "name": "Yann Hamonou"
    },
    "areaServed": [
      { "@type": "City", "name": "Aberdeen" },
      { "@type": "AdministrativeArea", "name": "Aberdeenshire" },
      { "@type": "AdministrativeArea", "name": "Scotland" }
    ],
    "serviceType": "SEO Consultancy",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "SEO & GEO services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SEO & GEO audit" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ongoing SEO & GEO retainer" } }
      ]
    }
  })} />

  <!-- ═══ HERO ═══ -->
  <PageHero
    label="03 · Service"
    title="SEO Aberdeen"
    lede="Search engine optimisation and AI visibility for Aberdeen and Scottish B2B businesses. Get found by buyers who are already looking for what you sell."
    image={serviceImages['seo-aberdeen']}
  >
    <a href="/services" class="text-link mt-8 inline-block text-sm">← All services</a>
  </PageHero>

  <!-- ═══ What SEO in Aberdeen actually requires ═══ -->
  <section class="bg-paper py-20 md:py-28">
    <Container data-group class="grid gap-12 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-7">
        <Text size="sm" tone="secondary" data-m="fade">The Aberdeen context</Text>
        <div class="mt-8 space-y-5" data-m="fade">
          <Text size="lg" class="max-w-xl">
            Aberdeen search results are competitive in a specific way. National firms with large domain authority dominate generic terms. Local businesses win by being clearly the most relevant, most trusted, most geographically specific result for Aberdeen and Aberdeenshire buyers.
          </Text>
          <Text size="lg" class="max-w-xl">
            That means Aberdeen SEO is not the same as generic SEO. It requires a precise combination: technical foundations that Googlebot can actually crawl, local authority signals that the Maps algorithm weights heavily, content built around how Aberdeen buyers actually search, and increasingly, structured data that feeds the AI summaries taking over the top of the page.
          </Text>
          <Text size="lg" class="max-w-xl">
            I have delivered this specifically for Aberdeen and Scottish B2B companies — from industrial equipment suppliers serving the North Sea to professional services firms in the city centre. The work is practical, not theoretical.
          </Text>
        </div>
        <div class="mt-10" data-m="fade">
          <Button href="/contact">Discuss your SEO situation</Button>
        </div>
      </div>

      <div class="lg:col-span-4 lg:col-start-9" data-m="rise">
        <Text as="p" class="font-semibold">What's included</Text>
        <ul class="mt-6 border-b border-ink">
          {[
            'Technical SEO audit & fixes',
            'Keyword & intent mapping',
            'Local SEO & GBP optimisation',
            'Content strategy & planning',
            'On-page optimisation',
            'GEO / AI visibility setup',
            'Monthly reporting & recommendations',
          ].map(item => (
            <li class="border-t border-ink py-4"><Text size="sm">{item}</Text></li>
          ))}
        </ul>
      </div>
    </Container>
  </section>

  <!-- ═══ Aberdeen industries ═══ -->
  <section class="border-t border-ink bg-paper py-20 md:py-28">
    <Container data-group>
      <Text size="sm" tone="secondary" data-m="fade">Who I work with in Aberdeen</Text>
      <Heading size="lg" data-m="split" class="mt-6 max-w-3xl">Aberdeen's Economy Has<br />Specific Search Behaviour</Heading>
      <Text tone="secondary" class="mt-8 max-w-xl" data-m="fade">
        Generic SEO strategies built for retail or national brands rarely work here. Aberdeen's B2B buyers search differently — longer queries, industry-specific terminology, and a strong preference for local providers with demonstrable sector experience.
      </Text>
      <ul class="mt-12 grid border-t border-ink md:mt-16 md:grid-cols-2">
        {[
          {
            sector: 'Energy & Oil and Gas',
            body: 'Supply chain suppliers, decommissioning services, and energy transition companies serving operators and Tier 1 contractors. Buyers search by accreditation, certification, and specific service category — generic terms rarely convert.',
          },
          {
            sector: 'Engineering & Industrial',
            body: 'North Sea equipment suppliers, inspection services, and industrial contractors. Long buying cycles with multiple stakeholders. Content that answers technical questions and demonstrates sector credibility drives the leads that convert.',
          },
          {
            sector: 'Professional Services',
            body: 'Aberdeen law firms, accountancies, financial advisers, and management consultancies. Local trust signals — reviews, GBP prominence, named Aberdeen landing pages — are the primary differentiator against national firms.',
          },
          {
            sector: 'Technology & SaaS',
            body: 'Aberdeen\'s growing technology cluster includes software companies, digital agencies, and SaaS businesses targeting national and global markets. SEO and GEO give them visibility beyond word-of-mouth in a tight local network.',
          },
        ].map((item, i) => (
          <li data-m="rise" class:list={[
            'border-b border-ink py-8 md:py-10',
            i % 2 === 0 ? 'md:border-r md:pr-10' : 'md:pl-10',
          ]}>
            <Heading as="h3" size="md">{item.sector}</Heading>
            <Text class="mt-4 max-w-md">{item.body}</Text>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <!-- ═══ Three pillars of Aberdeen SEO: orange numbered circles ═══ -->
  <section class="border-t border-ink bg-paper py-20 md:py-28">
    <Container data-group>
      <Text size="sm" tone="secondary" data-m="fade">How it works</Text>
      <Heading size="lg" data-m="split" class="mt-6">The Three Pillars</Heading>
      <ol class="mt-12 grid gap-10 md:mt-16 md:grid-cols-3 md:gap-0">
        {[
          {
            num: '01',
            title: 'Technical foundation',
            body: 'A site Googlebot cannot crawl cannot rank. I start with a full technical audit: Core Web Vitals, crawl errors, redirect chains, duplicate content, mobile rendering, and site architecture. Most Aberdeen SME sites have 4–8 fixable technical issues holding back their rankings.',
          },
          {
            num: '02',
            title: 'Local authority',
            body: 'Google Business Profile, Bing Places, NAP consistency across citations, Aberdeen-specific landing pages, and a review acquisition strategy. These are the signals that determine whether you appear in the Aberdeen Maps pack — the most valuable real estate for local service businesses.',
          },
          {
            num: '03',
            title: 'Content & AI visibility',
            body: 'Content built around how Aberdeen buyers actually search — not generic keyword lists. Structured so that both Googlebot and AI systems (Google AI Overviews, Bing Copilot, ChatGPT) can extract, attribute, and cite your answers. GEO is not a separate discipline; it is built into every content decision.',
          },
        ].map(step => (
          <li data-m="rise" class="md:border-l md:border-ink md:px-8 md:first:border-l-0 md:first:pl-0">
            <span aria-hidden="true" class="flex size-12 items-center justify-center rounded-full bg-signal font-body text-lg font-semibold text-ink">{step.num}</span>
            <Heading as="h3" size="md" class="mt-6">{step.title}</Heading>
            <Text class="mt-3">{step.body}</Text>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <!-- ═══ Aberdeen SEO results (case study): stone band, poster figures ═══ -->
  <section class="border-t border-ink bg-stone py-20 md:py-28">
    <Container data-group>
      <Text size="sm" tone="secondary" data-m="fade">Aberdeen SEO results</Text>
      <Heading size="lg" data-m="split" class="mt-6 max-w-3xl">What This Looks Like<br />In Practice</Heading>

      <div class="mt-12 grid gap-12 md:mt-16 lg:grid-cols-12 lg:gap-6">
        <div class="lg:col-span-7" data-m="rise">
          <img
            src={logos.arnlea.src}
            alt=""
            width={logos.arnlea.w}
            height={logos.arnlea.h}
            loading="lazy"
            class="mb-8 h-8 w-auto max-w-[12rem] object-contain object-left grayscale transition-[filter] duration-300 hover:grayscale-0"
          />
          <Text size="sm" tone="secondary">Arnlea Systems — Aberdeen · Ex inspection software</Text>
          <Heading as="h3" size="lg" class="mt-4">3× the First-Page Rankings</Heading>
          <Text class="mt-6 max-w-xl">
            Arnlea Systems is an Aberdeen software company whose product, Nexar, runs Ex and ATEX inspections in hazardous areas. I rebuilt their whole website in Webflow with an SEO-first structure, then added three inspection guides written for the questions their buyers actually search. That took them from 96 to 275 first-page Google rankings in six months and from 33 to 146 top-three positions. Google's AI answer for Ex inspection software now names Nexar first.
          </Text>
          <div class="mt-8">
            <Button href="/work/arnlea" variant="dark" size="sm">Read the full case study</Button>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-8 lg:col-span-4 lg:col-start-9 lg:grid-cols-1">
          <div data-m="rise" class="border-t border-ink pt-6">
            <p class="font-heading text-8xl font-black leading-[0.85] tracking-[-0.05em] text-signal [font-stretch:115%]"><span data-count="3" data-suffix="×">3×</span></p>
            <Text size="sm" class="mt-4 uppercase">First-page rankings</Text>
          </div>
          <div data-m="rise" class="border-t border-ink pt-6">
            <p class="font-heading text-8xl font-black leading-[0.85] tracking-[-0.05em] text-signal [font-stretch:115%]"><span data-count="146">146</span></p>
            <Text size="sm" class="mt-4 uppercase">Top-three rankings</Text>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ═══ FAQ: two-column hairline list. Questions are not headings, as before. ═══ -->
  <section class="border-t border-ink bg-paper py-20 md:py-28">
    <Container data-group class="grid gap-12 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-4">
        <Text size="sm" tone="secondary" data-m="fade">Common questions</Text>
        <Heading size="lg" data-m="split" class="mt-6">SEO Aberdeen — FAQ</Heading>
      </div>
      <dl class="lg:col-span-7 lg:col-start-6">
        {faq.map(item => (
          <div data-m="rise" class="grid gap-3 border-t border-ink py-8 last:border-b md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] md:gap-8">
            <dt><Heading as="p" size="sm">{item.q}</Heading></dt>
            <dd><Text>{item.a}</Text></dd>
          </div>
        ))}
      </dl>
    </Container>
  </section>

  <!-- ═══ Related reading ═══ -->
  <section class="border-t border-ink bg-paper py-16 md:py-20">
    <Container data-group>
      <Text size="sm" tone="secondary" data-m="fade">From the journal</Text>
      <ul class="mt-6 border-b border-ink">
        {[
          { href: '/journal/seo-aberdeen-the-basics-that-still-win-in-2025', label: 'SEO Aberdeen: The Basics That Still Win in 2025' },
          { href: '/journal/seo-in-2025-what-works-whats-hype-what-fails', label: "SEO in 2025: What Works, What's Hype, What Fails" },
          { href: '/journal/is-your-content-ready-for-the-ai-search-revolution', label: 'Is Your Content Ready for AI Search?' },
        ].map(l => (
          <li data-m="rise" class="border-t border-ink">
            <a href={l.href} class="group flex items-center justify-between gap-6 py-5">
              <span class="decoration-signal decoration-2 underline-offset-4 group-hover:underline">{l.label}</span>
              <Icon name="arrow-right" stroke={1} class="size-8 shrink-0 transition-transform duration-300 group-hover:translate-x-2" />
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <!-- ═══ Other services ═══ -->
  <section class="border-t border-ink bg-paper py-16 md:py-20">
    <Container data-group>
      <Text size="sm" tone="secondary" data-m="fade">Also available</Text>
      <ul class="mt-6 flex flex-wrap gap-3">
        {otherServices.map(s => (
          <li data-m="rise"><Button href={`/services/${s.slug}`} variant="outline" size="sm">{s.title}</Button></li>
        ))}
      </ul>
    </Container>
  </section>

  <!-- ═══ CTA: full orange band, thin arrow ═══ -->
  <section class="bg-signal py-20 text-ink md:py-28">
    <Container data-group class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-6">
      <div class="lg:col-span-7">
        <Heading size="xl" tone="onAccent" data-m="split" class="max-w-[11ch]">Ready to Rank<br />in Aberdeen?</Heading>
        <span data-m="fade" class="mt-6 hidden lg:block"><Icon name="arrow-right" stroke={0.6} class="size-40" /></span>
      </div>
      <div class="lg:col-span-4 lg:col-start-9" data-m="fade">
        <Text size="lg" tone="onAccent" class="max-w-md">
          Book the free 30-minute review. I'll look at your current search presence, identify the biggest gaps, and tell you exactly what I'd prioritise.
        </Text>
        <div class="mt-8">
          <Button href="/contact" variant="dark" size="lg" arrow>Book the free review</Button>
        </div>
      </div>
    </Container>
  </section>
</Layout>
