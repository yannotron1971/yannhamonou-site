---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import Heading from '../../components/ui/Heading.astro';
import Text from '../../components/ui/Text.astro';
import Button from '../../components/ui/Button.astro';
import PageHero from '../../components/PageHero.astro';
import { getCases } from '../../lib/keystatic';

const cases = await getCases();
---

<Layout
  title="Work & Case Studies — Yann Hamonou"
  description="B2B marketing case studies: real results from Aberdeen and Scottish SMEs. SEO growth, positioning, and lead generation."
>
  <PageHero
    label="Portfolio"
    title="Selected work"
    lede="A handful of the projects that best represent the work. Numbers are real; context is everything."
  >
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="#cases" variant="dark">Case studies ↓</Button>
      <Button href="/work/web/" variant="outline" arrow>Web development work</Button>
    </div>
  </PageHero>

  <section id="cases" class="scroll-mt-20 bg-paper py-20 md:py-28">
    <Container data-group>
      <ul class="grid border-t border-ink md:grid-cols-2" role="list">
        {cases.map((c, i) => (
          <li
            data-m="rise"
            class:list={[
              'border-b border-ink py-10 md:py-12',
              i % 2 === 0 ? 'md:border-r md:pr-10' : 'md:pl-10',
            ]}
          >
            <a href={`/work/${c.slug}`} class="group flex h-full flex-col">
              {/* The plate: the photograph where the case has one with a
                  description, otherwise its headline figure set large. */}
              {c.image && c.imageAlt
                ? (
                  <div class="relative aspect-[3/2] overflow-hidden bg-stone">
                    <img
                      src={c.image}
                      alt={c.imageAlt}
                      loading="lazy"
                      decoding="async"
                      style={`object-position:${c.imageFocus};`}
                      class="absolute inset-0 h-full w-full object-cover grayscale transition-[filter] duration-500 group-hover:grayscale-0"
                    />
                  </div>
                )
                : (
                  <div class="flex aspect-[3/2] flex-col justify-end bg-stone p-6 md:p-8" aria-hidden="true">
                    <span class="font-heading text-6xl font-black leading-[0.85] tracking-[-0.05em] text-signal [font-stretch:115%]">{c.stat}</span>
                    <span class="t-eyebrow mt-4 max-w-[28ch] text-muted">{c.statSub}</span>
                  </div>
                )
              }

              <div class="mt-6 flex flex-1 flex-col">
                {/* The mark is the name where there is one; the client name
                    stays in the heading outline for screen readers. */}
                {c.logo
                  ? (
                    <>
                      <h2 class="sr-only">{c.client}</h2>
                      <img
                        src={c.logo.src}
                        alt=""
                        width={c.logo.w}
                        height={c.logo.h}
                        loading="lazy"
                        class:list={['mb-1 h-8 w-auto max-w-[14rem] self-start object-contain object-left grayscale', c.logo.lightInk && 'invert']}
                        style={c.logo.scale ? `height:${(2 * c.logo.scale).toFixed(2)}rem` : undefined}
                      />
                    </>
                  )
                  : <Heading as="h2" size="md">{c.client}</Heading>
                }
                <Text size="sm" tone="secondary" class="mt-3">{c.year} · {c.descriptor}</Text>
                <Text tone="secondary" class="mt-4 max-w-xl">{c.summary}</Text>
                <div class="mt-auto flex items-baseline justify-between gap-6 pt-8">
                  <Text size="sm" class="font-semibold"><b class="font-semibold">{c.stat}</b> {c.statSub}</Text>
                  <span class="text-link shrink-0 text-sm group-hover:[text-decoration-thickness:2px]">Case study</span>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  {/* Web work gets a band of its own, previews and all, so it reads as
      a second body of work rather than a footnote to the first. */}
  <section class="border-t border-ink bg-stone py-20 md:py-28">
    <Container data-group class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-6">
      <div class="lg:col-span-5">
        <Text size="sm" tone="secondary" data-m="fade">Web development</Text>
        <Heading size="lg" data-m="split" class="mt-4 max-w-[14ch]">Sites and landing pages, designed and built.</Heading>
        <Text tone="secondary" class="mt-6 max-w-md" data-m="fade">A client rebuild in Webflow, this site in Astro, and three concept landing pages in three different design systems.</Text>
        <div class="mt-8" data-m="fade">
          <Button href="/work/web/" variant="dark" arrow>See the web work</Button>
        </div>
      </div>
      <a href="/work/web/" class="group block lg:col-span-6 lg:col-start-7" aria-label="See the web work" data-m="frame">
        <div class="grid grid-cols-3 gap-3" aria-hidden="true">
          <img src="/work/web/arnlea.webp" alt="" width="1200" height="750" loading="lazy" decoding="async" class="aspect-[4/5] w-full border border-ink object-cover object-left-top grayscale transition-[filter] duration-500 group-hover:grayscale-0" />
          <img src="/work/web/keelson.webp" alt="" width="1200" height="750" loading="lazy" decoding="async" class="aspect-[4/5] w-full border border-ink object-cover object-left-top grayscale transition-[filter] duration-500 group-hover:grayscale-0" />
          <img src="/work/web/emberline.webp" alt="" width="1200" height="750" loading="lazy" decoding="async" class="aspect-[4/5] w-full border border-ink object-cover object-left-top grayscale transition-[filter] duration-500 group-hover:grayscale-0" />
        </div>
      </a>
    </Container>
  </section>

  <section class="border-t border-ink bg-signal py-20 text-ink md:py-28">
    <Container data-group class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-6">
      <div class="lg:col-span-7">
        <Heading size="xl" tone="onAccent" data-m="split" class="max-w-[11ch]">Your results could be here</Heading>
      </div>
      <div class="lg:col-span-5">
        <Text size="lg" tone="onAccent" class="max-w-md" data-m="fade">
          Book the free 30-minute review. No commitment — just an honest look at where your biggest marketing opportunity is.
        </Text>
        <div class="mt-8" data-m="fade">
          <Button href="/contact" variant="dark" size="lg" arrow>Book the free review</Button>
        </div>
      </div>
    </Container>
  </section>
</Layout>
