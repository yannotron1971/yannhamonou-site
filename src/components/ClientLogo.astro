---
/**
 * A client's mark, linked to their own site when we know it.
 *
 * Only for marks that are not already inside a link of their own — the work
 * rows on the homepage and the case-study cards already wrap theirs in a link
 * to the case study, and an anchor cannot contain another anchor.
 *
 * When it links, the accessible name lives on the anchor and the image goes
 * decorative: otherwise a screen reader announces the company twice, once for
 * the link and once for the image inside it. When it doesn't link, the alt
 * text carries the name — unless the surrounding markup already says it, which
 * is what `decorative` is for.
 *
 * A logo carrying `splitAt` is drawn twice, each copy clipped to one half of
 * the artwork, so a lockup whose mark and wordmark are different inks can
 * treat them differently. Only the visible half carries the alt text; the
 * overlay is hidden from assistive tech, or the company is announced twice.
 */
import type { Logo } from '../data/index';

interface Props {
  logo: Logo;
  name: string;
  class?: string;
  style?: string;
  /** The company is already named in adjacent text (a caption, an attribution). */
  decorative?: boolean;
  loading?: 'lazy' | 'eager';
}

const {
  logo,
  name,
  class: className = '',
  style,
  decorative = false,
  loading = 'lazy',
} = Astro.props;

const imgClass = [
  className,
  logo.darkInvert ? 'logo-dark-invert' : '',
  logo.lightInk ? 'logo-light-ink' : '',
  logo.colourOnDark ? 'logo-colour-on-dark' : '',
].filter(Boolean).join(' ');

/* Optical scale rides along with whatever the caller passed. */
const imgStyle = [style, logo.scale ? `--logo-scale:${logo.scale}` : ''].filter(Boolean).join(';');

/* When the mark links, the anchor carries the name and the artwork goes
   decorative; otherwise the alt text does the work. */
const alt = logo.site ? '' : decorative ? '' : name;

/* Fragment as a dynamic tag renders no element, so the unlinked case stays
   exactly the markup it was before the link existed. */
const Wrapper = logo.site ? 'a' : Fragment;
const wrapperProps = logo.site
  ? {
      href: logo.site,
      class: 'client-logo-link',
      target: '_blank',
      rel: 'noopener noreferrer',
      'aria-label': `${name} — visit website, opens in a new tab`,
    }
  : {};

const cut = logo.splitAt ? `${(logo.splitAt * 100).toFixed(4)}%` : '';
---

<Wrapper {...wrapperProps}>
  {logo.splitAt ? (
    <span class="logo-split" style={imgStyle}>
      {/* The wordmark stays in flow and sizes the wrapper. */}
      <img
        src={logo.src}
        alt={alt}
        width={logo.w}
        height={logo.h}
        class={`${imgClass} logo-split__word`}
        style={`--logo-cut:${cut}`}
        loading={loading}
      />
      <img
        src={logo.src}
        alt=""
        aria-hidden="true"
        width={logo.w}
        height={logo.h}
        class={`${imgClass} logo-split__mark`}
        style={`--logo-cut:${cut}`}
        loading={loading}
      />
    </span>
  ) : (
    <img
      src={logo.src}
      alt={alt}
      width={logo.w}
      height={logo.h}
      class={imgClass}
      style={imgStyle}
      loading={loading}
    />
  )}
</Wrapper>

<style is:global>
  /* Inline-flex so the anchor takes the mark's own box and changes no layout
     it is dropped into. The mark already sits at reduced opacity in most
     placements; the hover lifts it rather than dimming it further, so the
     affordance reads on both the light and the dark grounds. */
  .client-logo-link {
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s ease;
  }
  .client-logo-link:hover img,
  .client-logo-link:focus-visible img {
    opacity: 1;
  }

  /* Two copies of one file, clipped either side of --logo-cut. The wordmark
     half holds the box; the mark half is laid over it at the same size, so
     the two always agree however the placement sizes them. */
  .logo-split {
    position: relative;
    display: inline-block;
  }
  .logo-split__word {
    clip-path: inset(0 0 0 var(--logo-cut));
  }
  .logo-split__mark {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    clip-path: inset(0 calc(100% - var(--logo-cut)) 0 0);
  }
</style>
