---
const navLinks = [
  { label: 'About', href: '/about' },
  { label: 'Work', href: '/work' },
  { label: 'Journal', href: '/journal' },
];

const services = [
  { label: 'Positioning', href: '/services/positioning' },
  { label: 'Marketing Strategy', href: '/services/strategy' },
  { label: 'SEO & GEO', href: '/services/seo-aberdeen' },
  { label: 'Organic & Paid Media', href: '/services/media' },
  { label: 'Web & CRO', href: '/services/web' },
  { label: 'Marketing Leadership', href: '/services/leadership' },
];
---

<nav class="v4-nav" aria-label="Main navigation">
  <div class="v4-wrap v4-nav__inner">
    <!-- Brand -->
    <a href="/" class="v4-nav__brand" aria-label="Yann Hamonou — Home">
      <span class="v4-nav__brand-dot" aria-hidden="true"></span>
      Yann.Hamonou
    </a>

    <!-- The bar carries the wordmark and the toggle. Everything else lives
         in the index: repeating the same five destinations at 11px in the
         corner while they are set at 104px behind the toggle says it twice
         and makes the index decorative. -->

    <!-- Right cluster -->
    <div class="v4-nav__right">
      <!-- Hamburger -->
      <button class="v4-hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- The toggle needs JavaScript to open the index, so without it the bar
         would offer no way through the site at all. This is the same
         principle the CTA rule already stated: the page's next step does not
         get to depend on JS. -->
    <noscript>
      <ul class="v4-nav__nojs" role="list">
        <li><a href="/services">Services</a></li>
        {navLinks.map(link => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li><a href="/contact">Contact</a></li>
      </ul>
    </noscript>
  </div>
</nav>

<!-- Mobile drawer -->
<!-- Not aria-modal: the control that closes this is the bar's toggle, which
     sits outside it, and nothing traps focus here. Claiming modality would
     tell assistive tech to ignore the one button that gets you out. -->
<div class="v4-drawer" id="mobile-drawer" role="dialog" aria-label="Navigation">
  <button class="v4-drawer__close" id="drawer-close" aria-label="Close menu">✕</button>
  <!-- Five index lines, one level deep. Each carries its label twice: the
       second copy is the one that rolls up into place on hover, and it is
       hidden from assistive tech so the item is announced once. -->
  <ul class="v4-drawer__links" role="list">
    <li>
      <a href="/services">
        <span class="v4-roll__a">Services</span>
        <span class="v4-roll__b" aria-hidden="true">Services</span>
      </a>
    </li>
    {navLinks.map(link => (
      <li>
        <a href={link.href}>
          <span class="v4-roll__a">{link.label}</span>
          <span class="v4-roll__b" aria-hidden="true">{link.label}</span>
        </a>
      </li>
    ))}
    <li>
      <a href="/contact">
        <span class="v4-roll__a">Contact</span>
        <span class="v4-roll__b" aria-hidden="true">Contact</span>
      </a>
    </li>
  </ul>

  <!-- The six services, kept one click away in the mono voice rather than
       nested under the Services line: eleven rows at this scale do not fit a
       laptop viewport, and a sub-list breaks the index's single breath. -->
  <ul class="v4-drawer__rail" role="list" aria-label="Services">
    {services.map(s => (
      <li><a href={s.href}>{s.label}</a></li>
    ))}
  </ul>
</div>

<script>
  // Season/theme toggle removed on this concept — the Edge language has one
  // ground, so there is nothing to switch between.

  // Mobile drawer
  const hamburger = document.getElementById('hamburger');
  const drawer = document.getElementById('mobile-drawer');
  const drawerClose = document.getElementById('drawer-close');
  // The bar reacts to the drawer: it keeps the wordmark and the toggle, and
  // drops the links and the CTA that the index is already showing at scale.
  const nav = document.querySelector('.v4-nav');

  function openDrawer() {
    drawer?.classList.add('is-open');
    hamburger?.classList.add('is-open');
    hamburger?.setAttribute('aria-expanded', 'true');
    hamburger?.setAttribute('aria-label', 'Close menu');
    nav?.classList.add('is-drawer-open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.remove('is-open');
    hamburger?.classList.remove('is-open');
    hamburger?.setAttribute('aria-expanded', 'false');
    hamburger?.setAttribute('aria-label', 'Open menu');
    nav?.classList.remove('is-drawer-open');
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', () => {
    drawer?.classList.contains('is-open') ? closeDrawer() : openDrawer();
  });
  drawerClose?.addEventListener('click', closeDrawer);

  // Close on drawer link click
  drawer?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', closeDrawer);
  });

  // Close on Escape
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeDrawer();
  });

</script>

<style>
  /* The drawer's services rail is styled in global.css beside the index
     links it belongs to — .v4-drawer__sub is gone with the nesting. */
</style>
