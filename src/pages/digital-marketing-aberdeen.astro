---
import Layout from '../layouts/Layout.astro';
import Container from '../components/ui/Container.astro';
import Heading from '../components/ui/Heading.astro';
import Text from '../components/ui/Text.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { getCases, getServices, getSettings } from '../lib/keystatic';
import { homeClients, serviceImages, signalImages } from '../data/index';

const cases = await getCases();
const services = await getServices();

/* The page-specific FAQ below stays in this file — those questions are about
   Aberdeen and belong to this page. The testimonials are the site's, so they
   come from the one editable source. */
const { testimonials } = await getSettings();

/* Greyscale client marks for case rows and quotes: match on the company name
   against the homepage logo row, with Tenders Direct as the Proactis mark. */
const logoFor = (name: string) => {
  const n = name.toLowerCase();
  if (n.includes('proactis') || n.includes('tenders')) return signalImages.tendersDirect.src;
  return homeClients.find((c) => n.includes(c.name.toLowerCase()))?.logo;
};

const faq = [
  {
    q: 'What digital marketing services do you offer in Aberdeen?',
    a: 'The full range: marketing strategy, SEO and local search, paid media (Google Ads, LinkedIn, Meta), positioning and messaging, and website conversion optimisation. Most Aberdeen SME engagements combine two or three of these rather than treating them as separate projects — because the channels amplify each other when they share a strategy.',
  },
  {
    q: 'Do you work with businesses outside Aberdeen city centre?',
    a: 'Yes. Based in Stonehaven, I work with clients across Aberdeenshire — Westhill, Portlethen, Ellon, Inverurie, Banchory — as well as Aberdeen city, and remotely with clients across Scotland and the rest of the UK. Most of the work is delivered online; geography is not a barrier.',
  },
  {
    q: 'What industries do you work with in Aberdeen?',
    a: 'Predominantly B2B: energy sector and oil & gas supply chain, professional and financial services, industrial equipment and engineering, technology companies, and B2B SaaS. The common thread is businesses with a defined sales cycle and an identifiable buyer — not consumer brands.',
  },
  {
    q: 'How is working with a local digital marketing consultant different from an agency?',
    a: 'A local consultant brings one thing an agency cannot: accountability without overhead. You work with one person who understands the Aberdeen market, takes direct ownership of results, and has no incentive to sell you services you do not need. There is no account manager between you and the person doing the work.',
  },
  {
    q: 'How do I get started?',
    a: 'The free 30-minute strategy review is the right first step. No pitch, no agenda — I look at your current marketing situation, identify the biggest gap, and tell you exactly what I would prioritise. From there you decide whether to engage.',
  },
];

const aberdeenContext = [
  "Digital marketing in Aberdeen operates in a specific commercial environment. The city's economy is dominated by energy, professional services, and industrial supply — B2B markets where buying decisions are relationship-driven, sales cycles are long, and generic national campaigns rarely convert.",
  "The businesses that grow consistently here do not chase trends. They build marketing systems with clear positioning, a visible search presence for the terms their buyers actually use, and paid campaigns sized to their sales cycle — not a media agency's billing target.",
  'That is the kind of digital marketing I deliver: practical, accountable, and built around your specific situation rather than a template.',
];

const principles = [
  {
    title: 'Strategy before spend',
    body: 'Every engagement starts with a clear picture of your market position, your buyer, and where the real opportunity is. Digital marketing without a strategy is just spend.',
  },
  {
    title: 'Local SEO that actually ranks',
    body: 'Aberdeen search is competitive but winnable. Technical foundations, Google Business Profile optimisation, and content built for how your buyers search — not generic keyword lists.',
  },
  {
    title: 'Paid media without waste',
    body: 'Google Ads, LinkedIn, and Meta campaigns built around your sales cycle. Every campaign includes conversion tracking, audience segmentation, and a feedback loop that improves week on week.',
  },
  {
    title: 'Websites that convert',
    body: 'Conversion-focused builds with technical SEO embedded from the start. Every page built around a single goal, and measured against it.',
  },
];
---

<Layout
  title="Digital Marketing Aberdeen — B2B Marketing Consultant · Yann Hamonou"
  description="Digital marketing consultant based in Aberdeen and Stonehaven. Strategy, SEO, paid media, and web for Aberdeen and Scottish B2B SMEs. Free 30-min review."
>
  <PageHero
    label="B2B digital marketing · Aberdeen"
    title="Digital marketing<br />Aberdeen"
    lede="B2B digital marketing strategy and execution for Aberdeen and Scottish SMEs. SEO, paid media, positioning, and websites — all pointed at the same goal: qualified leads and sustainable growth."
    image={serviceImages.media}
  >
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="/contact/" size="lg" arrow>Book a free consultation</Button>
      <Button href="/services/" variant="outline" size="lg">See all services</Button>
    </div>
  </PageHero>

  <!-- ═══ ABERDEEN CONTEXT: prose left, service rows right ═══ -->
  <section class="bg-paper py-20 md:py-28">
    <Container class="grid gap-14 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-6">
        <Heading size="lg" class="max-w-[12ch]">Why Aberdeen is different</Heading>
        <div class="mt-8 space-y-4">
          {aberdeenContext.map((p) => <Text size="lg">{p}</Text>)}
        </div>
      </div>

      <div class="lg:col-span-5 lg:col-start-8">
        <Text size="sm" tone="secondary">Services for Aberdeen businesses</Text>
        <ul class="mt-4 border-b border-ink">
          {services.map((s) => (
            <li class="border-t border-ink">
              <a href={`/services/${s.slug}/`} class="group flex gap-5 py-6 transition-colors duration-200 hover:bg-stone">
                <span aria-hidden="true" class="font-heading text-2xl font-extrabold leading-none tracking-[-0.04em] [font-stretch:110%]">{s.num}</span>
                <div>
                  <Heading as="h3" size="sm" class="decoration-signal decoration-2 underline-offset-4 group-hover:underline">{s.title}</Heading>
                  <Text size="sm" tone="secondary" class="mt-2">{s.desc}</Text>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </section>

  <!-- ═══ HOW I WORK: four columns on hairlines ═══ -->
  <section class="border-t border-ink bg-paper py-20 md:py-28">
    <Container>
      <Text size="sm" tone="secondary">How I work</Text>
      <Heading size="lg" class="mt-4 max-w-[20ch]">Digital marketing that connects to revenue</Heading>
      <Text tone="secondary" class="mt-6 max-w-xl">
        Most Aberdeen SMEs have tried marketing that did not work — an agency campaign that generated clicks but no leads, an SEO retainer that produced reports but no rankings, a LinkedIn spend with nothing to show for it. The problem is almost never the channel. It is strategy, or positioning, or the wrong metrics.
      </Text>
      <ul class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0">
        {principles.map((item) => (
          <li class="border-t border-ink pt-6 lg:px-6 lg:first:pl-0 lg:last:pr-0 lg:[&:not(:first-child)]:border-l">
            <Heading as="h3" size="sm">{item.title}</Heading>
            <Text size="sm" class="mt-4">{item.body}</Text>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <!-- ═══ SEO ABERDEEN SPOTLIGHT: stone statement band ═══ -->
  <section class="border-t border-ink bg-stone py-20 md:py-28">
    <Container class="grid gap-12 lg:grid-cols-12 lg:items-end lg:gap-6">
      <div class="lg:col-span-7">
        <Text size="sm" tone="secondary">Most in-demand service</Text>
        <Heading size="xl" class="mt-4">SEO Aberdeen</Heading>
        <Text size="lg" class="mt-8 max-w-xl">
          The most common request from Aberdeen businesses: get found in Google for the terms your buyers actually search. I combine traditional <a href="/services/seo-aberdeen/" class="text-link">SEO Aberdeen</a> with Generative Engine Optimisation (GEO) — so you appear in both Google results and the AI answers that are increasingly replacing them.
        </Text>
        <div class="mt-10 flex flex-wrap gap-4">
          <Button href="/services/seo-aberdeen/" variant="dark">SEO Aberdeen service</Button>
          <Button href="/journal/seo-aberdeen-the-basics-that-still-win-in-2025/" variant="outline">Read the Aberdeen SEO guide</Button>
        </div>
      </div>
      <dl class="grid grid-cols-2 gap-6 lg:col-span-4 lg:col-start-9 lg:grid-cols-1 lg:gap-10">
        <div class="border-t border-ink pt-5">
          <dd class="font-heading text-7xl font-black leading-[0.9] tracking-[-0.05em] [font-stretch:115%]"><span data-count="3" data-suffix="×">3×</span></dd>
          <dt class="t-eyebrow mt-3">First-page<br />rankings</dt>
        </div>
        <div class="border-t border-ink pt-5">
          <dd class="font-heading text-7xl font-black leading-[0.9] tracking-[-0.05em] [font-stretch:115%]">20 → 2</dd>
          <dt class="t-eyebrow mt-3">UK Google<br />position</dt>
        </div>
      </dl>
    </Container>
  </section>

  <!-- ═══ RESULTS: case rows on hairlines ═══ -->
  <section class="border-t border-ink bg-paper py-20 md:py-28">
    <Container>
      <Text size="sm" tone="secondary">Aberdeen results</Text>
      <Heading size="lg" class="mt-4">What this delivers</Heading>
      <ul class="mt-12 border-b border-ink">
        {cases.map((c) => {
          const logo = logoFor(c.client);
          return (
            <li class="border-t border-ink">
              <a href={`/work/${c.slug}/`} class="group grid gap-6 py-8 transition-colors duration-200 hover:bg-stone md:grid-cols-12 md:items-center md:gap-6 md:py-10">
                <div class="md:col-span-8">
                  {logo && <img src={logo} alt="" loading="lazy" class="mb-5 h-auto max-h-9 w-auto max-w-[150px] object-contain grayscale" />}
                  <Text size="sm" tone="secondary">{c.year} · {c.descriptor}</Text>
                  <Heading as="h3" size="md" class="mt-2 decoration-signal decoration-2 underline-offset-4 group-hover:underline">{c.client}</Heading>
                  <Text tone="secondary" class="mt-3 max-w-xl">{c.summary}</Text>
                </div>
                <div class="md:col-span-4 md:text-right">
                  <p class="font-heading text-5xl font-black leading-[0.95] tracking-[-0.04em] [font-stretch:112%]">{c.stat}</p>
                  <p class="t-eyebrow mt-3">{c.statSub}</p>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </Container>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="border-t border-ink bg-paper py-20 md:py-28">
    <Container>
      <Text size="sm" tone="secondary">What clients say</Text>
      <ul class="mt-8 grid gap-12 md:grid-cols-2 md:gap-0 lg:grid-cols-3">
        {testimonials.map((t) => {
          const logo = logoFor(t.company);
          return (
            <li class="border-t border-ink pt-6 md:px-8 md:first:pl-0 md:[&:not(:first-child)]:border-l lg:[&:nth-child(3n+1)]:pl-0">
              <figure class="flex h-full flex-col">
                {logo && <img src={logo} alt="" loading="lazy" class="mb-6 h-auto max-h-9 w-auto max-w-[150px] object-contain grayscale" />}
                <blockquote><Text>"{t.quote}"</Text></blockquote>
                <figcaption class="mt-6">
                  <Text class="font-semibold">{t.name}</Text>
                  <Text size="sm" tone="secondary">{t.role} · {t.company}{t.location ? ` · ${t.location}` : ''}</Text>
                </figcaption>
              </figure>
            </li>
          );
        })}
      </ul>
    </Container>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="border-t border-ink bg-paper py-20 md:py-28">
    <Container class="grid gap-12 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-4">
        <Text size="sm" tone="secondary">Common questions</Text>
        <Heading size="lg" class="mt-4">Digital marketing Aberdeen — FAQ</Heading>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        {faq.map((item) => (
          <details class="group border-t border-ink last:border-b">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 marker:hidden [&::-webkit-details-marker]:hidden">
              <Heading as="h3" size="sm">{item.q}</Heading>
              <Icon name="plus" stroke={1.5} class="mt-0.5 size-6 shrink-0 transition-transform duration-200 group-open:rotate-45" />
            </summary>
            <Text class="max-w-xl pb-8">{item.a}</Text>
          </details>
        ))}
      </div>
    </Container>
  </section>

  <!-- ═══ CLOSING: full orange band ═══ -->
  <section class="bg-signal py-20 text-ink md:py-28">
    <Container class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-6">
      <div class="lg:col-span-7">
        <Heading size="xl" tone="onAccent" class="max-w-[12ch]">Ready to make your marketing work?</Heading>
        <Text size="lg" tone="onAccent" class="mt-8 max-w-md">
          Book a free 30-minute strategy review. I'll look at your current marketing situation, identify the biggest gap, and tell you exactly what I'd prioritise — with no pitch and no obligation.
        </Text>
        <div class="mt-10">
          <Button href="/contact/" variant="dark" size="lg" arrow>Book a free consultation</Button>
        </div>
      </div>
      <span class="hidden lg:col-span-4 lg:col-start-9 lg:block"><Icon name="arrow-right" stroke={0.6} class="size-48" /></span>
    </Container>
  </section>
</Layout>
