---
import Layout from '../layouts/Layout.astro';
import { cases, numbers, testimonials } from '../data/index';

const seasons = [
  {
    idx: '01',
    season: 'Spring',
    name: 'Planting',
    line: 'Set the roots.',
    desc: 'Every enduring brand starts below ground. Strategy and positioning give every pound you spend a direction — before a single ad runs.',
    services: [
      { label: 'Marketing Strategy', href: '/services/strategy' },
      { label: 'Positioning', href: '/services/positioning' },
    ],
    accent: '#4a6b4c',
    tint: 'rgba(74, 107, 76, 0.09)',
    glyph: 'sprout',
  },
  {
    idx: '02',
    season: 'Summer',
    name: 'Cultivating',
    line: 'Grow what compounds.',
    desc: 'Organic visibility and a site that converts — the patient work that compounds season after season, in search and in AI answers.',
    services: [
      { label: 'SEO & GEO', href: '/services/seo-aberdeen' },
      { label: 'Web & CRO', href: '/services/web' },
    ],
    accent: '#2e4a36',
    tint: 'rgba(46, 74, 54, 0.09)',
    glyph: 'leaf',
  },
  {
    idx: '03',
    season: 'Autumn',
    name: 'Harvesting',
    line: 'Take the yield.',
    desc: 'When the field is ready, paid media brings the harvest in: qualified leads from Google, LinkedIn, and Meta — tracked to revenue, not clicks.',
    services: [
      { label: 'Paid Media', href: '/services/paid' },
    ],
    accent: '#b85c2e',
    tint: 'rgba(184, 92, 46, 0.09)',
    glyph: 'acorn',
  },
  {
    idx: '04',
    season: 'Winter',
    name: 'Weathering',
    line: 'Endure the storms.',
    desc: 'Automation keeps the pipeline warm through the quiet months — nurture sequences and lead scoring so no enquiry falls through the cracks.',
    services: [
      { label: 'Marketing Automation', href: '/services/automation' },
    ],
    accent: '#7d6584',
    tint: 'rgba(125, 101, 132, 0.10)',
    glyph: 'wind',
  },
];

const numerals = ['I', 'II', 'III', 'IV'];
const etchQuote = testimonials[0];
---

<Layout
  title="Marketing Consultant Aberdeen — Yann Hamonou"
  description="B2B marketing consultant and digital marketing specialist based in Stonehaven, Scotland. Strategy, SEO, paid media, and automation that generate qualified leads for Scottish SMEs. Free 30-min review."
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&display=swap"
  />

  <div class="oak">
    <!-- ═══ HERO — THE SPARK ═══ -->
    <section class="oak-hero">
      <div class="oak-wrap oak-hero__grid">
        <div class="oak-hero__copy">
          <p class="oak-hero__eyebrow">Yann Hamonou · B2B Marketing · Stonehaven, Scotland</p>
          <h1 class="oak-hero__title">
            <span class="oak-line">Deep Roots.</span>
            <span class="oak-line oak-line--accent">Bold Growth.</span>
          </h1>
          <p class="oak-hero__sub">
            Marketing from the edge of the North Sea. Strategy, SEO, and paid media
            that turn Scottish B2B businesses into enduring brands — not vanity metrics.
          </p>
          <div class="oak-hero__ctas">
            <a href="/contact" class="oak-btn oak-btn--primary">Start the Season →</a>
            <a href="#ledger" class="oak-btn oak-btn--ghost">Read the Ledger</a>
          </div>
          <p class="oak-hero__foot">20+ years B2B · #1 Google rank in 4 weeks · 500% organic growth</p>
        </div>

        <!-- The Sapling — hand-inked branch that blooms on scroll -->
        <div class="oak-hero__art" aria-hidden="true">
          <svg viewBox="0 0 900 640" fill="none" xmlns="http://www.w3.org/2000/svg" class="oak-sapling">
            <defs>
              <filter id="oak-rough" x="-5%" y="-5%" width="110%" height="110%">
                <feTurbulence type="fractalNoise" baseFrequency="0.022 0.045" numOctaves="2" seed="7" result="n" />
                <feDisplacementMap in="SourceGraphic" in2="n" scale="4" />
              </filter>
              <path
                id="oak-leaf-shape"
                d="M0 0 C-1 -3 -2 -5 -2 -8 C-6 -9 -9 -13 -6 -16 C-12 -17 -13 -23 -8 -25 C-14 -28 -13 -35 -7 -35 C-10 -41 -4 -46 0 -42 C4 -46 10 -41 7 -35 C13 -35 14 -28 8 -25 C13 -23 12 -17 6 -16 C9 -13 6 -9 2 -8 C2 -5 1 -3 0 0 Z"
                stroke="#26302c"
                stroke-opacity="0.35"
                stroke-width="1"
              />
              <g id="oak-acorn-shape">
                <line x1="0" y1="0" x2="0" y2="5" stroke="#54401f" stroke-width="1.6" />
                <ellipse cx="0" cy="13" rx="5.2" ry="8" fill="#9a6b30" />
                <path d="M-6.5 8.5 Q0 3.5 6.5 8.5 L6 11.5 Q0 8.5 -6 11.5 Z" fill="#5d431f" />
              </g>
            </defs>

            <g filter="url(#oak-rough)">
              <!-- Bare branch — inked in on load -->
              <g class="oak-branch" stroke="#2b2f2a" stroke-linecap="round" fill="none">
                <path stroke-width="9" d="M-10 600 C90 560 150 555 235 505 C320 455 355 400 445 360 C520 327 585 322 650 285" />
                <path stroke-width="5.5" d="M650 285 C700 258 730 245 790 232 C830 223 855 210 880 190" />
                <path stroke-width="4" d="M235 505 C255 470 250 440 275 415 C292 391 315 380 330 372" />
                <path stroke-width="3" d="M330 372 C345 355 365 350 380 338" />
                <path stroke-width="4" d="M445 360 C455 320 480 300 470 265 C464 240 470 220 485 205" />
                <path stroke-width="2.5" d="M485 205 C495 190 512 182 528 180" />
                <path stroke-width="3.5" d="M592 318 C620 340 660 350 700 345 C730 342 748 350 765 365" />
                <path stroke-width="2.5" d="M790 232 C800 210 818 198 838 195" />
              </g>

              <!-- Leaves — sprout on scroll -->
              <g class="oak-leaves">
                <g class="oak-leaf" transform="translate(326 368) rotate(-15) scale(1.1)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(338 378) rotate(40) scale(0.9)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(378 334) rotate(-30)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
                <g class="oak-leaf" transform="translate(390 344) rotate(25) scale(0.85)"><use href="#oak-leaf-shape" fill="#3a5c40" /></g>
                <g class="oak-leaf" transform="translate(282 410) rotate(-60) scale(0.8)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(468 260) rotate(-20) scale(1.05)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(482 200) rotate(-45) scale(1.1)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(494 212) rotate(15) scale(0.9)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
                <g class="oak-leaf" transform="translate(525 176) rotate(-10)"><use href="#oak-leaf-shape" fill="#3a5c40" /></g>
                <g class="oak-leaf" transform="translate(536 186) rotate(45) scale(0.8)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(556 314) rotate(20) scale(0.75)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
                <g class="oak-leaf" transform="translate(648 280) rotate(-35) scale(0.9)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(698 340) rotate(150) scale(0.95)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(762 362) rotate(140) scale(1.05)"><use href="#oak-leaf-shape" fill="#3a5c40" /></g>
                <g class="oak-leaf" transform="translate(776 370) rotate(185) scale(0.8)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
                <g class="oak-leaf" transform="translate(836 190) rotate(-25)"><use href="#oak-leaf-shape" fill="#47714b" /></g>
                <g class="oak-leaf" transform="translate(876 186) rotate(-5) scale(1.15)"><use href="#oak-leaf-shape" fill="#2e4a36" /></g>
                <g class="oak-leaf" transform="translate(886 198) rotate(35) scale(0.85)"><use href="#oak-leaf-shape" fill="#63875c" /></g>
              </g>

              <!-- Acorns -->
              <g class="oak-acorns">
                <use href="#oak-acorn-shape" class="oak-acorn-i" transform="translate(352 380) rotate(8)" />
                <use href="#oak-acorn-shape" class="oak-acorn-i" transform="translate(505 213) rotate(-6)" />
                <use href="#oak-acorn-shape" class="oak-acorn-i" transform="translate(740 358) rotate(10)" />
                <use href="#oak-acorn-shape" class="oak-acorn-i" transform="translate(858 200) rotate(-4)" />
              </g>
            </g>
          </svg>
        </div>
      </div>
      <p class="oak-hero__hint" aria-hidden="true">Scroll — watch it grow ↓</p>
    </section>

    <!-- ═══ THE BEDROCK — PHILOSOPHY ═══ -->
    <section class="oak-bedrock">
      <!-- Parallax cliff strata (Dunnottar silhouette in the near layer) -->
      <div class="oak-bedrock__cliffs" aria-hidden="true">
        <svg class="oak-cliff" data-speed="-6" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
          <path d="M0 340 L120 300 L260 330 L400 270 L560 310 L720 250 L880 300 L1040 260 L1200 310 L1320 280 L1440 320 V600 H0 Z" fill="#93a0a8" opacity="0.32" />
        </svg>
        <svg class="oak-cliff" data-speed="-12" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
          <path d="M0 420 L160 370 L300 400 L470 330 L620 380 L800 320 L940 370 L1100 330 L1250 380 L1440 340 V600 H0 Z" fill="#667380" opacity="0.45" />
        </svg>
        <svg class="oak-cliff" data-speed="-20" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMax slice">
          <path d="M0 520 L180 470 L340 500 L520 430 L560 430 L560 405 L590 405 L590 430 L640 430 L760 470 L920 420 L960 420 L960 395 L985 395 L985 420 L1030 420 L1180 470 L1440 430 V600 H0 Z" fill="#39434b" opacity="0.75" />
        </svg>
      </div>

      <div class="oak-wrap oak-bedrock__inner">
        <div class="oak-panel" data-mist>
          <p class="oak-eyebrow">The Bedrock</p>
          <h2 class="oak-h2" data-etch>Built on stone,<br />not sand.</h2>
          <p class="oak-lead">
            Stonehaven has weathered every storm the North Sea could send for a
            thousand years. That's how I build marketing: <strong>strategy first,
            then execution</strong> — positioning, SEO, paid media, and automation,
            all bearing on the same foundation. Most marketing problems aren't
            channel problems; they're strategy problems. Fix the upstream problem
            and everything downstream stands firm.
          </p>
          <div class="oak-stats">
            {numbers.map((n) => (
              <div class="oak-stat">
                <span class="oak-stat__num">{n.num}</span>
                <span class="oak-stat__label">{n.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ THE FOUR SEASONS — SERVICES ═══ -->
    <section class="oak-seasons">
      <div class="oak-wrap">
        <div data-mist>
          <p class="oak-eyebrow">The Four Seasons</p>
          <h2 class="oak-h2" data-etch>A season for every<br />stage of growth.</h2>
        </div>
        <div class="oak-seasons__grid">
          {seasons.map((s) => (
            <article class="oak-season" style={`--season-accent:${s.accent};--season-tint:${s.tint}`} data-mist>
              <div class="oak-season__top">
                <span class="oak-season__idx">{s.idx} · {s.season}</span>
                <span class="oak-season__glyph" aria-hidden="true">
                  {s.glyph === 'sprout' && (
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M14 25 V14" /><path d="M14 14 C14 8 8 5.5 4.5 7.5 C5.5 12 10 14 14 14 Z" /><path d="M14 14 C14 9 19.5 5.5 23.5 7.5 C22.5 12 18 14 14 14 Z" /></svg>
                  )}
                  {s.glyph === 'leaf' && (
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M14 25 C13 18 13 12 14 4" /><path d="M14 4 C9 6 6 9 6.5 14 C7 18.5 10 21.5 14 22 C18 21.5 21 18.5 21.5 14 C22 9 19 6 14 4 Z" /></svg>
                  )}
                  {s.glyph === 'acorn' && (
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M14 3 V6" /><path d="M7 11 Q14 5.5 21 11 L20.5 13.5 Q14 10.5 7.5 13.5 Z" /><path d="M9 13 C9 19 11 23 14 25 C17 23 19 19 19 13" /></svg>
                  )}
                  {s.glyph === 'wind' && (
                    <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 23 C10 19 15 19 24 12" /><path d="M13 17.5 C14 14 17 12.5 21 12.5" /><path d="M4 8 H13" /><path d="M6 12 H11" /></svg>
                  )}
                </span>
              </div>
              <h3 class="oak-season__name">{s.name}</h3>
              <p class="oak-season__line">{s.line}</p>
              <p class="oak-season__desc">{s.desc}</p>
              <ul class="oak-season__services" role="list">
                {s.services.map((sv) => (
                  <li><a href={sv.href}>{sv.label} <span aria-hidden="true">→</span></a></li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ THE HIGHLAND LEDGER — CASE STUDIES ═══ -->
    <section class="oak-ledger" id="ledger">
      <div class="oak-ledger__head oak-wrap" data-mist>
        <p class="oak-eyebrow">The Highland Ledger</p>
        <h2 class="oak-h2" data-etch>Local successes,<br />carved in results.</h2>
      </div>
      <div class="oak-ledger__track">
        {cases.map((c, i) => (
          <a href={`/work/${c.slug}`} class="oak-entry">
            <span class="oak-entry__numeral" aria-hidden="true">{numerals[i]}</span>
            {c.image && <img src={c.image} alt="" class="oak-entry__img" loading="lazy" />}
            <div class="oak-entry__body">
              <p class="oak-entry__meta">{c.year} · {c.descriptor}</p>
              <h3 class="oak-entry__client">{c.client}</h3>
              <p class="oak-entry__stat">{c.stat}</p>
              <p class="oak-entry__sub">{c.statSub}</p>
              <p class="oak-entry__summary">{c.summary}</p>
              <span class="oak-entry__link">Read the entry →</span>
            </div>
          </a>
        ))}
        <div class="oak-entry oak-entry--cta">
          <div class="oak-entry__body">
            <p class="oak-entry__meta">Your chapter</p>
            <h3 class="oak-entry__client">Unwritten.</h3>
            <p class="oak-entry__summary">The next entry in the ledger could carry your company's name.</p>
            <a href="/contact" class="oak-btn oak-btn--primary">Start the Season →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ ETCHED QUOTE ═══ -->
    <section class="oak-etchquote">
      <div class="oak-wrap" data-mist>
        <blockquote class="oak-quote" data-etch>
          “{etchQuote.quote}”
        </blockquote>
        <p class="oak-quote__attr">— {etchQuote.name}, {etchQuote.role}, {etchQuote.company}</p>
      </div>
    </section>

    <!-- ═══ THE SHELTER — FOOTER MOMENT ═══ -->
    <section class="oak-shelter">
      <!-- The Ancient Oak on the cliffside -->
      <svg class="oak-shelter__art" viewBox="0 0 1440 780" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <defs>
          <linearGradient id="oak-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#c6d0d2" />
            <stop offset="0.7" stop-color="#e6e4d8" />
            <stop offset="1" stop-color="#f2eee4" />
          </linearGradient>
          <linearGradient id="oak-mist-g" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f2eee4" stop-opacity="0" />
            <stop offset="0.5" stop-color="#f2eee4" stop-opacity="0.9" />
            <stop offset="1" stop-color="#f2eee4" stop-opacity="0" />
          </linearGradient>
          <filter id="oak-water" x="-15%" y="-15%" width="130%" height="130%">
            <feTurbulence type="fractalNoise" baseFrequency="0.012" numOctaves="3" seed="11" result="n" />
            <feDisplacementMap in="SourceGraphic" in2="n" scale="26" />
          </filter>
        </defs>

        <rect width="1440" height="780" fill="url(#oak-sky)" />

        <!-- North Sea -->
        <rect x="0" y="600" width="1440" height="90" fill="#6f8189" opacity="0.4" />
        <line x1="0" y1="600" x2="1440" y2="600" stroke="#5c6d75" stroke-width="1.5" opacity="0.45" />

        <!-- Far headland -->
        <path d="M0 600 L0 556 L140 540 L300 566 L430 552 L520 600 Z" fill="#8b979c" opacity="0.45" />

        <!-- Birds -->
        <path d="M680 250 q 7 -7 14 0 q 7 -7 14 0" stroke="#3a444b" stroke-width="1.6" fill="none" opacity="0.45" />
        <path d="M755 292 q 5 -5 10 0 q 5 -5 10 0" stroke="#3a444b" stroke-width="1.4" fill="none" opacity="0.35" />

        <!-- The cliff — a headland shelf, not a wall -->
        <path d="M790 780 L800 640 L830 545 L900 505 L1000 490 L1150 495 L1300 480 L1440 490 L1440 780 Z" fill="#3a444b" />
        <path d="M850 600 C910 588 970 592 1030 584 M900 668 C980 650 1070 658 1160 644" stroke="#26302c" stroke-width="2" fill="none" opacity="0.22" />

        <!-- Trunk and limbs (limbs end inside the canopy) -->
        <path d="M1025 494 C1032 486 1036 476 1038 460 C1040 438 1036 414 1044 392 C1050 374 1046 356 1054 340 L1064 340 C1072 358 1068 376 1074 394 C1082 418 1078 442 1080 462 C1082 478 1086 486 1094 494 Z" fill="#2f2a25" />
        <g stroke="#2f2a25" fill="none" stroke-linecap="round">
          <path stroke-width="9" d="M1056 348 C1032 324 1004 314 976 310" />
          <path stroke-width="9" d="M1062 344 C1074 314 1094 300 1122 292" />
          <path stroke-width="7" d="M1058 346 C1044 314 1048 296 1040 278" />
          <path stroke-width="6" d="M1060 342 C1068 318 1064 298 1074 278" />
        </g>

        <!-- The canopy — watercolor mass, emerges from the mist -->
        <g class="oak-tree__canopy" filter="url(#oak-water)">
          <ellipse cx="1058" cy="268" rx="185" ry="92" fill="#2e4a36" opacity="0.96" />
          <ellipse cx="940" cy="290" rx="118" ry="72" fill="#3d5c42" opacity="0.95" />
          <ellipse cx="1170" cy="286" rx="124" ry="76" fill="#35513b" opacity="0.95" />
          <ellipse cx="1052" cy="230" rx="148" ry="82" fill="#47714b" opacity="0.94" />
          <ellipse cx="968" cy="222" rx="94" ry="62" fill="#547a52" opacity="0.92" />
          <ellipse cx="1140" cy="220" rx="98" ry="64" fill="#3d5c42" opacity="0.92" />
          <ellipse cx="1054" cy="186" rx="104" ry="56" fill="#5d8358" opacity="0.9" />
          <ellipse cx="898" cy="264" rx="72" ry="50" fill="#35513b" opacity="0.93" />
          <ellipse cx="1216" cy="258" rx="78" ry="52" fill="#47714b" opacity="0.93" />
        </g>

        <!-- Mist that clears on scroll -->
        <rect class="oak-tree__mist" x="0" y="240" width="1440" height="330" fill="url(#oak-mist-g)" opacity="0.55" />
      </svg>

      <div class="oak-wrap oak-shelter__content">
        <p class="oak-eyebrow">The Shelter</p>
        <h2 class="oak-h2 oak-shelter__h" data-etch>Build your legacy.</h2>
        <p class="oak-lead oak-shelter__lead">
          Come sit in the shade of success. Book a free 30-minute strategy review —
          I'll look at what you're doing, what's working, and what's holding you
          back. No pitch, no agenda. Just a useful conversation.
        </p>
        <a href="/contact" class="oak-btn oak-btn--primary oak-btn--big">Start the Season →</a>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '../scripts/oak-motion.js';
</script>

<!-- Re-tune the shared nav + footer to the Oak & Coast palette (this page only) -->
<style is:global>
  body.v4,
  body.v4.is-light,
  body.v4.is-light.tone-warm,
  body.v4.is-light.tone-cool,
  body.v4.is-light.tone-bright {
    --v4-bg: #f2eee4;
    --v4-bg-2: #eae4d6;
    --v4-panel: #faf7ee;
    --v4-panel-2: #efe9db;
    --v4-panel-3: #e8e1d0;
    --v4-line: rgba(38, 48, 44, 0.16);
    --v4-line-soft: rgba(38, 48, 44, 0.1);
    --v4-ink: #26302c;
    --v4-ink-mute: #4c5852;
    --v4-ink-dim: #6b7570;
    --v4-accent: #2e4a36;
    --v4-accent-warm: #b85c2e;
    background: #f2eee4;
  }

  /* The nav's dark glass background is hardcoded in global.css — re-skin it
     to parchment on this page. */
  .v4-nav {
    background: rgba(242, 238, 228, 0.85) !important;
    border-bottom: 1px solid rgba(38, 48, 44, 0.12) !important;
  }
</style>

<style>
  /* ─── Oak & Coast tokens + parchment ground ─────────────────── */
  .oak {
    --oak-parchment: #f2eee4;
    --oak-parchment-2: #eae4d6;
    --oak-card: #faf7ee;
    --oak-ink: #26302c;
    --oak-slate: #46525a;
    --oak-mute: #4c5852;
    --oak-dim: #6b7570;
    --oak-green: #2e4a36;
    --oak-green-2: #47714b;
    --oak-orange: #b85c2e;
    --oak-heather: #7d6584;
    --oak-line: rgba(38, 48, 44, 0.14);
    --oak-serif: 'Fraunces', Georgia, 'Times New Roman', serif;
    --oak-mono: var(--v4-mono, 'Geist Mono', monospace);

    background-color: var(--oak-parchment);
    /* Weathered-parchment grain */
