---
/**
 * A client's mark, linked to their own site when we know it.
 *
 * Only for marks that are not already inside a link of their own — the work
 * rows on the homepage and the case-study cards already wrap theirs in a link
 * to the case study, and an anchor cannot contain another anchor.
 *
 * When it links, the accessible name lives on the anchor and the image goes
 * decorative: otherwise a screen reader announces the company twice, once for
 * the link and once for the image inside it. When it doesn't link, the alt
 * text carries the name — unless the surrounding markup already says it, which
 * is what `decorative` is for.
 */
import type { Logo } from '../data/index';

interface Props {
  logo: Logo;
  name: string;
  class?: string;
  style?: string;
  /** The company is already named in adjacent text (a caption, an attribution). */
  decorative?: boolean;
  loading?: 'lazy' | 'eager';
}

const {
  logo,
  name,
  class: className = '',
  style,
  decorative = false,
  loading = 'lazy',
} = Astro.props;

const imgClass = [
  className,
  logo.darkInvert ? 'logo-dark-invert' : '',
  logo.lightInk ? 'logo-light-ink' : '',
].filter(Boolean).join(' ');
---

{logo.site ? (
  <a
    href={logo.site}
    class="client-logo-link"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${name} — visit website, opens in a new tab`}
  >
    <img
      src={logo.src}
      alt=""
      width={logo.w}
      height={logo.h}
      class={imgClass}
      style={style}
      loading={loading}
    />
  </a>
) : (
  <img
    src={logo.src}
    alt={decorative ? '' : name}
    width={logo.w}
    height={logo.h}
    class={imgClass}
    style={style}
    loading={loading}
  />
)}

<style is:global>
  /* Inline-flex so the anchor takes the mark's own box and changes no layout
     it is dropped into. The mark already sits at reduced opacity in most
     placements; the hover lifts it rather than dimming it further, so the
     affordance reads on both the light and the dark grounds. */
  .client-logo-link {
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s ease;
  }
  .client-logo-link:hover img,
  .client-logo-link:focus-visible img {
    opacity: 1;
  }
</style>
