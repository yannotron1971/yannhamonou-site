---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { ENTITY_DESCRIPTION, BUSINESS_DESCRIPTION, KNOWS_ABOUT } from '../lib/entity';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  /** Image for the Article schema only (post covers are webp, which some
      social previews ignore, so og:image keeps the PNG default). */
  schemaImage?: string;
  canonical?: string;
  noindex?: boolean;
  /** Use the title exactly as given, without " — Yann Hamonou". For pages
      whose ranking title was tuned on the live site and must not grow. */
  exactTitle?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  breadcrumbs?: { name: string; item: string }[];
  /** Retired with the Edge design. Still accepted so no page breaks on it. */
  field?: boolean;
}

const {
  title: rawTitle,
  exactTitle = false,
  description = 'B2B marketing consultant based in Stonehaven, Scotland. Strategy, SEO, paid media, positioning, and web for Scottish SMEs.',
  ogType = 'website',
  ogImage,
  schemaImage,
  canonical: canonicalOverride,
  noindex = false,
  publishedTime,
  modifiedTime,
  author = 'Yann Hamonou',
  tags = [],
  breadcrumbs,
} = Astro.props;

const brand = 'Yann Hamonou';
const title = rawTitle
  ? exactTitle || rawTitle.includes(brand) ? rawTitle : `${rawTitle} — ${brand}`
  : `${brand} — B2B Marketing Consultant, Aberdeen`;

const canonical = canonicalOverride ?? new URL(Astro.url.pathname, Astro.site).href;
/* Schema @ids follow `site` in astro.config.mjs, so they move to the live
   domain at cutover with the canonicals instead of pointing at the preview. */
const siteOrigin = new URL('/', Astro.site).origin;
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).href
  : new URL('/og-default.png', Astro.site).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf7" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={brand} />
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author && ogType === 'article' && <meta property="article:author" content={author} />}
    {tags.map(t => <meta property="article:tag" content={t} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Plain-text summary for AI agents, generated from the same Keystatic
         content as these pages (src/lib/llms.ts). Agents mostly find it by
         following a link like this rather than guessing the URL. -->
    <link rel="alternate" type="text/markdown" title="Site summary for AI agents" href="/llms.txt" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Archivo carries its width axis (62–125) so headings can set
         font-stretch: 110%; JetBrains Mono is the body, button and label face. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Search Console ownership token, carried over from the Webflow site so
         the https://www.yannhamonou.com/ property stays verified after cutover. -->
    <meta name="google-site-verification" content="UZ6u5-sAivzTPnVsVz0f7tgkXhoSfdprPor9i4-MiP0" />

    <!-- ── GA4 ──
         Same measurement ID the Webflow site uses, so the migration reads as
         one continuous property rather than a new site starting from zero.

         Production only: `astro dev` and `astro preview` would otherwise post
         every local page view into the same property you are trying to compare
         before and after cutover.

         Consent: the tag sets cookies, so it loads only after the visitor
         accepts in CookieBanner.astro (choice kept in localStorage under
         `yh-consent`). Returning visitors who accepted load it here at once. -->
    <script is:inline define:vars={{ gaOn: import.meta.env.PROD }}>
      (function () {
        var ID = 'G-NEGE3F0RZC';
        var KEY = 'yh-consent';
        // Owner opt-out: ?notrack turns GA4 off in this browser for good,
        // ?track turns it back on. Survives IP changes, unlike a GA4 IP filter.
        var OFF = 'yh-notrack';
        var off = false;
        try {
          var q = new URLSearchParams(location.search);
          if (q.has('notrack')) { localStorage.setItem(OFF, '1'); alert('Analytics is now off in this browser. Visit with ?track to turn it back on.'); }
          if (q.has('track')) { localStorage.removeItem(OFF); alert('Analytics is back on in this browser.'); }
          off = localStorage.getItem(OFF) === '1';
        } catch (e) {}
        function load() {
          if (!gaOn || off || window.__yhGA) return;
          window.__yhGA = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ID;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', ID);
        }
        window.yhConsent = { key: KEY, load: load, off: off };
        try { if (localStorage.getItem(KEY) === 'granted') load(); } catch (e) {}
      })();
    </script>

    <!-- JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteOrigin}/#website`,
          "url": siteOrigin,
          "name": brand,
        },
        {
          "@type": "Person",
          "@id": `${siteOrigin}/#person`,
          "name": brand,
          "jobTitle": "B2B Marketing Consultant",
          "description": ENTITY_DESCRIPTION,
          "knowsAbout": KNOWS_ABOUT,
          "url": siteOrigin,
          "image": `${siteOrigin}/images/signal/portrait-yann.webp`,
          "sameAs": [
            "https://www.linkedin.com/in/yannhamonou",
          ],
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "34 Bernham Avenue",
            "addressLocality": "Stonehaven",
            "addressRegion": "Aberdeenshire",
            "postalCode": "AB39 2WD",
            "addressCountry": "GB",
          },
        },
        {
          "@type": ["ProfessionalService", "LocalBusiness"],
          "@id": `${siteOrigin}/#business`,
          "name": "Yann Hamonou — B2B Marketing Consultant Aberdeen",
          "description": BUSINESS_DESCRIPTION,
          "knowsAbout": KNOWS_ABOUT,
          "url": siteOrigin,
          "image": `${siteOrigin}/og-default.png`,
          "logo": `${siteOrigin}/icon-512.png`,
          "telephone": "+447853455816",
          "email": "yanndaman@googlemail.com",
          "founder": { "@id": `${siteOrigin}/#person` },
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "34 Bernham Avenue",
            "addressLocality": "Stonehaven",
            "addressRegion": "Aberdeenshire",
            "postalCode": "AB39 2WD",
            "addressCountry": "GB",
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 56.9643,
            "longitude": -2.2122,
          },
          "areaServed": [
            { "@type": "City", "name": "Aberdeen" },
            { "@type": "AdministrativeArea", "name": "Aberdeenshire" },
            { "@type": "AdministrativeArea", "name": "Scotland" },
          ],
          "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
            "opens": "09:00",
            "closes": "18:00",
          },
          // The Google Business Profile, so Google can tie this site to the
          // listing behind the Aberdeen map pack (public again since 13 Nov 2026).
          "hasMap": "https://www.google.com/maps?cid=3592033344975060462",
          "sameAs": [
            "https://www.linkedin.com/in/yannhamonou",
            "https://www.google.com/maps?cid=3592033344975060462",
          ],
          "priceRange": "££",
        },
        ...(ogType === 'article' ? [{
          "@type": "Article",
          "@id": `${canonical}#article`,
          "mainEntityOfPage": canonical,
          "headline": title,
          "image": [schemaImage ? new URL(schemaImage, Astro.site).href : ogImageUrl],
          "publisher": { "@id": `${siteOrigin}/#person` },
          "description": description,
          "url": canonical,
          "author": { "@id": `${siteOrigin}/#person` },
          ...(publishedTime ? { "datePublished": publishedTime } : {}),
          ...((modifiedTime ?? publishedTime) ? { "dateModified": modifiedTime ?? publishedTime } : {}),
        }] : []),
        ...(breadcrumbs && breadcrumbs.length > 0 ? [{
          "@type": "BreadcrumbList",
          "itemListElement": breadcrumbs.map((crumb, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "name": crumb.name,
            "item": crumb.item,
          })),
        }] : []),
      ],
    })} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <!-- GSAP motion: hero suns and count-ups -->
    <script>
      import '../scripts/signal-motion.ts';
    </script>

    <!-- Long-form tables scroll sideways inside a wrapper rather than the page -->
    <script is:inline>
      (function () {
        document.querySelectorAll('.prose-signal table').forEach(function (table) {
          var wrap = document.createElement('div');
          wrap.className = 'table-wrap';
          table.parentNode.insertBefore(wrap, table);
          wrap.appendChild(table);
        });
      })();
    </script>
  </body>
</html>
