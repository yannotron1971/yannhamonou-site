---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/ui/Container.astro';
import Heading from '../../components/ui/Heading.astro';
import Text from '../../components/ui/Text.astro';
import PageHero from '../../components/PageHero.astro';
import { reader } from '../../lib/keystatic';

const allPosts = await reader.collections.posts.all();
const posts = allPosts.sort((a, b) => {
  const da = a.entry.publishedDate ?? '';
  const db = b.entry.publishedDate ?? '';
  return db > da ? 1 : -1;
});

const categories = ['all', ...Array.from(new Set(posts.map(p => p.entry.category))).sort()];

const labelMap: Record<string, string> = {
  all: 'All',
  strategy: 'Strategy',
  seo: 'SEO & GEO',
  paid: 'Paid media',
  content: 'Content',
  industry: 'Industry',
};

function fmtDate(d: string | null) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout
  title="Journal — B2B Marketing Insights · Yann Hamonou"
  description="Practical B2B marketing insights: SEO, strategy, paid media, positioning, and AI search. For Scottish and UK SMEs."
>
  <PageHero
    label="Writing"
    title="Journal"
    lede="Practical thinking on B2B marketing — what works, what's overhyped, and what Scottish SMEs should actually focus on."
  >
    <!-- Filter -->
    <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter by topic">
      {categories.map(cat => (
        <button
          type="button"
          class="filter-btn inline-flex h-10 items-center gap-2 border border-ink bg-transparent px-4 font-body text-sm text-ink transition-colors duration-200 hover:bg-stone aria-pressed:bg-ink aria-pressed:text-paper"
          data-filter={cat}
          aria-pressed={cat === 'all' ? 'true' : 'false'}
        >
          {labelMap[cat] ?? cat}
          {cat !== 'all' && (
            <span class="text-xs opacity-70">
              {posts.filter(p => p.entry.category === cat).length}
            </span>
          )}
        </button>
      ))}
    </div>
  </PageHero>

  <section class="bg-paper py-20 md:py-28">
    <Container data-group>
      {posts.length === 0 ? (
        <Text tone="secondary">Posts coming soon.</Text>
      ) : (
        <>
          <ul class="grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3" id="posts-grid" role="list">
            {posts.map(post => (
              <li data-m="rise" class="post-card data-[hidden]:hidden" data-category={post.entry.category}>
                <a href={`/journal/${post.slug}`} class="group block">
                  <div class="relative aspect-[3/2] overflow-hidden bg-stone">
                    {post.entry.coverImage ? (
                      <img
                        src={post.entry.coverImage}
                        alt={post.entry.coverAlt ?? ''}
                        loading="lazy"
                        class="absolute inset-0 h-full w-full object-cover grayscale transition-[filter] duration-500 group-hover:grayscale-0"
                      />
                    ) : (
                      <div aria-hidden="true" class="absolute inset-0 flex items-end justify-between p-5">
                        <span class="t-eyebrow">{labelMap[post.entry.category ?? ''] ?? 'Journal'}</span>
                        <span class="size-16 rounded-full bg-signal transition-transform duration-500 group-hover:-translate-x-2"></span>
                      </div>
                    )}
                  </div>
                  <Text size="sm" tone="secondary" class="mt-5">
                    {labelMap[post.entry.category ?? ''] ?? post.entry.category}{post.entry.publishedDate ? ` · ${fmtDate(post.entry.publishedDate)}` : ''}
                  </Text>
                  <Heading as="h2" size="sm" class="mt-2 decoration-signal decoration-2 underline-offset-4 group-hover:underline">{post.entry.title}</Heading>
                  <Text size="sm" tone="secondary" class="mt-3 max-w-xl">{post.entry.description}</Text>
                </a>
              </li>
            ))}
          </ul>
          <p id="no-results" class="hidden py-10">
            <Text tone="secondary">No posts in this category yet.</Text>
          </p>
        </>
      )}
    </Container>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.post-card');
  const noResults = document.getElementById('no-results');

  function filter(cat: string) {
    buttons.forEach(btn => {
      btn.setAttribute('aria-pressed', btn.dataset.filter === cat ? 'true' : 'false');
    });

    let visible = 0;
    cards.forEach(card => {
      const show = cat === 'all' || card.dataset.category === cat;
      card.toggleAttribute('data-hidden', !show);
      if (show) visible++;
    });

    if (noResults) noResults.classList.toggle('hidden', visible !== 0);

    // Persist selection in URL hash without scrolling
    history.replaceState(null, '', cat === 'all' ? location.pathname : `#${cat}`);
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => filter(btn.dataset.filter ?? 'all'));
  });

  // Restore from URL hash on load
  const hash = location.hash.slice(1);
  if (hash && [...buttons].some(b => b.dataset.filter === hash)) {
    filter(hash);
  }
</script>
