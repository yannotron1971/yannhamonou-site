---
import Layout from '../layouts/Layout.astro';
import { numbers } from '../data/index';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="About Yann Hamonou — B2B Marketing Consultant, Aberdeen"
  description="20+ years of B2B marketing experience. Digital marketing and strategy specialist working with Aberdeen, Aberdeenshire, and Scottish SMEs."
>
  <PageHero
    label="About"
    title="Twenty years making<br />marketing work for<br />B2B SMEs"
    lede="I'm Yann Hamonou, a B2B marketing consultant based in Stonehaven, Aberdeenshire. I help Scottish and UK SMEs build marketing that generates real revenue — not vanity metrics."
  />

  <div class="edge-sheet">
  <!-- STORY -->
  <section class="edge-block edge-block--white">
    <div class="edge-wrap">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,80px);align-items:start">
        <div>
          <div class="edge-label" style="margin-bottom:20px">The background</div>
          <div style="display:flex;flex-direction:column;gap:20px;color:var(--v4-ink-mute);font-size:16px;line-height:1.65">
            <p>
              I've spent two decades working in B2B marketing — from early-stage SaaS companies to established industrial and professional services firms across the UK and Europe.
            </p>
            <p>
              That experience covers every channel and every budget. What I've learned: most marketing problems aren't channel problems. They're positioning problems, strategy problems, or measurement problems. Fix those first, and execution becomes straightforward.
            </p>
            <p>
              I set up independently to work directly with business owners and directors who are serious about growth but frustrated by the gap between marketing spend and results.
            </p>
            <p>
              Based in Stonehaven, I work with clients across Aberdeen, Aberdeenshire, and Scotland — and remotely with businesses across the UK.
            </p>
          </div>
        </div>

        <div>
          <div class="edge-label" style="margin-bottom:20px">By the numbers</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px">
            {numbers.map(n => (
              <div class="v4-stat">
                <div class="v4-stat__num">{n.num}</div>
                <div class="v4-stat__label">{n.label}</div>
              </div>
            ))}
          </div>

          <div style="margin-top:40px;padding:24px;background:var(--v4-panel);border-radius:0;border:1px solid var(--v4-line-soft)">
            <div class="edge-label" style="margin-bottom:12px">Specialist in</div>
            <div style="display:flex;flex-wrap:wrap;gap:8px">
              {['Strategy', 'Positioning', 'SEO & GEO', 'Organic & Paid Media', 'Web & CRO', 'Marketing Leadership', 'B2B Lead Generation', 'Aberdeen & Scotland'].map(tag => (
                <span style="padding:6px 12px;background:var(--v4-panel-2);border-radius:999px;font-size:12px;color:var(--v4-ink-mute);font-family:var(--v4-mono);letter-spacing:0.04em">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW I WORK -->
  <section class="edge-block edge-block--paper">
    <div class="edge-wrap">
      <div class="edge-label" style="margin-bottom:20px">How it works</div>
      <h2 class="edge-h2" style="margin-bottom:48px">The Method</h2>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px">
        {[
          { num: '01', title: 'Diagnose', body: 'We start with an honest audit of where you are: what\'s working, what\'s leaking, and where the real opportunity is. No assumptions.' },
          { num: '02', title: 'Prioritise', body: 'From the audit I build a clear 90-day priority list — the highest-leverage actions that will move the needle fastest for your specific situation.' },
          { num: '03', title: 'Execute', body: 'Strategy without execution is a document. I either deliver the work myself or manage the right specialists — with clear ownership and measurable goals.' },
        ].map(step => (
          <div style="border-top:2px solid var(--v4-line);padding-top:24px">
            <div class="edge-label" style="margin-bottom:16px">{step.num}</div>
            <h3 style="font-family:var(--v4-display);font-weight:400;font-size:clamp(22px,2.5vw,30px);letter-spacing:-0.01em;color:var(--v4-ink);margin-bottom:12px">
              {step.title}
            </h3>
            <p style="font-size:15px;color:var(--v4-ink-mute);line-height:1.6">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="edge-block edge-block--dark edge-block--pitch">
    <div class="edge-wrap" style="max-width:640px;text-align:center">
      <h2 class="edge-h2" style="margin-bottom:16px">Ready to Talk?</h2>
      <p style="color:var(--v4-ink-mute);font-size:17px;line-height:1.6;margin-bottom:32px">
        Book a free 30-minute strategy review. I'll look at your current situation and tell you exactly what I'd change.
      </p>
      <a href="/contact" class="edge-btn" style="height:48px;font-size:15px;padding:0 32px">
        Book the free review →
      </a>
    </div>
  </section>
  </div>
</Layout>

<style>
@media (max-width: 760px) {
  section .v4-wrap > div[style*="grid-template-columns:1fr 1fr"],
  section .v4-wrap > div[style*="grid-template-columns:repeat(3"] {
    grid-template-columns: 1fr !important;
  }
}
</style>
