---
/* Inline line icons (Lucide paths), so no icon library ships to the browser.
   stroke: line weight; the service rows and closing band use thin arrows (1 and 0.6). */
interface Props {
  name: 'arrow-right' | 'menu' | 'x' | 'linkedin' | 'phone' | 'mail' | 'plus';
  class?: string;
  stroke?: number;
}
const { name, class: className = 'size-4', stroke = 2 } = Astro.props;
---
<svg aria-hidden="true" class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round">
  {name === 'arrow-right' && (<><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></>)}
  {name === 'menu' && (<><path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" /></>)}
  {name === 'x' && (<><path d="M18 6 6 18" /><path d="m6 6 12 12" /></>)}
  {name === 'plus' && (<><path d="M5 12h14" /><path d="M12 5v14" /></>)}
  {name === 'linkedin' && (<><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></>)}
  {name === 'phone' && (<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />)}
  {name === 'mail' && (<><rect width="20" height="16" x="2" y="4" /><path d="m22 7-10 6L2 7" /></>)}
</svg>
