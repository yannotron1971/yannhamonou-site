---
/* Sparehand — a concept landing page, built to show web work.

   Sparehand is fictional. It is set in a market none of the clients on this
   site sell into (stores and spares for offshore and energy sites), so it
   cannot read as a disguised client pitch. Every figure in the product
   illustrations is labelled illustrative.

   Standalone on purpose: no site Layout, so none of the site's nav, styles,
   analytics or JSON-LD. The design follows the Paid-inspired "Goodside"
   system kept in design-notes/paid-goodside/ — forest and lime, square
   geometry, product demonstrations as the imagery.

   The resting state is the finished state. Entrances are CSS animations that
   end visible, every tab panel is in the HTML, and the typed summary is
   server-rendered in full; the script only takes things away to animate them
   back, and does nothing under reduced motion. */
const title = 'Sparehand — Know what’s on the shelf before you need it';
const description =
  'A concept landing page by Yann Hamonou for Sparehand, a fictional stores and spares product for offshore and energy sites.';

const tabs = [
  {
    id: 'stock',
    n: '01',
    name: 'Live stock',
    label: 'Everything in view',
    title: ['One list.', 'Every location.'],
    body: 'Warehouse, platform stores, laydown yards and the part on the back of a supply boat, counted in one place. Search a part number once and see where every unit is.',
    link: 'See the stock view',
    head: ['Part', 'Location', 'Qty'],
    rows: [
      ['Mech. seal, 50 mm', 'Platform', '1', ''],
      ['Mech. seal, 50 mm', 'Dyce', '4', 'green'],
      ['Mech. seal, 50 mm', 'On vessel', '2', ''],
    ],
    foot: 'Seven units. Three places. One search.',
  },
  {
    id: 'requisitions',
    n: '02',
    name: 'Requisitions',
    label: 'From request to rig',
    title: ['No more', 'email chains.'],
    body: 'Raise a request from the field app, route it for approval by cost and criticality, and follow it through picking, packing and the boat.',
    link: 'Follow a requisition',
    head: ['Request', 'Owner', 'Status'],
    rows: [
      ['REQ-2231 · Valve kit', 'Morag', 'Approved', 'green'],
      ['REQ-2232 · Filters ×12', 'Ali', 'Picking', ''],
      ['REQ-2233 · Detector head', 'Dan', 'On vessel', ''],
    ],
    foot: 'Every request has an owner and a next step.',
  },
  {
    id: 'critical',
    n: '03',
    name: 'Critical spares',
    label: 'The parts you can’t wait for',
    title: ['Watched before', 'they run out.'],
    body: 'Flag the spares that stop production. Sparehand warns you before stock drops below the minimum, using real lead times rather than a guess.',
    link: 'Set a minimum',
    head: ['Spare', 'Lead time', 'Status'],
    rows: [
      ['Mech. seal, 50 mm', '9 days', 'Below min', ''],
      ['ESD actuator kit', '21 days', 'Reorder soon', ''],
      ['Gas detector head', '5 days', 'Healthy', 'green'],
    ],
    foot: 'Warnings arrive while there is still time to act.',
  },
  {
    id: 'reports',
    n: '04',
    name: 'Reports',
    label: 'Stock you can justify',
    title: ['Numbers for the', 'budget meeting.'],
    body: 'See what is slow-moving, what is duplicated between sites and what has sat untouched since the last shutdown, before anyone asks.',
    link: 'Open a report',
    head: ['Finding', 'Lines', 'Action'],
    rows: [
      ['Slow-moving stock', '212', 'Review', ''],
      ['Duplicated across sites', '37', 'Transfer', ''],
      ['Untouched 24 months', '118', 'Dispose', ''],
    ],
    foot: 'Illustrative data for a fictional product.',
  },
];

const steps = [
  { icon: '↙', k: 'When this happens', h: 'A pump seal fails', p: 'P-101A, on the platform' },
  { icon: '⌕', k: 'Check the stock', h: 'Find the nearest spare', p: '4 at Dyce, 0 offshore' },
  { icon: '✓', k: 'Move it', h: 'Raise and approve', p: 'REQ-2234 · on tomorrow’s boat' },
  { icon: '↻', k: 'Close the loop', h: 'Reorder and record', p: 'Minimum stock restored' },
];

const summary =
  'Three critical spares fell below minimum this week. Two are already on order. The ESD actuator kit needs approval before Friday’s boat, or the next chance is ten days away.';

const faq = [
  {
    q: 'What is Sparehand?',
    a: 'A fictional stores and spares product, made up for this page. Nothing here is a real product, customer or result, and there is nothing to sign up for.',
  },
  {
    q: 'Why build a page for a product that does not exist?',
    a: 'To show what a product landing page can be when it is designed and built properly: the product explains itself through its own screens, every section works on a phone, and nothing depends on animation to be read.',
  },
  {
    q: 'Who designed and built it?',
    a: 'Yann Hamonou. It is built in Astro and sits inside this site, with no page builder and no plugins, and it uses a small amount of JavaScript for the tabs, the workflow and the calculator.',
  },
  {
    q: 'Are the numbers real?',
    a: 'No. Stock levels, lead times, requisitions and the calculator’s assumption are all illustrative, chosen to make the product legible rather than to claim a result.',
  },
  {
    q: 'Can you build a page like this for my product?',
    a: 'Yes. Book the free 30-minute review and bring the product. We will look at what the page has to prove, and to whom, before anything is designed.',
  },
];
---

<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' fill='%2302261a'/%3E%3Cpath d='M12 11h16v6H18v3h10v9H12v-6h10v-3H12z' fill='%23b2e659'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <div class="concept-bar">
    <span>Concept site by Yann Hamonou. Sparehand is a fictional product.</span>
    <a href="/work/web/">← Web work</a>
  </div>

  <header>
    <div class="nav wrap">
      <a class="brand" href="#main" aria-label="Sparehand, back to top"><span class="brandmark" aria-hidden="true">s</span>sparehand</a>
      <nav id="navigation" aria-label="Main navigation">
        <a href="#platform">Platform</a>
        <a href="#field">Field app</a>
        <a href="#workflows">Workflows</a>
        <a href="#reports">Reports</a>
        <a href="#faq">FAQ</a>
      </nav>
      <a class="button nav-cta" href="#tour">Book a walkthrough <span aria-hidden="true">↗</span></a>
      <button class="menu" type="button" aria-controls="navigation" aria-expanded="false" aria-label="Open menu">☰</button>
    </div>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="hero wrap grid-paper">
      <div class="hero-copy">
        <div class="tag"><span class="dot"></span> Stores and spares for offshore and energy sites</div>
        <h1><span>Know what’s</span> <span>on the shelf</span> <span>before you need it.</span></h1>
        <p>Sparehand keeps every critical spare in view, from the warehouse onshore to the stores on the platform, so a failed pump is a two-hour job instead of a two-week wait.</p>
        <div class="actions">
          <a class="button" href="#platform">See the stores view <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="#workflows">How it works <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-note">Built for storemen, planners and maintenance leads.</p>
      </div>

      <div class="hero-art" role="img" aria-label="Illustrative Sparehand workspace listing critical spares across sites, with a suggested reorder">
        <div class="app" aria-hidden="true">
          <div class="app-head">
            <span class="mini-brand">◧ sparehand</span>
            <span class="muted">Stores / Critical spares</span>
            <span class="avatar">RM</span>
          </div>
          <div class="app-grid">
            <div class="app-side">
              <b>▣ &nbsp;Critical spares <small>14</small></b>
              <span>⇄ &nbsp;Requisitions</span>
              <span>⛴ &nbsp;In transit</span>
              <span>⌂ &nbsp;Sites</span>
              <span>▥ &nbsp;Reports</span>
              <div class="side-foot"><span class="dot"></span> Stock synced 2 min ago</div>
            </div>
            <div class="app-main">
              <div class="flex"><b>Critical spares, all sites</b><span>⌕</span></div>
              <div class="line selected">
                <span class="sq">P</span>
                <div><b>Mech. seal, 50 mm</b><small>Pump P-101A · platform stores</small></div>
                <span class="pill warn">1 · below min</span>
              </div>
              <div class="line">
                <span class="sq">G</span>
                <div><b>Gas detector head</b><small>Onshore warehouse</small></div>
                <span class="pill green">6 · healthy</span>
              </div>
              <div class="line">
                <span class="sq">E</span>
                <div><b>ESD actuator kit</b><small>On supply vessel</small></div>
                <span class="pill">ETA Thu</span>
              </div>
              <div class="draft">
                <span>✧ Suggested reorder</span>
                <p>Order 2 × mechanical seal now. Lead time is 9 days, and P-101B uses the same part.</p>
                <div><span>✓ Based on usage and lead times</span><b>↗</b></div>
              </div>
            </div>
          </div>
        </div>
        <div class="float-dark" aria-hidden="true"><span class="dot"></span> Requisition approved. On tomorrow’s boat. <span class="check">✓</span></div>
        <div class="float-lime" aria-hidden="true">
          <span>Critical spares in stock</span>
          <strong>96<span>%</span></strong>
          <small>Illustrative figure</small>
          <div class="mini-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        </div>
        <div class="art-caption" aria-hidden="true">Illustrative workspace · fictional data</div>
      </div>
    </section>

    <!-- Platform tabs -->
    <section class="intro wrap" id="platform">
      <div class="section-intro">
        <h2>Every spare.<br />Every site. One list.</h2>
        <p>Most stores run on a spreadsheet per site and a phone call to find out what is really there. Sparehand puts the whole picture in one place.</p>
      </div>
      <div class="tabs" data-tabs>
        <div class="tablist" role="tablist" aria-label="Explore the platform">
          {tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={`panel-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >{t.n} &nbsp; {t.name}</button>
          ))}
        </div>
        {tabs.map((t) => (
          <div class="panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} tabindex="0">
            <div>
              <span class="label">{t.label}</span>
              <h3>{t.title[0]}<br />{t.title[1]}</h3>
              <p>{t.body}</p>
              <a class="text-link" href="#tour">{t.link} <span aria-hidden="true">↗</span></a>
            </div>
            <div class="queue">
              <div class="flex"><b>{t.name}</b><span class="status">● Live</span></div>
              <div class="queue-row queue-head"><span>{t.head[0]}</span><span>{t.head[1]}</span><span>{t.head[2]}</span></div>
              {t.rows.map((r) => (
                <div class="queue-row">
                  <span><b>{r[0]}</b></span><span>{r[1]}</span><span class={`pill ${r[3]}`}>{r[2]}</span>
                </div>
              ))}
              <div class="queue-foot"><span class="dot"></span> {t.foot}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Field app -->
    <section class="feature wrap" id="field">
      <div class="visual grid-paper">
        <div class="device">
          <div class="flex"><b>▣ Receive delivery</b><span class="status">Offline</span></div>
          <div class="scan"><span class="scan-frame" aria-hidden="true"></span><small>Scan a label or type a part number</small></div>
          <ul class="scan-list">
            <li><span>Filter element ×12</span><b class="pill green">Received</b></li>
            <li><span>Mech. seal, 50 mm ×2</span><b class="pill green">Received</b></li>
            <li><span>Gasket set</span><b class="pill warn">Damaged · photo added</b></li>
          </ul>
          <div class="sync"><span class="dot"></span> 3 movements queued. They sync when the link is back.</div>
        </div>
        <div class="visual-foot">WORKS WHERE THE WIFI DOESN’T.</div>
      </div>
      <div class="feature-copy">
        <span class="tag">▣ Built for the stores, not the office</span>
        <h2>Scan it in.<br />Even offshore.</h2>
        <p>Deliveries, issues and transfers get recorded where they happen, on a rugged handheld, instead of on paper that gets typed up at the end of the trip.</p>
        <ul class="check-list">
          <li>Works without a connection and syncs later</li>
          <li>Barcode and QR scanning on the devices you already use</li>
          <li>A photo and a note on every damaged delivery</li>
        </ul>
      </div>
    </section>

    <!-- Workflow -->
    <section class="workflow dark" id="workflows">
      <div class="wrap">
        <div class="section-intro">
          <h2>Less chasing.<br />More fixing.</h2>
          <div>
            <p>When something breaks, the part search, the approval and the reorder happen in one flow instead of four phone calls.</p>
            <button class="button lime" type="button" data-run-workflow>Run this workflow <span aria-hidden="true">▶</span></button>
          </div>
        </div>
        <ol class="track" data-track>
          {steps.map((s, i) => (
            <li class="step">
              <span class="step-icon" aria-hidden="true">{s.icon}</span>
              <small>{s.k}</small>
              <h3>{s.h}</h3>
              <p>{s.p}</p>
            </li>
          ))}
        </ol>
        <p class="workflow-status" role="status" data-workflow-status>A failed seal, from fault to reorder. Run the example above.</p>
      </div>
    </section>

    <!-- Reports -->
    <section class="feature reverse wrap" id="reports">
      <div class="analytics">
        <div class="flex"><b>Stores at a glance</b><span class="pill">Last 90 days</span></div>
        <div class="numbers">
          <div><small>Critical spares in stock</small><strong>96<em>%</em></strong><span>↗ 7 points</span></div>
          <div><small>Average lead time</small><strong>9<em>days</em></strong><span>↘ 2 days</span></div>
          <div><small>Emergency freight</small><strong>3<em>trips</em></strong><span>↘ from 11</span></div>
        </div>
        <div class="chart" data-chart role="img" aria-label="Illustrative chart: emergency orders falling month by month">
          <div style="--bar:88%"><i></i><span>Jan</span></div>
          <div style="--bar:74%"><i></i><span>Feb</span></div>
          <div style="--bar:70%"><i></i><span>Mar</span></div>
          <div style="--bar:52%"><i></i><span>Apr</span></div>
          <div style="--bar:44%"><i></i><span>May</span></div>
          <div style="--bar:30%"><i></i><span>Jun</span></div>
        </div>
        <div class="chart-legend"><span><i></i> Emergency orders</span><small>Illustrative data</small></div>

        <div class="summary" data-summary>
          <div class="flex"><b>✧ Weekly stores summary</b><button class="replay" type="button" data-replay hidden>Replay</button></div>
          <p class="sr-only">{summary}</p>
          <div class="summary-text" aria-hidden="true">
            <span class="reserve">{summary}</span>
            <span class="typed" data-typed>{summary}</span>
          </div>
        </div>
      </div>
      <div class="feature-copy">
        <span class="tag">▥ The story behind the stock</span>
        <h2>Fewer boats<br />for one part.</h2>
        <p>Emergency freight is where a stores budget quietly disappears. Sparehand shows which failures caught you short, and what to hold so they don’t next time.</p>
        <a class="text-link" href="#calculator">Estimate the time back <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <!-- Calculator -->
    <section class="calculator wrap" id="calculator">
      <div>
        <span class="tag">Make room for the real work</span>
        <h2>How long does your team<br />spend chasing parts?</h2>
        <p>Move the slider to your monthly requisitions and see the hours a single flow could hand back.</p>
        <label for="volume">Requisitions a month <output id="volume-output" for="volume">300</output></label>
        <input id="volume" type="range" min="50" max="1000" step="10" value="300" />
        <div class="range-labels"><span>50</span><span>1,000</span></div>
        <small>Assumes 20 minutes saved per requisition on searching, approvals and follow-up. A planning estimate for a fictional product, not a performance claim.</small>
      </div>
      <div class="calc-result">
        <span>TIME BACK, EVERY MONTH</span>
        <div><output id="hours-output" for="volume">100</output><span>hours</span></div>
        <p>For planned maintenance.<br />For the stock take nobody gets to.<br />For going home on time.</p>
        <a class="button lime" href="#tour">See it on your stock <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq wrap" id="faq">
      <div>
        <span class="tag">A few straight answers</span>
        <h2>Fair questions.</h2>
        <p>Start here. The last one is the one that matters.</p>
      </div>
      <div class="faq-list">
        {faq.map((f) => (
          <details>
            <summary>{f.q}<span aria-hidden="true">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Final CTA: the one real action on the page -->
    <section class="final-cta dark" id="tour">
      <div class="wrap">
        <span class="tag">A concept by Yann Hamonou</span>
        <h2>Want a page<br />like this one?</h2>
        <p>I design and build landing pages for B2B products: fast, accessible and built to rank.</p>
        <a class="button lime" href="/contact">Talk to Yann <span aria-hidden="true">↗</span></a>
        <small>Built in Astro. No page builder, no plugins.</small>
      </div>
      <span class="cta-mark" aria-hidden="true">s</span>
    </section>
  </main>

  <footer class="wrap">
    <div class="footer-top">
      <div>
        <a class="brand" href="#main"><span class="brandmark" aria-hidden="true">s</span>sparehand</a>
        <p>Every spare in its place.</p>
      </div>
      <div>
        <b>Product</b>
        <a href="#platform">Live stock</a>
        <a href="#field">Field app</a>
        <a href="#workflows">Workflows</a>
        <a href="#reports">Reports</a>
      </div>
      <div>
        <b>Explore</b>
        <a href="#calculator">Time calculator</a>
        <a href="#faq">Questions</a>
        <a href="#tour">Walkthrough</a>
      </div>
      <div>
        <b>About this concept</b>
        <a href="/work/web/">Web work</a>
        <a href="/services/web">Web &amp; CRO service</a>
        <a href="/">Yann Hamonou</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>Sparehand is a fictional product and brand. Concept, design and build by Yann Hamonou, 2026.</span>
      <span>Design system after Paid, adapted.</span>
    </div>
  </footer>

  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Mobile menu */
    const menu = document.querySelector<HTMLButtonElement>('.menu');
    const nav = document.getElementById('navigation');
    if (menu && nav) {
      const set = (open: boolean) => {
        menu.setAttribute('aria-expanded', String(open));
        menu.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        nav.classList.toggle('open', open);
      };
      menu.addEventListener('click', () => set(menu.getAttribute('aria-expanded') !== 'true'));
      nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    }

    /* Tabs. Every panel is in the HTML; this only hides the inactive ones. */
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
      const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
      const select = (i: number, focus = false) => {
        tabs.forEach((t, j) => {
          const on = i === j;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          panels[j].hidden = !on;
        });
        if (focus) tabs[i].focus();
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(i));
        t.addEventListener('keydown', (e) => {
          const k = e.key;
          const n = tabs.length;
          if (k === 'ArrowRight' || k === 'ArrowDown') { e.preventDefault(); select((i + 1) % n, true); }
          if (k === 'ArrowLeft' || k === 'ArrowUp') { e.preventDefault(); select((i - 1 + n) % n, true); }
          if (k === 'Home') { e.preventDefault(); select(0, true); }
          if (k === 'End') { e.preventDefault(); select(n - 1, true); }
        });
      });
      select(0);
    });

    /* Workflow: four steps at 650 ms, user-triggered only. */
    const run = document.querySelector<HTMLButtonElement>('[data-run-workflow]');
    const track = document.querySelector<HTMLElement>('[data-track]');
    const status = document.querySelector<HTMLElement>('[data-workflow-status]');
    if (run && track && status) {
      const steps = [...track.querySelectorAll<HTMLElement>('.step')];
      run.addEventListener('click', () => {
        run.disabled = true;
        steps.forEach((s) => s.classList.remove('active'));
        const done = () => {
          status.textContent = 'Seal found onshore, approved, on tomorrow’s boat, and reordered. Four steps, one flow.';
          run.disabled = false;
        };
        if (reduced) { steps.forEach((s) => s.classList.add('active')); done(); return; }
        status.textContent = 'Running the example…';
        steps.forEach((s, i) => setTimeout(() => {
          steps.forEach((x) => x.classList.remove('current'));
          s.classList.add('active', 'current');
          if (i === steps.length - 1) done();
        }, 650 * (i + 1)));
      });
    }

    /* Calculator */
    const volume = document.getElementById('volume') as HTMLInputElement | null;
    const vOut = document.getElementById('volume-output');
    const hOut = document.getElementById('hours-output');
    if (volume && vOut && hOut) {
      const update = () => {
        const v = Number(volume.value);
        vOut.textContent = v.toLocaleString('en-GB');
        hOut.textContent = Math.round((v * 20) / 60).toLocaleString('en-GB');
      };
      volume.addEventListener('input', update);
      update();
    }

    /* Chart bars grow on first entry — only if the chart starts offscreen,
       so nothing already on screen is ever hidden. */
    const chart = document.querySelector<HTMLElement>('[data-chart]');
    if (chart && !reduced && 'IntersectionObserver' in window && chart.getBoundingClientRect().top > window.innerHeight) {
      chart.classList.add('waiting');
      const io = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { chart.classList.remove('waiting'); io.disconnect(); }
      }, { threshold: 0.4 });
      io.observe(chart);
    }

    /* Weekly summary types itself on first entry. The full text stays in the
       sr-only copy and in the reserve span that holds the height; the typing
       pauses offscreen and in a hidden tab, and never runs under reduced
       motion. */
    const box = document.querySelector<HTMLElement>('[data-summary]');
    const typed = box?.querySelector<HTMLElement>('[data-typed]');
    const replay = box?.querySelector<HTMLButtonElement>('[data-replay]');
    if (box && typed && replay && !reduced && 'IntersectionObserver' in window) {
      const full = typed.textContent ?? '';
      let pos = 0;
      let timer = 0;
      let visible = false;
      let started = false;
      const tick = () => {
        if (!visible || document.hidden) { timer = 0; return; }
        pos = Math.min(full.length, pos + 2);
        typed.textContent = full.slice(0, pos);
        if (pos < full.length) { timer = window.setTimeout(tick, 32); }
        else { timer = 0; box.classList.remove('typing'); replay.hidden = false; }
      };
      const start = () => {
        clearTimeout(timer);
        pos = 0;
        typed.textContent = '';
        box.classList.add('typing');
        replay.hidden = true;
        timer = window.setTimeout(tick, 900);
      };
      const resume = () => { if (started && !timer && pos < full.length) timer = window.setTimeout(tick, 32); };
      new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
        if (visible && !started) { started = true; start(); }
        else resume();
      }, { threshold: 0.5 }).observe(box);
      document.addEventListener('visibilitychange', resume);
      replay.addEventListener('click', start);
    }
  </script>

