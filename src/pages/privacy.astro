---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="Privacy Policy — Yann Hamonou"
  description="Privacy policy for yannhamonou.com"
  noindex={true}
>
  <PageHero label="Legal" title="Privacy policy" />

  <div class="edge-sheet">
  <section class="edge-block edge-block--white">
    <div class="edge-wrap edge-wrap--narrow">
      <div class="v4-prose" style="margin-inline:0">
        <p>This privacy policy explains how Yann Hamonou ("I", "me", "my") collects, uses, and protects personal information submitted through this website.</p>

        <h2>Data I collect</h2>
        <p>When you submit the contact form, I collect your name, email address, company name, and the information you provide in the message. This data is transmitted via Formspree and is used only to respond to your enquiry.</p>
        <p>I do not use cookies for tracking. No third-party analytics are used on this site.</p>

        <h2>How I use your data</h2>
        <p>Contact form submissions are used solely to respond to your enquiry. I will not add you to any mailing list or share your data with third parties without your explicit consent.</p>

        <h2>Data retention</h2>
        <p>Contact enquiries are retained for up to 12 months and then deleted, unless an ongoing business relationship exists.</p>

        <h2>Your rights</h2>
        <p>Under UK GDPR, you have the right to access, correct, or request deletion of your personal data. Contact me at <a href="mailto:yanndaman@googlemail.com">yanndaman@googlemail.com</a> to exercise these rights.</p>

        <h2>Contact</h2>
        <p>Yann Hamonou, 34 Bernham Avenue, Stonehaven, Aberdeenshire, AB39 2WD, Scotland, UK.</p>
        <p>Email: <a href="mailto:yanndaman@googlemail.com">yanndaman@googlemail.com</a></p>
      </div>
    </div>
  </section>
  </div>
</Layout>
