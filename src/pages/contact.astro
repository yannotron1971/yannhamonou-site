---
import Layout from '../layouts/Layout.astro';
import Container from '../components/ui/Container.astro';
import Heading from '../components/ui/Heading.astro';
import Text from '../components/ui/Text.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { homeClients } from '../data/index';

const viewport3 = homeClients.find((c) => c.name === 'Viewport3');

const steps = [
  { t: 'You send the form', b: "Takes 2 minutes. Tell me what you're working on and where it's breaking down." },
  { t: 'I review your situation', b: "I'll look at your site, your positioning, and your marketing before we speak." },
  { t: '30-min call, clear priorities', b: "You leave with a specific list of what I'd fix first — not a generic report." },
];
---

<Layout
  title="Free 30-Minute Marketing Strategy Review — Aberdeen"
  description="Book a free 30-minute marketing strategy review with Yann Hamonou, B2B marketing consultant in Aberdeen. You'll leave with a clear priority list — no pitch, no agenda."
>
  <PageHero
    label="Get in touch"
    title="Free 30-min<br />strategy review"
    lede="Tell me where you are and what's not working. I'll review your situation and share exactly what I'd prioritise. No pitch, no agenda — just a useful conversation."
  />

  <section class="bg-paper py-16 md:py-24">
    <Container class="grid gap-14 lg:grid-cols-12 lg:gap-6">
      <!-- Form and phone -->
      <div class="lg:col-span-6">
        <ContactForm id="contact-form" buttonLabel="Request my consultation" class="border border-ink" />

        <div class="mt-12 border-t border-ink pt-8">
          <Text size="sm" tone="secondary">Prefer to call?</Text>
          <a href="tel:+447853455816" class="mt-3 block font-heading text-4xl font-extrabold tracking-[-0.03em] [font-stretch:110%] decoration-signal decoration-2 underline-offset-4 hover:underline">+44 7853 455 816</a>
          <Text size="sm" tone="secondary" class="mt-2">Mon–Fri, 9am–6pm GMT</Text>
        </div>
      </div>

      <!-- What to expect, response time, client quote -->
      <div class="space-y-12 lg:col-span-5 lg:col-start-8 lg:border-l lg:border-ink lg:pl-10">
        <div>
          <Heading as="h2" size="md">What to expect</Heading>
          <ol class="mt-6">
            {steps.map((s, i) => (
              <li class="flex gap-4 border-t border-ink py-5">
                <span aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-full bg-signal font-body text-base font-semibold text-ink">{i + 1}</span>
                <div>
                  <Text class="font-semibold">{s.t}</Text>
                  <Text size="sm" tone="secondary" class="mt-1">{s.b}</Text>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="border-t border-ink pt-8">
          <Text size="sm" tone="secondary">Typical response time</Text>
          <p class="mt-3 font-heading text-7xl font-black leading-[0.9] tracking-[-0.05em] [font-stretch:115%]">&lt;4h</p>
          <Text size="sm" tone="secondary" class="mt-4 max-w-sm">
            During business hours. I read every enquiry personally and respond with something useful — not a templated reply.
          </Text>
        </div>

        <figure class="border-t border-ink pt-8">
          <Text size="sm" tone="secondary">What clients say</Text>
          {viewport3 && (
            <img src={viewport3.logo} alt="" loading="lazy" class="mt-5 h-auto max-h-9 w-auto max-w-[150px] object-contain grayscale" />
          )}
          <blockquote class="mt-5">
            <Text>"Within three months we saw measurable results in both organic traffic and lead quality."</Text>
          </blockquote>
          <figcaption class="mt-4">
            <Text size="sm" tone="secondary">Chris Harvey, CEO · Viewport3, Aberdeen</Text>
          </figcaption>
        </figure>
      </div>
    </Container>
  </section>
</Layout>
