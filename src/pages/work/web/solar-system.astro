---
/* Solar System: a fourth concept page, built to show 3D web work.

   A scroll-driven tour from the Sun to Neptune over a live three.js scene,
   then free exploration with orbit controls and click-to-fly. Standalone,
   like the other concepts, but this one borrows the site's own Signal
   Poster type and accent for the interface layer: Archivo, JetBrains Mono,
   one signal orange, sharp corners, 1px hairlines. Space is the one place
   the light paper gives way.

   Content is server-rendered. Every stop's name, line and facts are in the
   HTML, so the page reads without JavaScript or WebGL, over a still poster
   of the scene. The tour controller (tour.ts) is tiny and loads with the
   page; three.js and the scene (scene.ts) load after the window load event.

   Figures: NASA Planetary Fact Sheet and Sun Fact Sheet. Positions: JPL
   approximate mean longitudes. Textures: Solar System Scope, CC BY 4.0.
   Sources and licences are in public/work/web/solar-system/CREDITS.md and
   in the page footer. */
import { BODIES } from '../../../scripts/solar-system/data';

const title = 'Solar System: a 3D concept by Yann Hamonou';
const description =
  'A concept page by Yann Hamonou: a scroll-driven 3D tour of the Sun and planets, built with three.js, with orbits on their real periods.';
const ogImage = new URL('/og/solar-system.jpg', Astro.site).href;
const total = BODIES.length;
const pad = (n: number) => String(n).padStart(2, '0');
const short = (name: string) => name.replace(/^The /, '').replace('asteroid belt', 'Belt');
---

<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#030303" />
  <meta name="color-scheme" content="dark" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23030303'/%3E%3Ccircle cx='16' cy='16' r='5' fill='%23ff4f1a'/%3E%3Cellipse cx='16' cy='16' rx='13' ry='5' fill='none' stroke='%23fafaf7' stroke-width='1.2'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500;600&display=swap"
  />
  <link rel="preload" as="image" href="/work/web/solar-system/poster.webp" fetchpriority="high" />
  <script is:inline>document.documentElement.classList.add('ss-js');</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <div id="ss-stage" class="ss-stage">
    <canvas id="ss-canvas" role="img" aria-label="A live 3D model of the Sun and the eight planets, moving on their orbits."></canvas>
    <div id="ss-labels" class="ss-labels"></div>
  </div>
  <div id="ss-loader" class="ss-loader" aria-hidden="true"></div>

  <div class="concept-bar mono">
    <span>Concept site by Yann Hamonou.<span class="cb-long"> A 3D tour of the solar system.</span></span>
    <a href="/work/web/">← Web work</a>
  </div>

  <nav class="ss-rail" aria-label="Tour stops">
    {BODIES.map((b, i) => (
      <button type="button" data-goto={i + 1}>
        <span class="ss-rail-name mono">{short(b.name)}</span>
        <span class="ss-rail-tick" aria-hidden="true"></span>
      </button>
    ))}
  </nav>

  <main id="main">
    <section class="ss-hero" data-frame="hero">
      <div class="ss-hero-inner">
        <p class="eyebrow mono">Concept · three.js · WebGL</p>
        <h1>Ten stops from the Sun to Neptune.</h1>
        <p class="lede">
          Scroll to travel outwards. When you reach the edge, the controls are yours.
          <span class="ss-scale-inline">Sizes and distances are compressed so every planet fits on screen. Orbital periods are real.</span>
        </p>
        <p class="cue mono" aria-hidden="true">Scroll <span>↓</span></p>
      </div>
    </section>

    {BODIES.map((b, i) => (
      <section class="ss-stop" data-frame={b.id} id={b.id} aria-labelledby={`h-${b.id}`}>
        <article class="ss-card">
          <p class="ss-idx mono"><span>{pad(i + 1)}</span> / {pad(total)}</p>
          <h2 id={`h-${b.id}`}>{b.name}</h2>
          <p class="ss-line">{b.line}</p>
          <dl class="ss-facts">
            {b.facts.map((f) => (
              <div>
                <dt class="mono">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        </article>
      </section>
    ))}

    <section class="ss-end" data-frame="wide" aria-labelledby="h-explore">
      <div class="ss-end-inner">
        <h2 id="h-explore">Your turn.</h2>
        <p class="ss-gl-only">Drag to orbit, scroll to zoom, and click any planet to fly to it. Time runs at a day a second, faster if you want it.</p>
        <p class="ss-nogl-only">Your browser can't run the 3D scene, so you're seeing the still version. The tour above has every figure.</p>
        <button id="ss-explore" class="ss-btn ss-gl-only" type="button">Explore freely <span aria-hidden="true">↗</span></button>
      </div>
    </section>

    <footer class="ss-footer">
      <div class="ss-footer-cta">
        <p class="eyebrow mono">Built by Yann Hamonou</p>
        <p class="ss-footer-line">Want a site that makes people stop scrolling?</p>
        <a class="ss-btn" href="/contact/">Talk to Yann <span aria-hidden="true">→</span></a>
      </div>
      <div class="ss-credits mono">
        <h2>Sources</h2>
        <ul>
          <li>Figures: <a href="https://nssdc.gsfc.nasa.gov/planetary/factsheet/" rel="noopener">NASA Planetary Fact Sheet</a> and <a href="https://nssdc.gsfc.nasa.gov/planetary/factsheet/sunfact.html" rel="noopener">Sun Fact Sheet</a>.</li>
          <li>Positions: mean longitudes from <a href="https://ssd.jpl.nasa.gov/planets/approx_pos.html" rel="noopener">JPL, Approximate Positions of the Planets</a>, on circular orbits.</li>
          <li>Textures: <a href="https://www.solarsystemscope.com/textures/" rel="noopener">Solar System Scope</a>, <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">CC BY 4.0</a>, resized and converted to WebP.</li>
          <li>Scale: sizes and distances compressed, orbital periods real, orbits drawn as circles.</li>
        </ul>
      </div>
    </footer>
  </main>

  <p class="ss-scale mono">Not to scale: sizes and distances are compressed so every planet fits. Orbital periods are real.</p>

  <div class="ss-hud">
    <button id="ss-back" class="ss-hud-btn mono" type="button"><span aria-hidden="true">←</span> Back to the tour</button>
    <div class="ss-time mono" role="group" aria-label="Simulation speed">
      <button type="button" data-speed="0" aria-pressed="false">Pause</button>
      <button type="button" data-speed="1" aria-pressed="true">1 day/s</button>
      <button type="button" data-speed="2" aria-pressed="false">10 days/s</button>
      <button type="button" data-speed="3" aria-pressed="false">100 days/s</button>
      <span class="ss-date" id="ss-date"></span>
    </div>
    <p class="ss-hint mono"><span class="hint-fine">Drag to orbit · scroll to zoom · click a planet · Esc to step back</span><span class="hint-touch">Drag to orbit · pinch to zoom · tap a planet</span></p>
  </div>

  <aside id="ss-panel" class="ss-panel" hidden aria-live="polite" aria-label="Details">
    <button id="ss-panel-close" class="ss-close" type="button" aria-label="Close and return to the whole system">×</button>
    <div id="ss-panel-body" class="ss-panel-body"></div>
  </aside>

  <script>
    import { initTour } from '../../../scripts/solar-system/tour';

    initTour();
    const html = document.documentElement;
    const hasGL = (() => {
      try {
        return !!document.createElement('canvas').getContext('webgl2');
      } catch {
        return false;
      }
    })();
    if (!hasGL) html.classList.add('ss-no-webgl');
    else {
      const go = () =>
        import('../../../scripts/solar-system/scene')
          .then((m) => m.start())
          .catch((err) => {
            console.error('[solar-system]', err);
            html.classList.add('ss-no-webgl');
          });
      if (document.readyState === 'complete') go();
      else window.addEventListener('load', go, { once: true });
    }
  </script>

  <style is:global>
    :root {
      --space: #030303;
      --paper: #fafaf7;
      --muted: #c9c8c2;
      --line: rgb(250 250 247 / 0.22);
      --line-strong: rgb(250 250 247 / 0.5);
      --signal: #ff4f1a;
      --ink: #111111;
      --glass: rgb(6 6 5 / 0.62);
      --heading: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
      --mono: 'JetBrains Mono', ui-monospace, Menlo, monospace;
      --gutter: clamp(16px, 5vw, 88px);
      --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
      color-scheme: dark;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { background: var(--space); }
    body {
      margin: 0;
      background: var(--space);
      color: var(--paper);
      font-family: var(--mono);
      font-size: 15px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    .mono { font-family: var(--mono); }
    a { color: inherit; }
    :focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .skip { position: absolute; left: 16px; top: -60px; z-index: 50; background: var(--paper); color: var(--ink); padding: 8px 12px; }
    .skip:focus { top: 12px; }

    /* Stage: the poster is the no-JS and no-WebGL picture; the canvas fades
       in over it once the textures are in. */
    .ss-stage {
      position: fixed;
      inset: 0;
      z-index: 0;
      background: var(--space) url('/work/web/solar-system/poster.webp') center / cover no-repeat;
      pointer-events: none;
    }
    .ss-stage canvas { display: block; width: 100%; height: 100%; opacity: 0; transition: opacity 1.4s var(--ease); }
    .ss-ready .ss-stage canvas { opacity: 1; }
    .ss-exploring .ss-stage { pointer-events: auto; }
    .ss-exploring .ss-stage canvas { cursor: grab; touch-action: none; }
    .ss-exploring .ss-stage canvas:active { cursor: grabbing; }

    .ss-loader {
      position: fixed; left: 0; top: 0; z-index: 30; height: 2px; width: 100%;
      background: var(--signal); transform-origin: left; transform: scaleX(var(--p, 0.04));
      transition: transform 0.3s linear, opacity 0.6s 0.4s;
    }
    .ss-ready .ss-loader, .ss-no-webgl .ss-loader { opacity: 0; }
    html:not(.ss-js) .ss-loader { display: none; }

    .concept-bar {
      position: relative; z-index: 5;
      display: flex; justify-content: space-between; gap: 16px;
      padding: 10px var(--gutter);
      font-size: 12px; color: var(--muted);
      border-bottom: 1px solid var(--line);
      background: rgb(3 3 3 / 0.6);
    }
    .concept-bar a { display: inline-flex; align-items: center; min-height: 44px; margin: -12px 0; text-decoration: none; color: var(--paper); white-space: nowrap; }
    .concept-bar a:hover { color: var(--signal); }

    main { position: relative; z-index: 2; }

    /* Hero */
    .ss-hero { min-height: calc(100svh - 42px); display: flex; align-items: flex-end; padding: 0 var(--gutter) clamp(32px, 8svh, 88px); }
    /* The Sun sits behind the hero copy on narrow screens; a soft shadow
       keeps the small type readable over it. */
    .ss-hero-inner { max-width: 920px; text-shadow: 0 1px 16px rgb(3 3 3 / 0.7), 0 0 2px rgb(3 3 3 / 0.5); }
    .eyebrow { margin: 0 0 18px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
    h1, h2 { font-family: var(--heading); font-stretch: 112%; margin: 0; }
    h1 {
      font-size: clamp(2.75rem, 7.2vw, 6rem);
      font-weight: 820;
      line-height: 0.9;
      letter-spacing: -0.035em;
      max-width: 11ch;
      text-wrap: balance;
    }
    .lede { margin: 26px 0 0; max-width: 44ch; color: var(--muted); font-size: 15px; }
    .ss-scale-inline { display: block; margin-top: 10px; font-size: 12px; }
    .cue { margin: 40px 0 0; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; }
    .cue span { display: inline-block; color: var(--signal); animation: cue 2.2s var(--ease) infinite; }
    @keyframes cue { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }

    /* Stops */
    .ss-stop { min-height: 150svh; padding: 8svh var(--gutter) 0; }
    .ss-card {
      position: sticky; top: 15svh;
      width: min(400px, 100%);
      padding: 26px 26px 18px;
      background: var(--glass);
      -webkit-backdrop-filter: blur(16px) saturate(1.1);
      backdrop-filter: blur(16px) saturate(1.1);
      border: 1px solid var(--line);
    }
    .ss-tour .ss-card { opacity: 0; transform: translateY(28px); transition: opacity 0.7s var(--ease), transform 0.9s var(--ease); }
    .ss-tour .is-active .ss-card { opacity: 1; transform: none; }
    .ss-idx { margin: 0 0 14px; font-size: 12px; color: var(--muted); letter-spacing: 0.06em; }
    .ss-idx span { color: var(--signal); }
    .ss-card h2 { font-size: clamp(2.4rem, 4vw, 3.5rem); font-weight: 800; line-height: 0.95; letter-spacing: -0.03em; }
    .ss-line { margin: 14px 0 20px; color: var(--muted); }
    .ss-facts { margin: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 20px; }
    .ss-facts div { border-top: 1px solid var(--line); padding: 9px 0 10px; }
    .ss-facts dt { font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--muted); }
    .ss-facts dd { margin: 2px 0 0; font-family: var(--heading); font-weight: 600; font-size: 1.05rem; line-height: 1.25; font-variant-numeric: tabular-nums; }

    /* End of the tour */
    /* Bottom padding keeps the sticky call clear of the footer rule. */
    .ss-end { min-height: 130svh; padding: 0 var(--gutter) 14svh; }
    .ss-end-inner { position: sticky; top: 30svh; max-width: 560px; margin: 0 auto; text-align: center; padding-top: 20svh; }
    .ss-end h2 { font-size: clamp(3rem, 7vw, 6rem); font-weight: 820; letter-spacing: -0.035em; line-height: 0.92; }
    .ss-end p { color: var(--muted); margin: 18px auto 28px; max-width: 40ch; }
    .ss-tour .ss-end-inner { opacity: 0; transition: opacity 0.8s var(--ease); }
    .ss-tour .ss-end.is-active .ss-end-inner, .ss-tour .ss-end-inner:focus-within { opacity: 1; }
    .ss-nogl-only { display: none; }
    .ss-no-webgl .ss-gl-only { display: none; }
    .ss-no-webgl .ss-nogl-only { display: block; }

    .ss-btn {
      display: inline-flex; align-items: center; gap: 10px;
      font-family: var(--heading); font-stretch: 108%; font-weight: 700; font-size: 1.05rem;
      padding: 15px 22px; border: 0; border-radius: 0;
      background: var(--signal); color: var(--ink); text-decoration: none; cursor: pointer;
      transition: background-color 0.2s, color 0.2s, transform 0.2s var(--ease);
    }
    .ss-btn:hover { background: var(--paper); }
    .ss-btn:active { transform: translateY(1px); }

    /* Footer sits on solid space so it reads cleanly over the scene. */
    .ss-footer {
      position: relative; background: var(--space); border-top: 1px solid var(--line);
      padding: clamp(48px, 10svh, 96px) var(--gutter) 40px;
      display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px;
    }
    .ss-footer-line { font-family: var(--heading); font-stretch: 112%; font-weight: 800; font-size: clamp(1.8rem, 3.4vw, 2.8rem); line-height: 1; letter-spacing: -0.03em; margin: 0 0 28px; max-width: 16ch; }
    .ss-credits h2 { font-family: var(--mono); font-stretch: 100%; font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 12px; }
    .ss-credits ul { list-style: none; margin: 0; padding: 0; font-size: 12.5px; color: var(--muted); }
    .ss-credits li { border-top: 1px solid var(--line); padding: 10px 0; }
    .ss-credits a { color: var(--paper); text-underline-offset: 3px; }
    .ss-credits a:hover { color: var(--signal); }

    .ss-scale {
      position: fixed; left: var(--gutter); bottom: 16px; z-index: 3; margin: 0;
      max-width: 360px; font-size: 11px; line-height: 1.5; color: var(--muted);
      transition: opacity 0.4s;
    }
    html[data-stop='0'] .ss-scale, html[data-last] .ss-scale { opacity: 0; }

    /* Rail */
    .ss-rail { position: fixed; right: clamp(12px, 2vw, 28px); top: 50%; transform: translateY(-50%); z-index: 4; display: grid; gap: 2px; }
    .ss-rail button {
      display: flex; align-items: center; justify-content: flex-end; gap: 10px;
      background: none; border: 0; padding: 5px 0; cursor: pointer; color: var(--muted);
    }
    .ss-rail-name { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0; transform: translateX(6px); transition: opacity 0.25s, transform 0.25s var(--ease), color 0.2s; }
    .ss-rail-tick { width: 16px; height: 1px; background: var(--line-strong); transition: width 0.35s var(--ease), background-color 0.2s; }
    .ss-rail button:hover .ss-rail-name, .ss-rail button:focus-visible .ss-rail-name, .ss-rail .is-current .ss-rail-name { opacity: 1; transform: none; }
    .ss-rail button:hover .ss-rail-tick { width: 24px; background: var(--paper); }
    .ss-rail .is-current { color: var(--paper); }
    .ss-rail .is-current .ss-rail-tick { width: 34px; background: var(--signal); }

    /* Explore mode */
    .ss-hud, .ss-labels { display: none; }
    .ss-exploring main, .ss-exploring .ss-rail, .ss-exploring .ss-scale, .ss-exploring .concept-bar { visibility: hidden; }
    .ss-exploring .ss-hud { display: block; }
    .ss-exploring .ss-labels { display: block; }
    .ss-hud-btn {
      position: fixed; top: 16px; left: var(--gutter); z-index: 6;
      font-size: 12px; letter-spacing: 0.04em; color: var(--paper); cursor: pointer;
      background: var(--glass); border: 1px solid var(--line); padding: 10px 14px;
      -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    }
    .ss-hud-btn:hover { border-color: var(--signal); color: var(--signal); }
    .ss-time {
      position: fixed; left: 50%; bottom: 44px; transform: translateX(-50%); z-index: 6;
      display: flex; align-items: stretch; border: 1px solid var(--line); background: var(--glass);
      -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
      font-size: 12px; white-space: nowrap;
    }
    .ss-time button { background: none; border: 0; border-right: 1px solid var(--line); color: var(--muted); padding: 10px 14px; cursor: pointer; font: inherit; }
    .ss-time button:hover { color: var(--paper); }
    .ss-time button:focus-visible { outline-offset: -3px; }
    .ss-time button:last-of-type { border-right: 0; }
    .ss-date { border-left: 1px solid var(--line); }
    .ss-time button[aria-pressed='true'] { background: var(--paper); color: var(--ink); }
    .ss-date { padding: 10px 14px; color: var(--paper); min-width: 13ch; text-align: center; font-variant-numeric: tabular-nums; }
    .ss-hint { position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%); z-index: 6; margin: 0; font-size: 11px; color: var(--muted); white-space: nowrap; }

    .hint-touch { display: none; }
    @media (hover: none) and (pointer: coarse) {
      .hint-fine { display: none; }
      .hint-touch { display: inline; }
      .ss-label::after { content: ''; position: absolute; inset: -10px -4px; }
      .ss-hud-btn { min-height: 44px; }
    }

    .ss-labels { position: fixed; inset: 0; z-index: 5; pointer-events: none; overflow: hidden; }
    .ss-label {
      position: absolute; left: 0; top: 0; pointer-events: auto;
      font: 500 11px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--paper); background: rgb(3 3 3 / 0.5); border: 0; padding: 5px 7px; cursor: pointer;
      transition: color 0.2s;
      will-change: transform;
    }
    .ss-label:hover, .ss-label.is-hover, .ss-label.is-current { color: var(--signal); }

    .ss-panel {
      position: fixed; right: var(--gutter); top: 50%; transform: translateY(-50%); z-index: 7;
      width: min(380px, calc(100vw - 32px)); max-height: calc(100svh - 160px); overflow: auto;
      padding: 26px 26px 18px; background: var(--glass); border: 1px solid var(--line);
      -webkit-backdrop-filter: blur(16px) saturate(1.1); backdrop-filter: blur(16px) saturate(1.1);
      animation: panel-in 0.6s var(--ease);
    }
    .ss-panel[hidden] { display: none; }
    @keyframes panel-in { from { opacity: 0; transform: translate(24px, -50%); } }
    .ss-close {
      position: absolute; top: 4px; right: 4px; width: 44px; height: 44px;
      background: none; border: 1px solid transparent; color: var(--muted); font-size: 22px; line-height: 1; cursor: pointer;
    }
    .ss-close:hover { color: var(--paper); border-color: var(--line); }

    @media (max-width: 759px) {
      body { font-size: 14px; }
      .cb-long { display: none; }
      .ss-rail, .ss-scale { display: none; }
      .ss-stop { min-height: 140svh; padding: 0 12px 12px; display: flex; flex-direction: column; justify-content: flex-end; }
      .ss-card { top: auto; bottom: 12px; padding: 20px 20px 12px; }
      .ss-card h2 { font-size: 2.2rem; }
      .ss-line { margin: 10px 0 14px; font-size: 14px; }
      .ss-facts dd { font-size: 0.95rem; }
      .ss-footer { grid-template-columns: 1fr; }
      /* The date gets its own row so the four speeds fit a phone. */
      .ss-time { bottom: 40px; width: calc(100vw - 24px); flex-wrap: wrap; }
      .ss-time button { flex: 1 1 0; min-height: 44px; padding: 0 6px; }
      .ss-date { order: -1; flex-basis: 100%; padding: 8px; border-left: 0; border-bottom: 1px solid var(--line); }
      .ss-hint { font-size: 11px; }
      .ss-panel {
        left: 12px; right: 12px; top: auto; bottom: 140px; width: auto; transform: none;
        max-height: 46svh; padding: 20px 20px 12px;
      }
      @keyframes panel-in { from { opacity: 0; transform: translateY(24px); } }
      .ss-panel h2 { font-size: 2rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      .ss-tour .ss-card, .ss-tour .ss-end-inner { opacity: 1; transform: none; transition: none; }
      .cue span { animation: none; }
      .ss-panel { animation: none; }
      .ss-stage canvas { transition: opacity 0.4s; }
    }
  </style>
</body>
