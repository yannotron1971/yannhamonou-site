---
const year = new Date().getFullYear();
---

<footer class="v4-footer">
  <div class="v4-wrap">
    <div class="v4-footer__grid">
      <!-- Brand col -->
      <div>
        <div class="v4-footer__brand">Yann.Hamonou</div>
        <p class="v4-footer__tagline">
          B2B marketing consultant based in Stonehaven, Scotland. Helping SMEs get found, get known, and grow.
        </p>
        <div style="margin-top:20px; display:flex; gap:12px;">
          <a
            href="https://www.linkedin.com/in/yannhamonou"
            target="_blank"
            rel="noopener noreferrer"
            class="v4-eyebrow"
            style="color:var(--v4-ink-dim); transition:color 0.15s ease;"
            onmouseover="this.style.color='var(--v4-ink)'"
            onmouseout="this.style.color='var(--v4-ink-dim)'"
            aria-label="LinkedIn"
          >
            LinkedIn ↗
          </a>
          <a
            href="mailto:yanndaman@googlemail.com"
            class="v4-eyebrow"
            style="color:var(--v4-ink-dim); transition:color 0.15s ease;"
            onmouseover="this.style.color='var(--v4-ink)'"
            onmouseout="this.style.color='var(--v4-ink-dim)'"
          >
            Email ↗
          </a>
        </div>
      </div>

      <!-- Pages col -->
      <div>
        <div class="v4-footer__col-title">Pages</div>
        <ul class="v4-footer__col-links" role="list">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/work">Work</a></li>
          <li><a href="/digital-marketing-aberdeen">Digital Marketing Aberdeen</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <!-- Services col -->
      <div>
        <div class="v4-footer__col-title">Services</div>
        <ul class="v4-footer__col-links" role="list">
          <li><a href="/services/strategy">Strategy</a></li>
          <li><a href="/services/positioning">Positioning</a></li>
          <li><a href="/services/seo-aberdeen">SEO Aberdeen & GEO</a></li>
          <li><a href="/services/paid">Paid Media</a></li>
          <li><a href="/services/web">Web & CRO</a></li>
          <li><a href="/services/leadership">Marketing Leadership</a></li>
        </ul>
      </div>

      <!-- Journal col -->
      <div>
        <div class="v4-footer__col-title">Journal</div>
        <ul class="v4-footer__col-links" role="list">
          <li><a href="/journal">All posts</a></li>
        </ul>
        <div style="margin-top:24px;">
          <div class="v4-footer__col-title">Consult</div>
          <ul class="v4-footer__col-links" role="list">
            <li><a href="/contact">Free 30-min review</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="v4-footer__legal">
      <span class="v4-footer__copy">© {year} Yann Hamonou. All rights reserved.</span>
      <a href="/privacy" class="v4-footer__copy" style="transition:color 0.15s ease;">Privacy Policy</a>
    </div>
  </div>
</footer>
