---
/* Service detail page, Signal Poster layout. Intro and deliverables, the
   three-step process, proof, FAQ, the other services, orange closing band.
   Copy comes from the Keystatic services collection. */
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import Heading from '../../components/ui/Heading.astro';
import Text from '../../components/ui/Text.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { getServices } from '../../lib/keystatic';
import { serviceImages } from '../../data/index';

/* The fetch belongs inside getStaticPaths: Astro calls it to discover the
   routes before the module's top-level await has settled, so a const above
   it is still in its temporal dead zone when the function runs. */
export async function getStaticPaths() {
  const services = await getServices();
  // seo-aberdeen has a dedicated page at services/seo-aberdeen.astro
  return services
    .filter(s => s.slug !== 'seo-aberdeen')
    .map(s => ({
      params: { slug: s.slug },
      props: { service: s, otherServices: services.filter(o => o.slug !== s.slug) },
    }));
}

const { service, otherServices } = Astro.props;

const s = service as any;

/* PageHero sets the title with set:html, so escape the ampersand in "Web & CRO". */
const heroTitle = service.title.replace(/&/g, '&amp;');
const heroImage = serviceImages[service.slug];
---

<Layout
  title={`${service.title} Aberdeen — Yann Hamonou`}
  description={service.long}
  breadcrumbs={[
    { name: 'Home', item: `${Astro.site}` },
    { name: 'Services', item: `${Astro.site}services` },
    { name: service.title, item: `${Astro.site}services/${service.slug}` },
  ]}
>
  <PageHero
    label={`${service.num} · Service`}
    title={heroTitle}
    lede={s.headline ?? service.desc}
    image={heroImage}
    size={service.title.length > 14 ? 'lg' : 'xl'}
  >
    <a href="/services/" class="text-link mt-8 inline-block text-sm">← All services</a>
  </PageHero>

  <!-- ═══ INTRO + DELIVERABLES ═══ -->
  {s.intro && (
  <section class="bg-paper py-20 md:py-28">
    <Container data-group class="grid gap-12 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-7">
        <Heading size="lg" data-m="split">The challenge</Heading>
        <div class="mt-8 space-y-5" data-m="fade">
          <Text size="lg" class="max-w-xl">{s.intro}</Text>
          {s.why && <Text size="lg" class="max-w-xl">{s.why}</Text>}
        </div>
        <div class="mt-10" data-m="fade">
          <Button href="/contact/">Book a free consultation</Button>
        </div>
      </div>

      {s.deliverables?.length > 0 && (
      <div class="lg:col-span-4 lg:col-start-9" data-m="rise">
        <Heading as="h2" size="sm">What's included</Heading>
        <ul class="mt-6 border-b border-ink">
          {s.deliverables.map((item: string) => (
            <li class="border-t border-ink py-4"><Text size="sm">{item}</Text></li>
          ))}
        </ul>
        {/* The web service is the one whose work is itself the proof. */}
        {s.slug === 'web' && (
          <div class="mt-8">
            <Button href="/work/web/" variant="outline" size="sm">See the web work</Button>
          </div>
        )}
      </div>
      )}
    </Container>
  </section>
  )}

  <!-- ═══ PROCESS: three columns, orange numbered circles ═══ -->
  {s.process?.length > 0 && (
  <section class="border-t border-ink bg-paper py-20 md:py-28">
    <Container data-group>
      <Heading size="lg" data-m="split" class="max-w-[18ch]">The process</Heading>
      <ol class="mt-12 grid gap-10 md:mt-16 md:grid-cols-3 md:gap-0">
        {s.process.map((step: { num: string; title: string; body: string }) => (
          <li data-m="rise" class="md:border-l md:border-ink md:px-8 md:first:border-l-0 md:first:pl-0">
            <span aria-hidden="true" class="flex size-12 items-center justify-center rounded-full bg-signal font-body text-lg font-semibold text-ink">{step.num}</span>
            <Heading as="h3" size="md" class="mt-6">{step.title}</Heading>
            <Text class="mt-3 max-w-xs">{step.body}</Text>
          </li>
        ))}
      </ol>
    </Container>
  </section>
  )}

  <!-- ═══ PROOF: stone band, quote with hairline figcaption ═══ -->
  {s.proof && (
  <section class="border-t border-ink bg-stone py-20 md:py-28">
    <Container data-group class="grid gap-12 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-4">
        <Heading size="lg" data-m="split">Results</Heading>
        {s.proof.stat && (
          <p class="mt-10 font-heading text-8xl font-black leading-[0.85] tracking-[-0.05em] text-signal [font-stretch:115%]" data-m="fade">{s.proof.stat}</p>
        )}
        {s.proof.stat && s.proof.statLabel && (
          <Text size="sm" class="mt-4 max-w-[16rem] uppercase" data-m="fade">{s.proof.statLabel}</Text>
        )}
      </div>
      <figure class="lg:col-span-7 lg:col-start-6" data-m="rise">
        {s.proof.logo && (
          <img
            src={s.proof.logo.src}
            alt=""
            width={s.proof.logo.w}
            height={s.proof.logo.h}
            loading="lazy"
            class:list={['mb-8 h-8 w-auto max-w-[12rem] object-contain object-left grayscale transition-[filter] duration-300 hover:grayscale-0', s.proof.logo.lightInk && 'invert']}
          />
        )}
        <blockquote><Text size="lg">“{s.proof.quote}”</Text></blockquote>
        <figcaption class="mt-8 border-t border-ink pt-6">
          <Text class="font-semibold">{s.proof.name}</Text>
          <Text size="sm" tone="secondary">{s.proof.role}, {s.proof.company}</Text>
        </figcaption>
        {s.caseNote && (
          <Text class="mt-8 max-w-xl">{s.caseNote}</Text>
        )}
      </figure>
    </Container>
  </section>
  )}

  <!-- ═══ FAQ: two-column hairline list ═══ -->
  {s.faq?.length > 0 && (
  <section class="border-t border-ink bg-paper py-20 md:py-28">
    <Container data-group class="grid gap-12 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-4">
        <Heading size="lg" data-m="split">{service.title} — FAQ</Heading>
      </div>
      <dl class="lg:col-span-7 lg:col-start-6">
        {s.faq.map((item: { q: string; a: string }) => (
          <div data-m="rise" class="grid gap-3 border-t border-ink py-8 last:border-b md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)] md:gap-8">
            <dt><Heading as="h3" size="sm">{item.q}</Heading></dt>
            <dd><Text>{item.a}</Text></dd>
          </div>
        ))}
      </dl>
    </Container>
  </section>
  )}

  <!-- ═══ OTHER SERVICES ═══ -->
  <section class="border-t border-ink bg-paper py-16 md:py-20">
    <Container data-group>
      <Text size="sm" tone="secondary" data-m="fade">Also available</Text>
      <ul class="mt-6 flex flex-wrap gap-3">
        {otherServices.map((os) => (
          <li data-m="rise"><Button href={`/services/${os.slug}/`} variant="outline" size="sm">{os.title}</Button></li>
        ))}
      </ul>
    </Container>
  </section>

  <!-- ═══ CLOSING: full orange band, thin arrow ═══ -->
  <section class="bg-signal py-20 text-ink md:py-28">
    <Container data-group class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-6">
      <div class="lg:col-span-7">
        <Heading size="xl" tone="onAccent" data-m="split" class="max-w-[11ch]">Ready to talk?</Heading>
        <span data-m="fade" class="mt-6 hidden lg:block"><Icon name="arrow-right" stroke={0.6} class="size-40" /></span>
      </div>
      <div class="lg:col-span-4 lg:col-start-9" data-m="fade">
        <Text size="lg" tone="onAccent" class="max-w-md">
          Book a free 30-minute review. I'll look at your situation and tell you exactly what I'd prioritise.
        </Text>
        <div class="mt-8">
          <Button href="/contact/" variant="dark" size="lg" arrow>Book a free consultation</Button>
        </div>
      </div>
    </Container>
  </section>
</Layout>
