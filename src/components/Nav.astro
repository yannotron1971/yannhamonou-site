---
const navLinks = [
  { label: 'About', href: '/about' },
  { label: 'Work', href: '/work' },
  { label: 'Journal', href: '/journal' },
];

const services = [
  { label: 'Marketing Strategy', href: '/services/strategy' },
  { label: 'Positioning', href: '/services/positioning' },
  { label: 'SEO & GEO', href: '/services/seo-aberdeen' },
  { label: 'Paid Media', href: '/services/paid' },
  { label: 'Web & CRO', href: '/services/web' },
];
---

<nav class="v4-nav" aria-label="Main navigation">
  <div class="v4-wrap v4-nav__inner">
    <!-- Brand -->
    <a href="/" class="v4-nav__brand" aria-label="Yann Hamonou — Home">
      <span class="v4-nav__brand-dot" aria-hidden="true"></span>
      Yann.Hamonou
    </a>

    <!-- Desktop links -->
    <ul class="v4-nav__links" role="list">
      <!-- Services dropdown -->
      <li class="v4-nav__dropdown-wrap" id="services-dropdown-wrap">
        <button
          class="v4-nav__dropdown-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          id="services-trigger"
        >
          Services <span class="v4-nav__chevron" aria-hidden="true">›</span>
        </button>
        <ul class="v4-nav__dropdown" role="list" id="services-menu">
          <li>
            <a href="/services" class="v4-nav__dropdown-all">All services →</a>
          </li>
          {services.map(s => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </li>
      {navLinks.map(link => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>

    <!-- Right cluster -->
    <div class="v4-nav__right">
      <!-- Contact CTA (desktop) -->
      <a href="/contact" class="v4-nav__cta" style="display:none" id="nav-cta-desktop">
        Free Consultation
      </a>

      <!-- Hamburger -->
      <button class="v4-hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile drawer -->
<div class="v4-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Navigation">
  <button class="v4-drawer__close" id="drawer-close" aria-label="Close menu">✕</button>
  <ul class="v4-drawer__links" role="list">
    <li>
      <a href="/services">Services</a>
      <ul class="v4-drawer__sub" role="list">
        {services.map(s => (
          <li><a href={s.href}>{s.label}</a></li>
        ))}
      </ul>
    </li>
    {navLinks.map(link => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
    <li><a href="/contact">Contact</a></li>
  </ul>
</div>

<script>
  // Season/theme toggle removed on this concept — the Edge language has one
  // ground, so there is nothing to switch between.

  // Show CTA on desktop
  const cta = document.getElementById('nav-cta-desktop');
  if (window.innerWidth > 760 && cta) cta.style.display = '';

  // Mobile drawer
  const hamburger = document.getElementById('hamburger');
  const drawer = document.getElementById('mobile-drawer');
  const drawerClose = document.getElementById('drawer-close');

  function openDrawer() {
    drawer?.classList.add('is-open');
    hamburger?.classList.add('is-open');
    hamburger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.remove('is-open');
    hamburger?.classList.remove('is-open');
    hamburger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', () => {
    drawer?.classList.contains('is-open') ? closeDrawer() : openDrawer();
  });
  drawerClose?.addEventListener('click', closeDrawer);

  // Close on drawer link click
  drawer?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', closeDrawer);
  });

  // Close on Escape
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') { closeDrawer(); closeDropdown(); }
  });

  // Services dropdown
  const trigger = document.getElementById('services-trigger') as HTMLButtonElement | null;
  const menu = document.getElementById('services-menu');
  const wrap = document.getElementById('services-dropdown-wrap');

  function openDropdown() {
    trigger?.setAttribute('aria-expanded', 'true');
    wrap?.classList.add('is-open');
  }
  function closeDropdown() {
    trigger?.setAttribute('aria-expanded', 'false');
    wrap?.classList.remove('is-open');
  }

  trigger?.addEventListener('click', () => {
    wrap?.classList.contains('is-open') ? closeDropdown() : openDropdown();
  });

  // Close when focus moves outside the dropdown
  wrap?.addEventListener('focusout', e => {
    if (!wrap.contains(e.relatedTarget as Node)) closeDropdown();
  });

  // Close on outside click
  document.addEventListener('click', e => {
    if (!wrap?.contains(e.target as Node)) closeDropdown();
  });
</script>

<style>
  /* Services dropdown */
  .v4-nav__dropdown-wrap {
    position: relative;
  }

  /* Matches .v4-nav__links a — the trigger is one of the links. */
  .v4-nav__dropdown-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--v4-mono);
    font-size: 11px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--v4-ink-mute);
    display: flex;
    align-items: center;
    gap: 5px;
    transition: color 0.15s ease;
  }
  .v4-nav__dropdown-trigger:hover,
  .v4-nav__dropdown-wrap.is-open .v4-nav__dropdown-trigger {
    color: var(--v4-ink);
  }

  .v4-nav__chevron {
    display: inline-block;
    transition: transform 0.2s ease;
    font-size: 16px;
    line-height: 1;
    margin-top: 1px;
  }
  .v4-nav__dropdown-wrap.is-open .v4-nav__chevron {
    transform: rotate(90deg);
  }

  .v4-nav__dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--v4-panel);
    border: 1px solid var(--v4-line-soft);
    border-radius: 0;
    padding: 8px;
    min-width: 248px;
    list-style: none;
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
    z-index: 100;
  }
  .v4-nav__dropdown-wrap.is-open .v4-nav__dropdown {
    display: block;
  }

  .v4-nav__dropdown li a {
    display: block;
    padding: 9px 14px;
    font-family: var(--v4-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--v4-ink-mute);
    border-radius: 0;
    transition: background 0.12s ease, color 0.12s ease;
    text-decoration: none;
    white-space: nowrap;
  }
  .v4-nav__dropdown li a:hover {
    background: var(--v4-panel-2);
    color: var(--v4-ink);
  }

  .v4-nav__dropdown-all {
    font-family: var(--v4-mono) !important;
    font-size: 11px !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--v4-ink-dim) !important;
    border-bottom: 1px solid var(--v4-line-soft);
    border-radius: 0 !important;
    margin-bottom: 4px;
    padding-bottom: 10px !important;
  }
  .v4-nav__dropdown-all:hover {
    background: none !important;
    color: var(--v4-ink) !important;
  }

  /* Mobile drawer sub-list */
  .v4-drawer__sub {
    list-style: none;
    padding: 4px 0 8px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .v4-drawer__sub li a {
    font-family: var(--v4-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--v4-ink-dim);
    padding: 6px 0;
    display: block;
  }
</style>
